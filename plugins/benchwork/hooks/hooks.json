{
  "description": "Defense-in-depth guardrails for canonical Benchwork state.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "Reading Benchwork project status",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__benchwork__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/pre_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking Benchwork state boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__benchwork__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking research receipts"
          }
        ]
      }
    ]
  }
}
