{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-activation/1.0",
  "title": "Artifact Storage Execution Namespace Activation v1",
  "description": "Closed RFC-0013 embedded namespace activation leaf including the E1 deterministic consumption seed. Index visibility, append, locking, and recovery authority are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace_reservation_id", "namespace_reservation_record_sigil", "preallocation_event", "consumption_seed", "activated_at", "activation_record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-execution-namespace-activation/1.0"},
    "namespace_reservation_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-reservation/1.0#/$defs/namespaceReservationId"},
    "namespace_reservation_record_sigil": {"$ref": "#/$defs/sigil"},
    "preallocation_event": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_ref"},
    "consumption_seed": {"$ref": "#/$defs/consumptionSeed"},
    "activated_at": {"$ref": "#/$defs/timestamp"},
    "activation_record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "consumptionIntentId": {"type": "string", "pattern": "^SCI-[0-9A-F]{64}$", "minLength": 68, "maxLength": 68},
    "preparedEventId": {"type": "string", "pattern": "^SE-[0-9A-F]{64}$", "minLength": 67, "maxLength": 67},
    "consumptionSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumption_intent_id", "prepared_event_id", "seeded_at", "seed_sigil"],
      "properties": {
        "consumption_intent_id": {"$ref": "#/$defs/consumptionIntentId"},
        "prepared_event_id": {"$ref": "#/$defs/preparedEventId"},
        "seeded_at": {"$ref": "#/$defs/timestamp"},
        "seed_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

