{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/sanctum-local-job/0.1",
  "title": "Sanctum Local Job",
  "description": "Experimental in-memory conformance record; not the RFC-0012 execution-job/1.0 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "task_capsule_sigil", "circle_sigil", "status", "attempt", "created_at"],
  "properties": {
    "schema_version": {"const": "sanctum-local-job/0.1"},
    "job_id": {"type": "string", "pattern": "^JB-[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "task_capsule_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
    "circle_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
    "status": {"enum": ["PENDING", "CLAIMED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED", "EXPIRED"]},
    "attempt": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "worker_id": {"type": ["string", "null"]},
    "lease_id": {"type": ["string", "null"]}
  }
}
