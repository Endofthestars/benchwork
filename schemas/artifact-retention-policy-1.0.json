{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-retention-policy/1.0",
  "title": "Artifact Retention Policy v1",
  "description": "Closed RFC-0013 artifact-retention-policy/1.0 record. This contract-only increment validates the self-contained record shape and canonical collections only; it does not resolve scope, authorization, backends, policy applicability, or runtime retention decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "scope", "minimum_replica_count", "required_backends", "required_failure_domains", "maximum_integrity_age_seconds", "deletion_grace_seconds", "retain_until", "automatic_gc_allowed", "authorization_sigil", "registered_at", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-retention-policy/1.0"},
    "policy_id": {"$ref": "#/$defs/policyId"},
    "scope": {"$ref": "#/$defs/policyScope"},
    "minimum_replica_count": {"$ref": "#/$defs/u63"},
    "required_backends": {"$ref": "#/$defs/opaqueSet"},
    "required_failure_domains": {"$ref": "#/$defs/opaqueSet"},
    "maximum_integrity_age_seconds": {"$ref": "#/$defs/nullableU63"},
    "deletion_grace_seconds": {"$ref": "#/$defs/nullableU63"},
    "retain_until": {"$ref": "#/$defs/nullableTimestamp"},
    "automatic_gc_allowed": {"type": "boolean"},
    "authorization_sigil": {"$ref": "#/$defs/sigil"},
    "registered_at": {"$ref": "#/$defs/timestamp"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "nullableU63": {"anyOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "policyId": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "referenceSetId": {"type": "string", "pattern": "^RS-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "opaqueSet": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
    "policyScope": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "project_id"], "properties": {"kind": {"const": "PROJECT"}, "project_id": {"$ref": "#/$defs/opaque"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "program_id"], "properties": {"kind": {"const": "PROGRAM"}, "program_id": {"$ref": "#/$defs/opaque"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "blob_sigil"], "properties": {"kind": {"const": "BLOB"}, "blob_sigil": {"$ref": "#/$defs/sigil"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "reference_set_id", "reference_set_sigil"], "properties": {"kind": {"const": "REFERENCE_SET"}, "reference_set_id": {"$ref": "#/$defs/referenceSetId"}, "reference_set_sigil": {"$ref": "#/$defs/sigil"}}}
      ]
    }
  }
}

