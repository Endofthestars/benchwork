{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-preview/1.0",
  "title": "Patch Promotion Preview v1",
  "description": "Closed RFC-0014 patch-promotion-preview/1.0 contract-only record. Validation does not resolve its references, token, clock, or current fence state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preview_id", "kind", "proposal", "bundle", "base", "postimage", "validation_policy", "validation_evidence", "target", "target_state_evidence", "target_content_generation", "adapter", "mode", "deadline_policy_sigil", "affected_paths", "operation_sigil", "recovery", "abandoned_lineage", "residual_risks", "prepared_at", "expires_at", "idempotency_key_sigil", "confirmation_token_sigil", "preview_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-preview/1.0"}, "preview_id": {"$ref": "#/$defs/prv"}, "kind": {"enum": ["PROMOTE", "RECOVER_PARTIAL"]}, "proposal": {"$ref": "#/$defs/ppRef"}, "bundle": {"$ref": "#/$defs/pbuRef"}, "base": {"$ref": "#/$defs/pbRef"}, "postimage": {"$ref": "https://benchwork.dev/schemas/patch-promotion-mutation-intent/1.0#/$defs/postimage"}, "validation_policy": {"$ref": "#/$defs/pvpRef"}, "validation_evidence": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/pveRef"}}, "target": {"$ref": "https://benchwork.dev/schemas/patch-promotion-attempt/1.0#/$defs/target"}, "target_state_evidence": {"$ref": "#/$defs/ptseRef"}, "target_content_generation": {"$ref": "#/$defs/text256"}, "adapter": {"$ref": "#/$defs/ppaRef"}, "mode": {"enum": ["FULL_TREE_ATOMIC_CAS", "PER_ENTRY_GENERATIONAL_CAS"]}, "deadline_policy_sigil": {"$ref": "#/$defs/sigil"}, "affected_paths": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/text4096"}}, "operation_sigil": {"$ref": "#/$defs/sigil"}, "recovery": {"anyOf": [{"$ref": "https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/recovery"}, {"type": "null"}]}, "abandoned_lineage": {"anyOf": [{"$ref": "https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/abandoned"}, {"type": "null"}]}, "residual_risks": {"type": "array", "minItems": 0, "maxItems": 256, "items": {"$ref": "#/$defs/text4096"}}, "prepared_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "idempotency_key_sigil": {"$ref": "#/$defs/sigil"}, "confirmation_token_sigil": {"$ref": "#/$defs/sigil"}, "preview_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "RECOVER_PARTIAL"}}}, "then": {"properties": {"recovery": {"$ref": "https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/recovery"}, "abandoned_lineage": {"type": "null"}}}},
    {"if": {"properties": {"kind": {"const": "PROMOTE"}}}, "then": {"properties": {"recovery": {"type": "null"}}}}
  ],
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}, "text256": {"type": "string", "minLength": 0, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text4096": {"type": "string", "minLength": 0, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "prv": {"type": "string", "pattern": "^PRV-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pp": {"type": "string", "pattern": "^PP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pbu": {"type": "string", "pattern": "^PBU-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pb": {"type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pvp": {"type": "string", "pattern": "^PVP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pve": {"type": "string", "pattern": "^PVE-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "ptse": {"type": "string", "pattern": "^PTSE-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128}, "ppa": {"type": "string", "pattern": "^PPA-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"type": "string"}, "sigil": {"$ref": "#/$defs/sigil"}}}, "ppRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pp"}}}]}, "pbuRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pbu"}}}]}, "pbRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pb"}}}]}, "pvpRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pvp"}}}]}, "pveRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pve"}}}]}, "ptseRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/ptse"}}}]}, "ppaRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/ppa"}}}]}
  }
}

