{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-recovery-action-set/1.0",
  "title": "Execution Recovery Action Set v1",
  "description": "Closed RFC-0012 immutable recovery action-set wire. Contract validation does not derive the set from Journal replay, allocate target Events, install or execute actions, prove postconditions, append Events, or grant recovery, runtime, or scientific authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recovery_id", "phase", "derived_from_journal_id", "derived_through_sequence", "derived_through_event_sigil", "supersedes_action_set_sigil", "actions", "action_set_sigil"],
  "properties": {
    "schema_version": {"const": "execution-recovery-action-set/1.0"},
    "recovery_id": {"$ref": "https://benchwork.dev/schemas/execution-state/1.0#/$defs/recovery_id"},
    "phase": {"$ref": "#/$defs/phase"},
    "derived_from_journal_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/journal_id"},
    "derived_through_sequence": {"$ref": "#/$defs/u63"},
    "derived_through_event_sigil": {"$ref": "#/$defs/sigil"},
    "supersedes_action_set_sigil": {"oneOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "action_set_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "u63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
    "positiveU63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "opaqueId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9_-]*$"},
    "phase": {"enum": ["STARTED", "FENCING", "RECONCILING", "FINALIZING"]},
    "actionKind": {"enum": ["COMMIT_DUE_EVENT", "RESTORE_CLOCK", "FENCE_LEASE", "REPUBLISH_TOMBSTONE", "OFFLINE_SESSION", "TERMINATE_PROCESS_TREE", "REVOKE_HANDLES", "CLOSE_SESSION", "CLOSE_LOG", "VERIFY_OUTPUT_STORAGE", "VERIFY_TERMINAL_SOURCE", "BIND_DURABLE_ATTEMPT_AUTHORIZATION", "RELEASE_INACTIVE_EXECUTION_INPUT_HOLD", "RELEASE_DUE_EXECUTION_HOLD", "QUARANTINE_RESOURCE", "ADVANCE_ATTEMPT", "CLEAN_RESOURCE", "COLLECT_ACCOUNTING", "SETTLE_BUDGET", "EVALUATE_ATTEMPT_ASSURANCE", "EVALUATE_JOB_ASSURANCE", "ADVANCE_JOB"]},
    "entityKind": {"enum": ["EXECUTOR", "RECOVERY", "WORKER", "WORKER_SESSION", "JOB", "ATTEMPT", "LEASE", "LOG_STREAM"]},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}},
    "eventIdArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "action_kind", "entity_kind", "entity_id", "expected_revision", "target_event_id", "target_sequence", "target_event_type", "prerequisite_event_ids", "parameters"],
      "properties": {
        "ordinal": {"$ref": "#/$defs/u63"},
        "action_kind": {"$ref": "#/$defs/actionKind"},
        "entity_kind": {"$ref": "#/$defs/entityKind"},
        "entity_id": {"$ref": "#/$defs/opaqueId"},
        "expected_revision": {"$ref": "#/$defs/u64"},
        "target_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"},
        "target_sequence": {"$ref": "#/$defs/positiveU63"},
        "target_event_type": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_type"},
        "prerequisite_event_ids": {"$ref": "#/$defs/eventIdArray"},
        "parameters": {"oneOf": [
          {"$ref": "#/$defs/commitDueEvent"}, {"$ref": "#/$defs/restoreClock"},
          {"$ref": "#/$defs/fenceLease"}, {"$ref": "#/$defs/republishTombstone"},
          {"$ref": "#/$defs/offlineSession"}, {"$ref": "#/$defs/terminateProcessTree"},
          {"$ref": "#/$defs/revokeHandles"}, {"$ref": "#/$defs/closeSession"},
          {"$ref": "#/$defs/closeLog"}, {"$ref": "#/$defs/verifyOutputStorage"},
          {"$ref": "#/$defs/verifyTerminalSource"}, {"$ref": "#/$defs/bindDurableAttemptAuthorization"},
          {"$ref": "#/$defs/releaseInactiveExecutionInputHold"}, {"$ref": "#/$defs/releaseDueExecutionHold"},
          {"$ref": "#/$defs/quarantineResource"}, {"$ref": "#/$defs/advanceAttempt"},
          {"$ref": "#/$defs/cleanResource"}, {"$ref": "#/$defs/collectAccounting"},
          {"$ref": "#/$defs/settleBudget"}, {"$ref": "#/$defs/evaluateAttemptAssurance"},
          {"$ref": "#/$defs/evaluateJobAssurance"}, {"$ref": "#/$defs/advanceJob"}
        ]}
      },
      "allOf": [
        {"if": {"properties": {"action_kind": {"const": "COMMIT_DUE_EVENT"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/commitDueEvent"}}}},
        {"if": {"properties": {"action_kind": {"const": "RESTORE_CLOCK"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/restoreClock"}}}},
        {"if": {"properties": {"action_kind": {"const": "FENCE_LEASE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/fenceLease"}}}},
        {"if": {"properties": {"action_kind": {"const": "REPUBLISH_TOMBSTONE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/republishTombstone"}}}},
        {"if": {"properties": {"action_kind": {"const": "OFFLINE_SESSION"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/offlineSession"}}}},
        {"if": {"properties": {"action_kind": {"const": "TERMINATE_PROCESS_TREE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/terminateProcessTree"}}}},
        {"if": {"properties": {"action_kind": {"const": "REVOKE_HANDLES"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/revokeHandles"}}}},
        {"if": {"properties": {"action_kind": {"const": "CLOSE_SESSION"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/closeSession"}}}},
        {"if": {"properties": {"action_kind": {"const": "CLOSE_LOG"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/closeLog"}}}},
        {"if": {"properties": {"action_kind": {"const": "VERIFY_OUTPUT_STORAGE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/verifyOutputStorage"}}}},
        {"if": {"properties": {"action_kind": {"const": "VERIFY_TERMINAL_SOURCE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/verifyTerminalSource"}}}},
        {"if": {"properties": {"action_kind": {"const": "BIND_DURABLE_ATTEMPT_AUTHORIZATION"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/bindDurableAttemptAuthorization"}}}},
        {"if": {"properties": {"action_kind": {"const": "RELEASE_INACTIVE_EXECUTION_INPUT_HOLD"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/releaseInactiveExecutionInputHold"}}}},
        {"if": {"properties": {"action_kind": {"const": "RELEASE_DUE_EXECUTION_HOLD"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/releaseDueExecutionHold"}}}},
        {"if": {"properties": {"action_kind": {"const": "QUARANTINE_RESOURCE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/quarantineResource"}}}},
        {"if": {"properties": {"action_kind": {"const": "ADVANCE_ATTEMPT"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/advanceAttempt"}}}},
        {"if": {"properties": {"action_kind": {"const": "CLEAN_RESOURCE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/cleanResource"}}}},
        {"if": {"properties": {"action_kind": {"const": "COLLECT_ACCOUNTING"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/collectAccounting"}}}},
        {"if": {"properties": {"action_kind": {"const": "SETTLE_BUDGET"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/settleBudget"}}}},
        {"if": {"properties": {"action_kind": {"const": "EVALUATE_ATTEMPT_ASSURANCE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/evaluateAttemptAssurance"}}}},
        {"if": {"properties": {"action_kind": {"const": "EVALUATE_JOB_ASSURANCE"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/evaluateJobAssurance"}}}},
        {"if": {"properties": {"action_kind": {"const": "ADVANCE_JOB"}}}, "then": {"properties": {"parameters": {"$ref": "#/$defs/advanceJob"}}}}
      ]
    },
    "commitDueEvent": {"type": "object", "additionalProperties": false, "required": ["deadline_kind", "due_at", "deadline_entity_id"], "properties": {"deadline_kind": {"enum": ["JOB_DEADLINE", "ATTEMPT_DEADLINE", "HEARTBEAT_TIMEOUT", "LEASE_EXPIRY", "LEASE_CLAIM_DEADLINE", "CANCELLATION_GRACE", "RETRY_ELIGIBILITY"]}, "due_at": {"$ref": "#/$defs/timestamp"}, "deadline_entity_id": {"$ref": "#/$defs/opaqueId"}}},
    "restoreClock": {"type": "object", "additionalProperties": false, "required": ["clock_uncertain_event_id", "trusted_time_source_sigil", "clock_uncertainty_tolerance_seconds"], "properties": {"clock_uncertain_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}, "trusted_time_source_sigil": {"$ref": "#/$defs/sigil"}, "clock_uncertainty_tolerance_seconds": {"$ref": "#/$defs/u63"}}},
    "fenceLease": {"type": "object", "additionalProperties": false, "required": ["lease_id", "lease_binding_sigil", "prior_fence_floor", "tombstone_generation"], "properties": {"lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"}, "lease_binding_sigil": {"$ref": "#/$defs/sigil"}, "prior_fence_floor": {"$ref": "#/$defs/u64"}, "tombstone_generation": {"$ref": "#/$defs/u64"}}},
    "republishTombstone": {"type": "object", "additionalProperties": false, "required": ["lease_id", "tombstone_generation", "original_terminal_event_sigil", "sink_ids"], "properties": {"lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"}, "tombstone_generation": {"$ref": "#/$defs/u64"}, "original_terminal_event_sigil": {"$ref": "#/$defs/sigil"}, "sink_ids": {"$ref": "#/$defs/idArray"}}},
    "offlineSession": {"type": "object", "additionalProperties": false, "required": ["worker_session_id", "last_heartbeat_sequence", "active_lease_ids"], "properties": {"worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"}, "last_heartbeat_sequence": {"oneOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]}, "active_lease_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"}}}},
    "terminateProcessTree": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "attempt_id", "process_tree_identity", "backend_configuration_sigil", "termination_policy_sigil"], "properties": {"kind": {"const": "TRACKED"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "process_tree_identity": {"$ref": "#/$defs/opaqueId"}, "backend_configuration_sigil": {"$ref": "#/$defs/sigil"}, "termination_policy_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "attempt_id", "backend_start_handle_sigil", "backend_configuration_sigil", "termination_policy_sigil"], "properties": {"kind": {"const": "START_HANDLE"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "backend_start_handle_sigil": {"$ref": "#/$defs/sigil"}, "backend_configuration_sigil": {"$ref": "#/$defs/sigil"}, "termination_policy_sigil": {"$ref": "#/$defs/sigil"}}}
    ]},
    "revokeHandles": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "handle_set_sigil", "sink_ids"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "handle_set_sigil": {"$ref": "#/$defs/sigil"}, "sink_ids": {"$ref": "#/$defs/idArray"}}},
    "closeSession": {"type": "object", "additionalProperties": false, "required": ["worker_session_id", "backend_session_identity", "control_channel_identity_sigil"], "properties": {"worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"}, "backend_session_identity": {"$ref": "#/$defs/opaqueId"}, "control_channel_identity_sigil": {"$ref": "#/$defs/sigil"}}},
    "closeLog": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "stream", "last_committed_sequence"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "stream": {"enum": ["STDOUT", "STDERR", "STRUCTURED"]}, "last_committed_sequence": {"oneOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]}}},
    "verifyOutputStorage": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "expected_output_set_sigil", "storage_journal_id", "storage_through_sequence", "storage_through_event_sigil"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "expected_output_set_sigil": {"$ref": "#/$defs/sigil"}, "storage_journal_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/journalId"}, "storage_through_sequence": {"$ref": "#/$defs/positiveU63"}, "storage_through_event_sigil": {"$ref": "#/$defs/sigil"}}},
    "verifyTerminalSource": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "crucible_base_identity", "crucible_base_sigil", "retention_policy_sigil"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "crucible_base_identity": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/token"}, "crucible_base_sigil": {"$ref": "#/$defs/sigil"}, "retention_policy_sigil": {"$ref": "#/$defs/sigil"}}},
    "bindDurableAttemptAuthorization": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "authorization_subject_id", "authorization_subject_sigil", "authorization_transition_request_id", "authorization_transition_request_sigil", "authorization_event_id", "authorization_event_body_sigil", "authorization_receipt_id", "authorization_receipt_sigil"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "authorization_subject_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/subjectId"}, "authorization_subject_sigil": {"$ref": "#/$defs/sigil"}, "authorization_transition_request_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-transition-request/1.0#/$defs/requestId"}, "authorization_transition_request_sigil": {"$ref": "#/$defs/sigil"}, "authorization_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}, "authorization_event_body_sigil": {"$ref": "#/$defs/sigil"}, "authorization_receipt_id": {"$ref": "#/$defs/opaqueId"}, "authorization_receipt_sigil": {"$ref": "#/$defs/sigil"}}},
    "releaseInactiveExecutionInputHold": {"type": "object", "additionalProperties": false, "required": ["root_kind", "storage_root", "owner_terminal_basis", "release_authorization_id", "release_authorization_sigil"], "properties": {"root_kind": {"enum": ["JOB_INPUT", "ATTEMPT_INPUT"]}, "storage_root": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/storage_root_binding"}, "owner_terminal_basis": {"$ref": "https://benchwork.dev/schemas/execution-root-hold-release-authorization/1.0#/$defs/owner_terminal"}, "release_authorization_id": {"$ref": "https://benchwork.dev/schemas/execution-root-hold-release-authorization/1.0#/$defs/release_authorization_id"}, "release_authorization_sigil": {"$ref": "#/$defs/sigil"}}},
    "releaseDueExecutionHold": {"type": "object", "additionalProperties": false, "required": ["job_id", "release_schedule", "release_authorization_id", "release_authorization_sigil"], "properties": {"job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "release_schedule": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/output_hold_release_schedule"}, "release_authorization_id": {"$ref": "https://benchwork.dev/schemas/execution-root-hold-release-authorization/1.0#/$defs/release_authorization_id"}, "release_authorization_sigil": {"$ref": "#/$defs/sigil"}}},
    "quarantineResource": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "resource_ids", "reason_codes"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "resource_ids": {"$ref": "#/$defs/idArray"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/token"}}}},
    "advanceAttempt": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "from_state", "transition_cause"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "from_state": {"enum": ["CREATED", "PREFLIGHTING", "READY", "LEASED", "STARTING", "RUNNING", "DRAINING", "STOPPING", "CLEANING", "SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "POLICY_VIOLATION", "LEASE_EXPIRED", "LOST", "FENCED", "REJECTED"]}, "transition_cause": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/transition_cause"}}},
    "cleanResource": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "resource_ids", "cleanup_policy_sigil"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "resource_ids": {"$ref": "#/$defs/idArray"}, "cleanup_policy_sigil": {"$ref": "#/$defs/sigil"}}},
    "collectAccounting": {"type": "object", "additionalProperties": false, "required": ["job_id", "attempt_id", "reservation", "accounting_scope_sigil", "backend_configuration_sigil", "accounting_policy_sigil"], "properties": {"job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "reservation": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/budgetReservation"}, "accounting_scope_sigil": {"$ref": "#/$defs/sigil"}, "backend_configuration_sigil": {"$ref": "#/$defs/sigil"}, "accounting_policy_sigil": {"$ref": "#/$defs/sigil"}}},
    "settleBudget": {"type": "object", "additionalProperties": false, "required": ["job_id", "attempt_id", "reservation", "accounting_capture_event_id", "accounting_capture_event_sigil"], "properties": {"job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "reservation": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/budgetReservation"}, "accounting_capture_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}, "accounting_capture_event_sigil": {"$ref": "#/$defs/sigil"}}},
    "evaluateAttemptAssurance": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "terminal_event_id", "assurance_input_event_ids"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "terminal_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}, "assurance_input_event_ids": {"$ref": "#/$defs/eventIdArray"}}},
    "evaluateJobAssurance": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "job_id", "attempt_id", "attempt_assurance_event_id"], "properties": {"kind": {"const": "ATTEMPT"}, "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, "attempt_assurance_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "job_id", "reason"], "properties": {"kind": {"const": "NOT_APPLICABLE"}, "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "reason": {"const": "NO_ATTEMPT_ALLOCATED"}}}
    ]},
    "advanceJob": {"type": "object", "additionalProperties": false, "required": ["job_id", "from_state", "selected_attempt_id", "transition_cause"], "properties": {"job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}, "from_state": {"enum": ["SUBMITTED", "QUEUED", "ACTIVE", "RETRY_WAIT", "STOPPING", "SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "POLICY_VIOLATION"]}, "selected_attempt_id": {"oneOf": [{"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"}, {"type": "null"}]}, "transition_cause": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/transition_cause"}}}
  }
}

