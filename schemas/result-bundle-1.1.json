{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/result-bundle/1.1",
  "title": "Deterministic Descriptive Aggregation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_kind", "bundle_id", "program_id", "protocol_id", "run_inventory", "multiple_comparison_policy", "comparisons"],
  "properties": {
    "schema_version": {"const": "result-bundle/1.1"},
    "analysis_kind": {"const": "deterministic-descriptive-aggregation"},
    "bundle_id": {"type": "string", "pattern": "^RB-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "protocol_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/protocol_id"},
    "run_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_run_ids", "included_run_ids", "excluded_runs", "failed_run_ids", "missing_run_ids"],
      "properties": {
        "all_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "included_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "excluded_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "status", "reason", "policy_reference"],
            "properties": {
              "run_id": {"type": "string", "pattern": "^RUN-"},
              "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED", "LOST"]},
              "reason": {"type": "string", "minLength": 1},
              "policy_reference": {"type": "string", "minLength": 1}
            }
          }
        },
        "failed_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "missing_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}}
      }
    },
    "multiple_comparison_policy": {"enum": ["none", "bonferroni", "holm", "fdr"]},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comparison_id", "experiment_id", "estimand", "treatment_arm", "control_arm", "pairing", "run_ids", "metrics"],
        "properties": {
          "comparison_id": {"type": "string", "pattern": "^CMP-"},
          "experiment_id": {"type": "string", "pattern": "^EX-"},
          "estimand": {"const": "mean_difference"},
          "treatment_arm": {"type": "string", "minLength": 1},
          "control_arm": {"type": "string", "minLength": 1},
          "pairing": {"enum": ["paired", "unpaired", "none"]},
          "run_ids": {
            "type": "object",
            "additionalProperties": false,
            "required": ["treatment", "control"],
            "properties": {
              "treatment": {"type": "array", "items": {"type": "string", "pattern": "^RUN-"}},
              "control": {"type": "array", "items": {"type": "string", "pattern": "^RUN-"}}
            }
          },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["descriptive", "effect", "uncertainty", "practical_significance"],
              "properties": {
                "descriptive": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["treatment", "control"],
                  "properties": {
                    "treatment": {"$ref": "#/$defs/descriptive"},
                    "control": {"$ref": "#/$defs/descriptive"}
                  }
                },
                "effect": {"$ref": "#/$defs/effect"},
                "uncertainty": {"$ref": "#/$defs/uncertainty"},
                "practical_significance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["threshold", "exceeds_threshold"],
                  "properties": {
                    "threshold": {"type": ["number", "null"], "minimum": 0},
                    "exceeds_threshold": {"type": ["boolean", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "descriptive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "mean", "sample_stddev", "min", "max"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "mean": {"type": "number"},
        "sample_stddev": {"type": ["number", "null"], "minimum": 0},
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "estimate", "standardized"],
      "properties": {
        "method": {"const": "mean_difference"},
        "estimate": {"type": "number"},
        "standardized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "estimate", "reason"],
          "properties": {
            "method": {"enum": ["cohens_d", "paired_dz", "unavailable"]},
            "estimate": {"type": ["number", "null"]},
            "reason": {"type": ["string", "null"]}
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "requested_level", "effective_level", "lower", "upper", "degrees_of_freedom", "seed", "samples", "reason"],
      "properties": {
        "method": {"enum": ["student_t", "bootstrap", "unavailable"]},
        "requested_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "effective_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "degrees_of_freedom": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "seed": {"type": ["integer", "null"]},
        "samples": {"type": ["integer", "null"], "minimum": 100},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
