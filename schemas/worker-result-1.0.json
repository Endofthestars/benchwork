{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/worker-result/1.0",
  "title": "Worker Result Proposal",
  "description": "An untrusted execution output proposal. Athanor acceptance is a separate operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "attempt", "worker_id", "lease_id", "status", "summary", "outputs", "produced_at"],
  "properties": {
    "schema_version": {"const": "worker-result/1.0"},
    "job_id": {"type": "string", "pattern": "^JB-"},
    "attempt": {"type": "integer", "minimum": 1},
    "worker_id": {"type": "string", "pattern": "^WK-"},
    "lease_id": {"type": "string", "pattern": "^LS-"},
    "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED"]},
    "summary": {"type": "string", "minLength": 1},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["schema", "uri", "blob_sigil"], "properties": {"schema": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "blob_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"}}}},
    "produced_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "COMPLETED"}}}, "then": {"properties": {"outputs": {"minItems": 1}}}}]
}
