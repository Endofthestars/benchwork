{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/decision/1.2",
  "title": "Scientific Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "program_id",
    "outcome",
    "assessment_ids",
    "rationale",
    "required_actions",
    "lineage",
    "unresolved_issue_ids",
    "unresolved_uncertainties",
    "status",
    "sealed_at",
    "seal_receipt",
    "seal_actor"
  ],
  "properties": {
    "schema_version": {"const": "decision/1.2"},
    "decision_id": {"type": "string", "pattern": "^DE-"},
    "program_id": {"type": "string", "pattern": "^RP-"},
    "outcome": {
      "enum": [
        "CONTINUE",
        "REPAIR",
        "PIVOT",
        "STOP",
        "INSUFFICIENT_EVIDENCE",
        "REVIEW_REQUIRED"
      ]
    },
    "assessment_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AS-"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "required_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "lineage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent_program_id", "reason"],
          "properties": {
            "parent_program_id": {"type": "string", "pattern": "^RP-"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "unresolved_issue_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^IS-"}
    },
    "unresolved_uncertainties": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"const": "SEALED"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "seal_receipt": {"type": "string", "pattern": "^RC-"},
    "seal_actor": {"$ref": "https://benchwork.dev/schemas/actor/1.0"}
  }
}
