{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://benchwork.dev/schemas/patch-promotion-outcome-request/1.0", "title":"Patch Promotion Outcome Request v1", "type":"object", "additionalProperties":false,
  "required":["schema_version","request_id","kind","record","evidence_sigils","actor","host","requested_at","idempotency_key","request_sigil"],
  "properties":{"schema_version":{"const":"patch-promotion-outcome-request/1.0"},"request_id":{"$ref":"#/$defs/por"},"kind":{"enum":["PROMOTION_OUTCOME","RECOVERY_RECORD"]},"record":{"oneOf":[{"$ref":"#/$defs/outcomeRecord"},{"$ref":"#/$defs/recoveryRecord"}]},"evidence_sigils":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/sigil"}},"actor":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/actor"},"host":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/host"},"requested_at":{"$ref":"#/$defs/timestamp"},"idempotency_key":{"$ref":"#/$defs/text256"},"request_sigil":{"$ref":"#/$defs/sigil"}},
  "allOf":[{"if":{"properties":{"kind":{"const":"PROMOTION_OUTCOME"}}},"then":{"properties":{"record":{"$ref":"#/$defs/outcomeRecord"}}}},{"if":{"properties":{"kind":{"const":"RECOVERY_RECORD"}}},"then":{"properties":{"record":{"$ref":"#/$defs/recoveryRecord"}}}}],
  "$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"text256":{"type":"string","minLength":0,"maxLength":256,"pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]*$","not":{"pattern":"[\\r\\n]"}},"por":{"type":"string","pattern":"^POR-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"outcomeRecord":{"type":"object","additionalProperties":false,"required":["kind","outcome_id","outcome_sigil"],"properties":{"kind":{"const":"PROMOTION_OUTCOME"},"outcome_id":{"type":"string","pattern":"^PO-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":4,"maxLength":128},"outcome_sigil":{"$ref":"#/$defs/sigil"}}},"recoveryRecord":{"type":"object","additionalProperties":false,"required":["kind","recovery_record_id","recovery_record_sigil"],"properties":{"kind":{"const":"RECOVERY_RECORD"},"recovery_record_id":{"type":"string","pattern":"^PRR-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"recovery_record_sigil":{"$ref":"#/$defs/sigil"}}}}
}

