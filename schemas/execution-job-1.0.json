{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-job/1.0",
  "title": "Execution Job v1",
  "description": "Closed RFC-0012 execution-job/1.0 contract-only record. This increment validates only self-contained Job structure and bindings. job_storage_roots is deliberately limited to an empty array until execution-journal-event/1.0 publishes the canonical storage_root_binding definition; external Task, Specification, Chronicle, Ward, assurance, and Storage resolution are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "submitted_at", "submission_idempotency_key_sigil", "start_request_sigil", "task_id", "task_capsule_sigil", "specification_id", "specification_sigil", "admission_chronicle_head", "admission_chronicle_head_evidence", "assurance_requirement", "deadline_due_at", "job_budget", "job_storage_roots", "job_binding_sigil"],
  "properties": {
    "schema_version": {"const": "execution-job/1.0"},
    "job_id": {"$ref": "#/$defs/jobId"},
    "submitted_at": {"$ref": "#/$defs/timestamp"},
    "submission_idempotency_key_sigil": {"$ref": "#/$defs/sigil"},
    "start_request_sigil": {"$ref": "#/$defs/sigil"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "task_capsule_sigil": {"$ref": "#/$defs/sigil"},
    "specification_id": {"$ref": "#/$defs/specificationId"},
    "specification_sigil": {"$ref": "#/$defs/sigil"},
    "admission_chronicle_head": {"$ref": "#/$defs/chronicleHeadRef"},
    "admission_chronicle_head_evidence": {"$ref": "#/$defs/admissionChronicleHeadEvidence"},
    "assurance_requirement": {"$ref": "#/$defs/assuranceRequirement"},
    "deadline_due_at": {"$ref": "#/$defs/timestamp"},
    "job_budget": {"$ref": "#/$defs/jobBudget"},
    "job_storage_roots": {"type": "array", "maxItems": 0},
    "job_binding_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "jobId": {"type": "string", "pattern": "^JB-[0-9A-F]{64}$", "minLength": 67, "maxLength": 67},
    "taskId": {"type": "string", "pattern": "^TK-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "specificationId": {"type": "string", "pattern": "^ES-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "suiteId": {"type": "string", "pattern": "^CS-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+(?:[.][0-9]+)?$", "not": {"pattern": "[\\r\\n]"}, "minLength": 3, "maxLength": 32},
    "chronicleHeadRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_count", "terminal_receipt_sigil"],
      "properties": {
        "schema_version": {"const": "chronicle-head/1.1"},
        "event_count": {"$ref": "#/$defs/u63"},
        "terminal_receipt_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}
      }
    },
    "admissionChronicleHeadEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "job_id", "start_request_sigil", "observed_chronicle_head", "observed_at", "validator_build_sigil", "evidence_sigil"],
      "properties": {
        "profile": {"const": "PHASE3_CHRONICLE_HEAD_ADMISSION_V1"},
        "job_id": {"$ref": "#/$defs/jobId"},
        "start_request_sigil": {"$ref": "#/$defs/sigil"},
        "observed_chronicle_head": {"$ref": "#/$defs/chronicleHeadRef"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "validator_build_sigil": {"$ref": "#/$defs/sigil"},
        "evidence_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "assuranceRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_level", "profile_version", "profile_sigil", "conformance_suite_id", "conformance_suite_sigil"],
      "properties": {
        "requested_level": {"enum": ["SANCTUM-A0", "SANCTUM-A1", "SANCTUM-A2"]},
        "profile_version": {"$ref": "#/$defs/version"},
        "profile_sigil": {"$ref": "#/$defs/sigil"},
        "conformance_suite_id": {"$ref": "#/$defs/suiteId"},
        "conformance_suite_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "jobBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "cpu_time_seconds", "storage_bytes_written", "output_bytes", "log_bytes", "process_starts", "network_egress_bytes", "network_requests"],
      "properties": {
        "attempts": {"$ref": "#/$defs/positiveU63"},
        "cpu_time_seconds": {"$ref": "#/$defs/u63"},
        "storage_bytes_written": {"$ref": "#/$defs/u63"},
        "output_bytes": {"$ref": "#/$defs/u63"},
        "log_bytes": {"$ref": "#/$defs/u63"},
        "process_starts": {"$ref": "#/$defs/u63"},
        "network_egress_bytes": {"$ref": "#/$defs/u63"},
        "network_requests": {"$ref": "#/$defs/u63"}
      }
    }
  }
}

