{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-tree-manifest/1.0",
  "title": "Patch Tree Manifest v1",
  "description": "Closed RFC-0014 patch-tree-manifest/1.0 contract-only record. Validation checks local manifest topology and identities but does not resolve its Profile, Blob bytes, or filesystem tree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_profile", "scope", "path_semantics", "entries", "entry_count", "file_count", "total_bytes", "root_entry_sigil", "manifest_sigil", "record_sigil"],
  "properties": {
    "schema_version": {"const": "patch-tree-manifest/1.0"},
    "identity_profile": {"$ref": "#/$defs/pbipRef"},
    "scope": {"$ref": "#/$defs/pathScope"},
    "path_semantics": {"$ref": "#/$defs/pathSemantics"},
    "entries": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}},
    "entry_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "file_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "total_bytes": {"$ref": "#/$defs/u63"},
    "root_entry_sigil": {"$ref": "#/$defs/sigil"},
    "manifest_sigil": {"$ref": "#/$defs/sigil"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "pbip": {"type": "string", "pattern": "^PBIP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128},
    "pbipRef": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"$ref": "#/$defs/pbip"}, "sigil": {"$ref": "#/$defs/sigil"}}},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/\\u0000-\\u001F\\u007F-\\u009F]+(?:/[^/\\u0000-\\u001F\\u007F-\\u009F]+)*$", "not": {"pattern": "[\\r\\n]"}},
    "pathScope": {"type": "object", "additionalProperties": false, "required": ["root_kind", "included_paths", "excluded_paths"], "properties": {"root_kind": {"enum": ["CRUCIBLE", "PROMOTION_TARGET"]}, "included_paths": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "excluded_paths": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}}},
    "pathSemantics": {"type": "object", "additionalProperties": false, "required": ["separator", "unicode_normalization", "case_mode", "dot_segments", "link_traversal", "reserved_name_policy"], "properties": {"separator": {"const": "SLASH"}, "unicode_normalization": {"const": "NFC"}, "case_mode": {"enum": ["SENSITIVE", "INSENSITIVE_REJECT_COLLISIONS"]}, "dot_segments": {"const": "REJECT"}, "link_traversal": {"const": "NOFOLLOW"}, "reserved_name_policy": {"const": "REJECT"}}},
    "blob": {"type": "object", "additionalProperties": false, "required": ["blob_sigil", "size_bytes"], "properties": {"blob_sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}}},
    "entry": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["path", "kind", "entry_sigil"], "properties": {"path": {"$ref": "#/$defs/path"}, "kind": {"const": "DIRECTORY"}, "entry_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["path", "kind", "blob", "executable"], "properties": {"path": {"$ref": "#/$defs/path"}, "kind": {"const": "FILE"}, "blob": {"$ref": "#/$defs/blob"}, "executable": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["path", "kind", "target", "target_sigil"], "properties": {"path": {"$ref": "#/$defs/path"}, "kind": {"const": "SYMLINK"}, "target": {"$ref": "#/$defs/text4096"}, "target_sigil": {"$ref": "#/$defs/sigil"}}}
    ]}
  }
}

