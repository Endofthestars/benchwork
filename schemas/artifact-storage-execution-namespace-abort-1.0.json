{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-abort/1.0",
  "title": "Artifact Storage Execution Namespace Abort v1",
  "description": "Closed RFC-0013 E1 namespace abort leaf. Predicate evaluation, precedence selection, index visibility, Journal append, and recovery authority remain external.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace_reservation_id", "namespace_reservation_record_sigil", "observed_execution_head", "reason", "evidence_sigil", "aborted_at", "abort_record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-execution-namespace-abort/1.0"},
    "namespace_reservation_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-reservation/1.0#/$defs/namespaceReservationId"},
    "namespace_reservation_record_sigil": {"$ref": "#/$defs/sigil"},
    "observed_execution_head": {"$ref": "https://benchwork.dev/schemas/execution-journal-head/1.0"},
    "reason": {"enum": ["INTEGRITY_FAILURE", "RECOVERY_ACTIVE", "EXECUTOR_EPOCH_CHANGED", "FENCE_STALE", "OWNER_TERMINAL", "DEADLINE_DUE", "CANCEL_REQUESTED", "STOP_LATCHED", "LEASE_INACTIVE", "POLICY_INELIGIBLE", "OWNER_NOT_RUNNING"]},
    "evidence_sigil": {"$ref": "#/$defs/sigil"},
    "aborted_at": {"$ref": "#/$defs/timestamp"},
    "abort_record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27}
  }
}

