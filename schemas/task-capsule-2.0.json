{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/task-capsule/2.0",
  "title": "Sanctum Task Capsule v2",
  "description": "Structural contract for RFC-0011 task-capsule/2.0. Sigils, canonical order, authority narrowing, and external Registry/Snapshot/Ward resolution are semantic requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "host", "program_id", "objective", "registry_binding", "capability_binding", "snapshot_binding", "visible_inputs", "expected_outputs", "circle", "requested_assurance", "approval_binding", "created_at", "expires_at", "capsule_sigil"],
  "properties": {
    "schema_version": {"const": "task-capsule/2.0"}, "task_id": {"$ref": "#/$defs/taskId"},
    "host": {"enum": ["cli", "codex", "claude-code"]}, "program_id": {"$ref": "#/$defs/programId"},
    "objective": {"$ref": "#/$defs/humanText16384"}, "registry_binding": {"$ref": "#/$defs/registryBinding"},
    "capability_binding": {"$ref": "#/$defs/capabilityBinding"}, "snapshot_binding": {"$ref": "#/$defs/snapshotBinding"},
    "visible_inputs": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/visibleInput"}, "uniqueItems": true},
    "expected_outputs": {"type": "array", "maxItems": 256, "items": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/outputGrant"}, "uniqueItems": true},
    "circle": {"$ref": "#/$defs/circle"},
    "requested_assurance": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/assuranceGrant"},
    "approval_binding": {"$ref": "#/$defs/approvalBinding"}, "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "capsule_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]Z$", "minLength": 20, "maxLength": 20},
    "humanText16384": {"type": "string", "pattern": "^[^\\u0000]+$", "minLength": 1, "maxLength": 16384},
    "taskId": {"type": "string", "pattern": "^TK-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "programId": {"type": "string", "pattern": "^RP-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "snapshotId": {"type": "string", "pattern": "^SS-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "circleId": {"type": "string", "pattern": "^CI-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "registryId": {"type": "string", "pattern": "^CR-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "capabilityId": {"type": "string", "pattern": "^bench[.][a-z0-9]+(?:[.][a-z0-9]+)+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 9, "maxLength": 128},
    "logicalName": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 1, "maxLength": 64},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000]+$", "minLength": 1, "maxLength": 1024},
    "mediaType": {"type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 3, "maxLength": 128},
    "registryBinding": {"type": "object", "additionalProperties": false, "required": ["registry_id", "registry_revision", "registry_sigil"], "properties": {"registry_id": {"$ref": "#/$defs/registryId"}, "registry_revision": {"$ref": "#/$defs/u63"}, "registry_sigil": {"$ref": "#/$defs/sigil"}}},
    "capabilityBinding": {"type": "object", "additionalProperties": false, "required": ["capability_id", "contract_version", "contract_sigil"], "properties": {"capability_id": {"$ref": "#/$defs/capabilityId"}, "contract_version": {"const": "2.0"}, "contract_sigil": {"$ref": "#/$defs/sigil"}}},
    "snapshotBinding": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "snapshot_sigil"], "properties": {"snapshot_id": {"$ref": "#/$defs/snapshotId"}, "snapshot_sigil": {"$ref": "#/$defs/sigil"}}},
    "visibleInput": {"type": "object", "additionalProperties": false, "required": ["logical_name", "object_id", "object_type", "object_sigil", "media_type", "maximum_bytes", "mount_path"], "properties": {"logical_name": {"$ref": "#/$defs/logicalName"}, "object_id": {"$ref": "#/$defs/objectId"}, "object_type": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/snapshotObjectType"}, "object_sigil": {"$ref": "#/$defs/sigil"}, "media_type": {"$ref": "#/$defs/mediaType"}, "maximum_bytes": {"$ref": "#/$defs/positiveU63"}, "mount_path": {"$ref": "#/$defs/relativePath"}}},
    "objectId": {"type": "string", "pattern": "^(?:RP|EV|CL|HY|PT|WK|EX|RUN|RB|AS|DE|AR|IS|DV|RR|RV)-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "approvalBinding": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["requirement", "policy_id", "policy_version", "policy_sigil", "binding_scope", "bound_side_effect_ids"], "properties": {"requirement": {"const": "NOT_REQUIRED"}, "policy_id": {"type": "null"}, "policy_version": {"type": "null"}, "policy_sigil": {"type": "null"}, "binding_scope": {"const": "NONE"}, "bound_side_effect_ids": {"type": "array", "maxItems": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["requirement", "policy_id", "policy_version", "policy_sigil", "binding_scope", "bound_side_effect_ids"], "properties": {"requirement": {"const": "REQUIRED"}, "policy_id": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/approvalPolicyId"}, "policy_version": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/version"}, "policy_sigil": {"$ref": "#/$defs/sigil"}, "binding_scope": {"const": "EXACT_EXECUTION_POLICY"}, "bound_side_effect_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sideEffectId"}, "uniqueItems": true}}}
    ]},
    "circle": {"type": "object", "additionalProperties": false, "required": ["circle_id", "tools", "filesystem", "executable", "process", "network", "environment", "credential", "resource", "input", "output", "runtime", "lifecycle", "side_effects", "circle_sigil"], "properties": {"circle_id": {"$ref": "#/$defs/circleId"}, "tools": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/toolAuthority"}, "filesystem": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/filesystemAuthority"}, "executable": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/executableAuthority"}, "process": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/processAuthority"}, "network": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/networkAuthority"}, "environment": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/environmentAuthority"}, "credential": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/credentialAuthority"}, "resource": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/resourceAuthority"}, "input": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/inputAuthority"}, "output": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/outputAuthority"}, "runtime": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/runtimeAuthority"}, "lifecycle": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/lifecycleAuthority"}, "side_effects": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sideEffectAuthority"}, "circle_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

