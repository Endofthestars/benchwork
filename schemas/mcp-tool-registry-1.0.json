{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/mcp-tool-registry/1.0",
  "title": "Benchwork MCP Tool Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "stability",
    "input_schema_source",
    "response_schema",
    "tools"
  ],
  "properties": {
    "schema_version": {"const": "mcp-tool-registry/1.0"},
    "api_version": {"const": "0.3"},
    "stability": {"const": "alpha"},
    "input_schema_source": {"const": "tools/list.inputSchema"},
    "response_schema": {"const": "mcp-tool-result/1.0"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "permission",
        "risk",
        "approval",
        "canonical_effect"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^benchwork_[a-z0-9_]+$"
        },
        "category": {
          "enum": ["read", "task", "canonical", "experiment"]
        },
        "permission": {
          "enum": ["read", "propose", "commit", "execute"]
        },
        "risk": {
          "enum": ["low", "medium", "high"]
        },
        "approval": {
          "enum": [
            "none",
            "ward",
            "human_confirmation",
            "disclosure_gate",
            "conditional_disclosure"
          ]
        },
        "canonical_effect": {
          "enum": ["none", "task_event", "canonical_event", "analysis_artifact"]
        }
      }
    }
  }
}
