{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/benchwork-local-execution-log-chunk/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "lease_id",
    "worker_id",
    "worker_session_id",
    "job_binding_sigil",
    "attempt_binding_sigil",
    "lease_binding_sigil",
    "worker_session_binding_sigil",
    "executor_epoch",
    "fencing_generation",
    "expected_lease_revision",
    "stream",
    "sequence",
    "prior_accepted_sequence",
    "blob_sigil",
    "byte_length",
    "media_type",
    "message_sigil"
  ],
  "properties": {
    "schema_version": {"const": "benchwork-local-execution-log-chunk/0.1"},
    "job_id": {"type": "string", "pattern": "^JB-[A-F0-9]{64}$"},
    "attempt_id": {"type": "string", "pattern": "^AT-[A-Z0-9][A-Z0-9._-]*$"},
    "lease_id": {"type": "string", "pattern": "^LS-[A-Z0-9][A-Z0-9._-]*$"},
    "worker_id": {"type": "string", "pattern": "^WK-[A-Z0-9][A-Z0-9._-]*$"},
    "worker_session_id": {"type": "string", "pattern": "^WS-[A-Z0-9][A-Z0-9._-]*$"},
    "job_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attempt_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lease_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "worker_session_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executor_epoch": {"type": "integer", "minimum": 1},
    "fencing_generation": {"type": "integer", "minimum": 1},
    "expected_lease_revision": {"type": "integer", "minimum": 1},
    "stream": {"enum": ["STDOUT", "STDERR", "STRUCTURED"]},
    "sequence": {"type": "integer", "minimum": 0},
    "prior_accepted_sequence": {"type": ["integer", "null"], "minimum": 0},
    "blob_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_length": {"type": "integer", "minimum": 0, "maximum": 65536},
    "media_type": {"enum": ["text/plain; charset=utf-8", "application/x-ndjson"]},
    "message_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

