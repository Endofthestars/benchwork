{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-blob/1.0",
  "title": "Artifact Blob v1",
  "description": "Closed RFC-0013 artifact-blob/1.0 replay projection. This contract-only increment validates its self-contained record shape and internal collection relations; it does not read Blob bytes, resolve Storage Journal events, or calculate availability, policy, retention, integrity, or deadline state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blob_sigil", "size_bytes", "first_verified_at", "availability", "availability_as_of", "availability_basis_sigil", "effective_policy_set_sigil", "next_verification_due_at", "known_replica_ids", "eligible_replica_ids", "integrity_event_sigils", "media_type_observations", "filename_observations", "revision", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-blob/1.0"},
    "blob_sigil": {"$ref": "#/$defs/sigil"},
    "size_bytes": {"$ref": "#/$defs/u63"},
    "first_verified_at": {"$ref": "#/$defs/nullableTimestamp"},
    "availability": {"enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "INCIDENT"]},
    "availability_as_of": {"$ref": "#/$defs/eventRef"},
    "availability_basis_sigil": {"$ref": "#/$defs/sigil"},
    "effective_policy_set_sigil": {"$ref": "#/$defs/sigil"},
    "next_verification_due_at": {"$ref": "#/$defs/nullableTimestamp"},
    "known_replica_ids": {"$ref": "#/$defs/replicaIds"},
    "eligible_replica_ids": {"$ref": "#/$defs/replicaIds"},
    "integrity_event_sigils": {"$ref": "#/$defs/sigilSet"},
    "media_type_observations": {"$ref": "#/$defs/opaqueSet"},
    "filename_observations": {"$ref": "#/$defs/opaqueSet"},
    "revision": {"$ref": "#/$defs/positiveU63"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "storageJournalId": {"type": "string", "pattern": "^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "storageEventId": {"type": "string", "pattern": "^SE-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "replicaId": {"type": "string", "pattern": "^SR-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "eventRef": {
      "type": "object", "additionalProperties": false,
      "required": ["journal_id", "event_id", "sequence", "event_sigil"],
      "properties": {
        "journal_id": {"$ref": "#/$defs/storageJournalId"},
        "event_id": {"$ref": "#/$defs/storageEventId"},
        "sequence": {"$ref": "#/$defs/positiveU63"},
        "event_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "replicaIds": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/replicaId"}},
    "sigilSet": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sigil"}},
    "opaqueSet": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}}
  }
}

