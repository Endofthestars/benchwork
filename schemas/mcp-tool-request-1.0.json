{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/mcp-tool-request/1.0",
  "title": "Benchwork MCP Tool Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "arguments"],
  "properties": {
    "schema_version": {"const": "mcp-tool-request/1.0"},
    "tool": {"type": "string", "pattern": "^benchwork_[a-z0-9_]+$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "arguments": {"type": "object"},
    "host_session": {
      "$ref": "https://benchwork.dev/schemas/host-session-provenance/1.0"
    }
  }
}
