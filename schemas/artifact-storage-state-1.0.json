    "provenance": {"$ref": "#/$defs/immutableRefs"}, "provenancePolicies": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["provenance_policy_id", "record_sigil", "revision", "last_event_sigil"], "properties": {"provenance_policy_id": {"$ref": "#/$defs/provenancePolicyId"}, "record_sigil": {"$ref": "#/$defs/sigil"}, "revision": {"const": 1}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
    "immutableRefs": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["provenance_id", "record_sigil", "revision", "last_event_sigil"], "properties": {"provenance_id": {"$ref": "#/$defs/opaque"}, "record_sigil": {"$ref": "#/$defs/sigil"}, "revision": {"const": 1}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
    "retentionPolicies": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["policy_id", "record_sigil", "revision", "last_event_sigil"], "properties": {"policy_id": {"$ref": "#/$defs/policyId"}, "record_sigil": {"$ref": "#/$defs/sigil"}, "revision": {"const": 1}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
    "holds": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["hold_id", "target_kind", "target_id", "policy_id", "state", "set_authorization_sigil", "release_authorization_sigil", "revision", "last_event_sigil"], "properties": {"hold_id": {"$ref": "#/$defs/holdId"}, "target_kind": {"enum": ["BLOB", "REPLICA", "REFERENCE_SET"]}, "target_id": {"$ref": "#/$defs/opaque"}, "policy_id": {"$ref": "#/$defs/policyId"}, "state": {"enum": ["ACTIVE", "RELEASED"]}, "set_authorization_sigil": {"$ref": "#/$defs/sigil"}, "release_authorization_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "revision": {"$ref": "#/$defs/positiveU63"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
    "referenceSets": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["reference_set_id", "reference_set_sigil", "source_identity", "revision", "last_event_sigil"], "properties": {"reference_set_id": {"$ref": "#/$defs/referenceSetId"}, "reference_set_sigil": {"$ref": "#/$defs/sigil"}, "source_identity": {"$ref": "#/$defs/opaque"}, "revision": {"const": 1}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
    "legacyProtections": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["protection_id", "artifact_id", "state", "record", "receipt_sigil", "reason", "revision", "last_event_sigil"], "properties": {"protection_id": {"$ref": "#/$defs/opaque"}, "artifact_id": {"$ref": "#/$defs/opaque"}, "state": {"const": "PROTECTED"}, "record": {"$ref": "https://benchwork.dev/schemas/artifact-storage-legacy-protection/1.0"}, "receipt_sigil": {"$ref": "#/$defs/sigil"}, "reason": {"type": "null"}, "revision": {"$ref": "#/$defs/positiveU63"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}, {"type": "object", "additionalProperties": false, "required": ["protection_id", "artifact_id", "state", "record", "receipt_sigil", "reason", "revision", "last_event_sigil"], "properties": {"protection_id": {"$ref": "#/$defs/opaque"}, "artifact_id": {"$ref": "#/$defs/opaque"}, "state": {"const": "FAILED"}, "record": {"type": "null"}, "receipt_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "reason": {"$ref": "#/$defs/reason"}, "revision": {"$ref": "#/$defs/positiveU63"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}]}},
    "gcPlans": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["gc_plan_id", "record_sigil", "state", "authorization_sigil", "authorized_at", "authorization_expires_at", "target_states", "revision", "last_event_sigil"], "properties": {"gc_plan_id": {"$ref": "#/$defs/gcPlanId"}, "record_sigil": {"$ref": "#/$defs/sigil"}, "state": {"enum": ["DRAFT", "AUTHORIZED", "EXECUTING", "COMPLETED", "PARTIAL", "ABORTED"]}, "authorization_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "authorized_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "authorization_expires_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "target_states": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/gcTargetState"}}, "revision": {"$ref": "#/$defs/positiveU63"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
