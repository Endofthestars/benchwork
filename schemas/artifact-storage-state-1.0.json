    "chronicleCommit": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_body_sigil", "receipt_id", "receipt_sigil", "head"], "properties": {"event_id": {"$ref": "#/$defs/opaque"}, "event_body_sigil": {"$ref": "#/$defs/sigil"}, "receipt_id": {"$ref": "#/$defs/opaque"}, "receipt_sigil": {"$ref": "#/$defs/sigil"}, "head": {"$ref": "https://benchwork.dev/schemas/artifact-storage-reference-intent/1.0#/$defs/chronicleHeadRef"}}},
