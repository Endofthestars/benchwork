    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "journalId": {"type": "string", "pattern": "^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "transferId": {"type": "string", "pattern": "^ST-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "attemptId": {"type": "string", "pattern": "^SA-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "materializationId": {"type": "string", "pattern": "^SM-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "quarantineId": {"type": "string", "pattern": "^SQ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "gcPlanId": {"type": "string", "pattern": "^SG-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "dispositionId": {"type": "string", "pattern": "^SD-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "policyId": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "provenancePolicyId": {"type": "string", "pattern": "^SPP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "holdId": {"type": "string", "pattern": "^SH-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "referenceSetId": {"type": "string", "pattern": "^RS-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "referenceIntentId": {"type": "string", "pattern": "^RI-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "array": {"type": "array", "maxItems": 4096, "uniqueItems": true},
    "reason": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/reason"}, "reservation": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/reservationRef"}, "quotaClaim": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/quotaClaim"}, "backendObject": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/backendObjectRef"}, "residualCleanup": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/residualStagingCleanup"},
    "eventRef": {"type": "object", "additionalProperties": false, "required": ["journal_id", "event_id", "sequence", "event_sigil"], "properties": {"journal_id": {"$ref": "#/$defs/journalId"}, "event_id": {"$ref": "#/$defs/opaque"}, "sequence": {"$ref": "#/$defs/positiveU63"}, "event_sigil": {"$ref": "#/$defs/sigil"}}},
    "recoveries": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/recovery"}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["recovery_id", "origin_status", "state", "started_event_sigil", "epoch_ids", "tail_recovery_evidence_record_sigils", "completed_event_sigil", "resume_status"], "properties": {"recovery_id": {"$ref": "#/$defs/opaque"}, "origin_status": {"enum": ["INITIALIZING", "ACTIVE"]}, "state": {"enum": ["ACTIVE", "COMPLETED"]}, "started_event_sigil": {"$ref": "#/$defs/sigil"}, "epoch_ids": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/u63"}}, "tail_recovery_evidence_record_sigils": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sigil"}}, "completed_event_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "resume_status": {"enum": ["INITIALIZING", "ACTIVE", null]}}, "allOf": [{"if": {"properties": {"state": {"const": "ACTIVE"}}, "required": ["state"]}, "then": {"properties": {"completed_event_sigil": {"type": "null"}, "resume_status": {"type": "null"}}}, "else": {"properties": {"completed_event_sigil": {"$ref": "#/$defs/sigil"}, "resume_status": {"enum": ["INITIALIZING", "ACTIVE"]}}}}]},
    "recordWrapper": {"type": "object", "additionalProperties": false, "required": ["record", "last_event_sigil"], "properties": {"record": {}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}},
    "blobWrappers": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"allOf": [{"$ref": "#/$defs/recordWrapper"}, {"properties": {"record": {"$ref": "https://benchwork.dev/schemas/artifact-blob/1.0"}}}]}},
    "replicaWrappers": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"allOf": [{"$ref": "#/$defs/recordWrapper"}, {"properties": {"record": {"$ref": "https://benchwork.dev/schemas/artifact-replica/1.0"}}}]}},
