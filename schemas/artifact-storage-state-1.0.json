    "materializationWrappers": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"allOf": [{"$ref": "#/$defs/recordWrapper"}, {"properties": {"record": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0"}}}]}},
    "transferRequests": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["transfer_id", "request_record_sigil", "state", "attempt_ids", "selected_attempt_id", "revision", "last_event_sigil"], "properties": {"transfer_id": {"$ref": "#/$defs/transferId"}, "request_record_sigil": {"$ref": "#/$defs/sigil"}, "state": {"enum": ["ACTIVE", "SATISFIED"]}, "attempt_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/attemptId"}}, "selected_attempt_id": {"anyOf": [{"$ref": "#/$defs/attemptId"}, {"type": "null"}]}, "revision": {"$ref": "#/$defs/positiveU63"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}}},
