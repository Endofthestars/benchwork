    "recoveries": {"$ref": "#/$defs/recoveries"}, "blobs": {"$ref": "#/$defs/blobWrappers"}, "replicas": {"$ref": "#/$defs/replicaWrappers"}, "transfer_requests": {"$ref": "#/$defs/transferRequests"}, "transfer_attempts": {"$ref": "#/$defs/transferAttemptWrappers"}, "materializations": {"$ref": "#/$defs/materializationWrappers"}, "quarantines": {"$ref": "#/$defs/quarantines"}, "provenance": {"$ref": "#/$defs/provenance"}, "provenance_policies": {"$ref": "#/$defs/provenancePolicies"}, "retention_policies": {"$ref": "#/$defs/retentionPolicies"}, "holds": {"$ref": "#/$defs/holds"}, "reference_sets": {"$ref": "#/$defs/referenceSets"}, "legacy_v1_protections": {"$ref": "#/$defs/legacyProtections"}, "gc_plans": {"$ref": "#/$defs/gcPlans"}, "canonical_reference_intents": {"$ref": "#/$defs/canonicalReferenceIntents"}, "dispositions": {"$ref": "#/$defs/dispositions"}, "quota_reservations": {"$ref": "#/$defs/quotaReservations"}, "open_intents": {"$ref": "#/$defs/openIntents"}, "incidents": {"$ref": "#/$defs/incidents"},
    "availability_counters": {"$ref": "#/$defs/availabilityCounters"}, "quota_counters": {"$ref": "#/$defs/quotaCounters"}, "state_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {"if": {"properties": {"store_status": {"const": "RECOVERING"}}, "required": ["store_status"]}, "then": {"properties": {"active_recovery_id": {"$ref": "#/$defs/opaque"}, "recovery_origin_status": {"enum": ["INITIALIZING", "ACTIVE"]}}}, "else": {"properties": {"active_recovery_id": {"type": "null"}, "recovery_origin_status": {"type": "null"}}}}
  ],
  "$defs": {
