  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journal_id", "storage_format_version", "project_id", "backend_profile_id", "backend_profile_sigil", "conformance_profile_id", "conformance_suite_sigil", "store_status", "active_recovery_id", "recovery_origin_status", "clock_status", "clock_anchor", "current_epoch", "applied_event_count", "last_event_sigil", "recoveries", "blobs", "replicas", "transfer_requests", "transfer_attempts", "materializations", "quarantines", "provenance", "provenance_policies", "retention_policies", "holds", "reference_sets", "legacy_v1_protections", "gc_plans", "canonical_reference_intents", "dispositions", "quota_reservations", "open_intents", "incidents", "availability_counters", "quota_counters", "state_sigil"],
  "properties": {
