{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/analysis-spec/1.0",
  "title": "Registered Analysis Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparisons", "multiple_comparison_policy", "practical_significance_thresholds", "expected_run_ids"],
  "properties": {
    "schema_version": {"const": "analysis-spec/1.0"},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comparison_id", "experiment_id", "arms", "metric", "estimand", "pairing", "uncertainty_method", "confidence_level"],
        "properties": {
          "comparison_id": {"type": "string", "pattern": "^CMP-"},
          "experiment_id": {"type": "string", "pattern": "^EX-"},
          "arms": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "string", "minLength": 1}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "metric": {"type": "string", "minLength": 1},
          "estimand": {"const": "mean_difference"},
          "pairing": {"enum": ["paired", "unpaired", "none"]},
          "uncertainty_method": {"enum": ["student_t", "bootstrap", "unavailable"]},
          "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "bootstrap_seed": {"type": "integer"},
          "bootstrap_samples": {"type": "integer", "minimum": 100, "maximum": 100000}
        },
        "allOf": [
          {
            "if": {"properties": {"uncertainty_method": {"const": "bootstrap"}}},
            "then": {"required": ["bootstrap_seed", "bootstrap_samples"]}
          }
        ]
      }
    },
    "multiple_comparison_policy": {"enum": ["none", "bonferroni", "holm", "fdr"]},
    "practical_significance_thresholds": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "expected_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RUN-"}
    }
  }
}
