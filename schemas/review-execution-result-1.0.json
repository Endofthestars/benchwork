{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/review-execution-result/1.0",
  "allOf": [
    {"$ref": "https://benchwork.dev/schemas/capability-output/1.0"},
    {
      "properties": {
        "schema_version": {"const": "review-execution-result/1.0"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "reviewer", "result"],
          "properties": {
            "review_id": {"type": "string", "pattern": "^RV-"},
            "reviewer": {
              "$ref": "https://benchwork.dev/schemas/review-artifact/1.0#/properties/reviewer"
            },
            "result": {
              "$ref": "https://benchwork.dev/schemas/review-artifact/1.0#/properties/result"
            }
          }
        }
      }
    }
  ]
}
