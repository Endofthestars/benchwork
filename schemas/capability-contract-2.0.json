{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/capability-contract/2.0",
  "title": "Sanctum Capability Contract v2",
  "description": "Structural contract for RFC-0011 capability-contract/2.0. Canonical ordering, UTF-8 byte/NFC checks, self-Sigil verification, and cross-authority narrowing are semantic validation requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capability_id", "contract_version", "display_name", "purpose",
    "tools", "filesystem", "executable", "process", "network", "environment",
    "credential", "resource", "input", "output", "runtime", "lifecycle",
    "side_effects", "assurance", "approval", "issued_at", "expires_at", "contract_sigil"
  ],
  "properties": {
    "schema_version": {"const": "capability-contract/2.0"},
    "capability_id": {"$ref": "#/$defs/capabilityId"},
    "contract_version": {"const": "2.0"},
    "display_name": {"$ref": "#/$defs/humanText128"},
    "purpose": {"$ref": "#/$defs/humanText4096"},
    "tools": {"$ref": "#/$defs/toolAuthority"},
    "filesystem": {"$ref": "#/$defs/filesystemAuthority"},
    "executable": {"$ref": "#/$defs/executableAuthority"},
    "process": {"$ref": "#/$defs/processAuthority"},
    "network": {"$ref": "#/$defs/networkAuthority"},
    "environment": {"$ref": "#/$defs/environmentAuthority"},
    "credential": {"$ref": "#/$defs/credentialAuthority"},
    "resource": {"$ref": "#/$defs/resourceAuthority"},
    "input": {"$ref": "#/$defs/inputAuthority"},
    "output": {"$ref": "#/$defs/outputAuthority"},
    "runtime": {"$ref": "#/$defs/runtimeAuthority"},
    "lifecycle": {"$ref": "#/$defs/lifecycleAuthority"},
    "side_effects": {"$ref": "#/$defs/sideEffectAuthority"},
    "assurance": {"$ref": "#/$defs/assuranceAuthority"},
    "approval": {"$ref": "#/$defs/approvalAuthority"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "contract_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "minLength": 20, "maxLength": 20},
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+(?:[.][0-9]+)?$", "minLength": 3, "maxLength": 32},
    "capabilityId": {"type": "string", "pattern": "^bench[.][a-z0-9]+(?:[.][a-z0-9]+)+$", "minLength": 9, "maxLength": 128},
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1, "maxLength": 128},
    "logicalName": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "minLength": 1, "maxLength": 64},
    "schemaId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+[.][0-9]+$", "minLength": 5, "maxLength": 128},
    "mediaType": {"type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "minLength": 3, "maxLength": 128},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000]+$", "minLength": 1, "maxLength": 1024},
    "hostName": {"type": "string", "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:[.](?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$", "minLength": 1, "maxLength": 253},
    "environmentName": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "minLength": 1, "maxLength": 128},
    "humanText128": {"type": "string", "pattern": "^[^\\u0000]+$", "minLength": 1, "maxLength": 128},
    "humanText4096": {"type": "string", "pattern": "^[^\\u0000]+$", "minLength": 1, "maxLength": 4096},
    "toolId": {"type": "string", "pattern": "^TL-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "executableId": {"type": "string", "pattern": "^EX-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "runtimeId": {"type": "string", "pattern": "^RT-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "filesystemGrantId": {"type": "string", "pattern": "^FS-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "destinationId": {"type": "string", "pattern": "^ND-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "credentialHandleId": {"type": "string", "pattern": "^CH-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "sideEffectId": {"type": "string", "pattern": "^SE-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "approvalPolicyId": {"type": "string", "pattern": "^AP-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "conformanceSuiteId": {"type": "string", "pattern": "^CS-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "storagePolicyId": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 3, "maxLength": 128},

    "toolGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "tool_version", "tool_sigil", "maximum_invocations", "side_effect_id"],
      "properties": {"tool_id": {"$ref": "#/$defs/toolId"}, "tool_version": {"$ref": "#/$defs/version"}, "tool_sigil": {"$ref": "#/$defs/sigil"}, "maximum_invocations": {"$ref": "#/$defs/positiveU63"}, "side_effect_id": {"$ref": "#/$defs/sideEffectId"}}
    },
    "toolAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "DENY"}, "grants": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "ALLOWLIST"}, "grants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/toolGrant"}, "uniqueItems": true}}}
      ]
    },
    "filesystemGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "root_kind", "path_prefix", "operations", "maximum_read_bytes", "maximum_write_bytes", "maximum_entries", "maximum_depth", "symlink_policy", "mount_policy"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/filesystemGrantId"}, "root_kind": {"enum": ["SNAPSHOT_INPUT", "CRUCIBLE", "DECLARED_OUTPUT", "EPHEMERAL"]}, "path_prefix": {"$ref": "#/$defs/relativePath"},
        "operations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"enum": ["STAT", "READ", "LIST", "CREATE", "WRITE", "RENAME", "DELETE", "EXECUTE"]}, "uniqueItems": true},
        "maximum_read_bytes": {"$ref": "#/$defs/u63"}, "maximum_write_bytes": {"$ref": "#/$defs/u63"}, "maximum_entries": {"$ref": "#/$defs/u63"}, "maximum_depth": {"$ref": "#/$defs/u63"}, "symlink_policy": {"const": "NOFOLLOW"}, "mount_policy": {"const": "NO_NEW_MOUNTS"}
      }
    },
    "filesystemAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "DENY"}, "grants": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "ALLOWLIST"}, "grants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/filesystemGrant"}, "uniqueItems": true}}}
      ]
    },
    "executableGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["executable_id", "executable_version", "executable_sigil", "runtime_id", "runtime_version", "runtime_sigil", "entrypoint", "argument_schema_id", "argument_schema_sigil", "maximum_starts", "side_effect_id"],
      "properties": {"executable_id": {"$ref": "#/$defs/executableId"}, "executable_version": {"$ref": "#/$defs/version"}, "executable_sigil": {"$ref": "#/$defs/sigil"}, "runtime_id": {"$ref": "#/$defs/runtimeId"}, "runtime_version": {"$ref": "#/$defs/version"}, "runtime_sigil": {"$ref": "#/$defs/sigil"}, "entrypoint": {"$ref": "#/$defs/relativePath"}, "argument_schema_id": {"$ref": "#/$defs/schemaId"}, "argument_schema_sigil": {"$ref": "#/$defs/sigil"}, "maximum_starts": {"$ref": "#/$defs/positiveU63"}, "side_effect_id": {"$ref": "#/$defs/sideEffectId"}}
    },
    "executableAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "DENY"}, "grants": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "grants"], "properties": {"mode": {"const": "ALLOWLIST"}, "grants": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/executableGrant"}, "uniqueItems": true}}}
      ]
    },
    "processAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_processes", "maximum_tree_depth", "child_executable_ids", "process_group_signals", "dynamic_loading"], "properties": {"mode": {"const": "DENY"}, "maximum_processes": {"const": 0}, "maximum_tree_depth": {"const": 0}, "child_executable_ids": {"type": "array", "maxItems": 0}, "process_group_signals": {"const": false}, "dynamic_loading": {"const": false}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_processes", "maximum_tree_depth", "child_executable_ids", "process_group_signals", "dynamic_loading"], "properties": {"mode": {"const": "ALLOWLIST"}, "maximum_processes": {"$ref": "#/$defs/positiveU63"}, "maximum_tree_depth": {"$ref": "#/$defs/positiveU63"}, "child_executable_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/executableId"}, "uniqueItems": true}, "process_group_signals": {"type": "boolean"}, "dynamic_loading": {"type": "boolean"}}}
      ]
    },
    "networkDestination": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_id", "protocol", "host", "ports", "address_policy_sigil", "redirect_policy", "side_effect_id"],
      "properties": {"destination_id": {"$ref": "#/$defs/destinationId"}, "protocol": {"enum": ["TCP", "UDP", "HTTP", "HTTPS"]}, "host": {"$ref": "#/$defs/hostName"}, "ports": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "integer", "minimum": 1, "maximum": 65535}, "uniqueItems": true}, "address_policy_sigil": {"$ref": "#/$defs/sigil"}, "redirect_policy": {"enum": ["DENY", "SAME_DESTINATION"]}, "side_effect_id": {"$ref": "#/$defs/sideEffectId"}}
    },
    "networkAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "dns_mode", "destinations", "maximum_connections", "maximum_requests", "maximum_egress_bytes"], "properties": {"mode": {"const": "DENY"}, "dns_mode": {"const": "DENY"}, "destinations": {"type": "array", "maxItems": 0}, "maximum_connections": {"const": 0}, "maximum_requests": {"const": 0}, "maximum_egress_bytes": {"const": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "dns_mode", "destinations", "maximum_connections", "maximum_requests", "maximum_egress_bytes"], "properties": {"mode": {"const": "ALLOWLIST"}, "dns_mode": {"const": "PINNED_ANSWER"}, "destinations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/networkDestination"}, "uniqueItems": true}, "maximum_connections": {"$ref": "#/$defs/positiveU63"}, "maximum_requests": {"$ref": "#/$defs/positiveU63"}, "maximum_egress_bytes": {"$ref": "#/$defs/positiveU63"}}}
      ]
    },
    "environmentVariable": {
      "type": "object", "additionalProperties": false, "required": ["name", "source_kind", "source_binding_id", "source_sigil", "required"],
      "properties": {"name": {"$ref": "#/$defs/environmentName"}, "source_kind": {"enum": ["CONSTANT", "SNAPSHOT_METADATA", "RUNTIME_METADATA", "CREDENTIAL_HANDLE"]}, "source_binding_id": {"$ref": "#/$defs/token"}, "source_sigil": {"$ref": "#/$defs/sigil"}, "required": {"type": "boolean"}}
    },
    "environmentAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "inheritance", "variables"], "properties": {"mode": {"const": "DENY"}, "inheritance": {"const": "NONE"}, "variables": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "inheritance", "variables"], "properties": {"mode": {"const": "ALLOWLIST"}, "inheritance": {"const": "NONE"}, "variables": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/environmentVariable"}, "uniqueItems": true}}}
      ]
    },
    "credentialHandle": {
      "type": "object", "additionalProperties": false, "required": ["handle_id", "credential_class", "scope_sigil", "maximum_uses", "side_effect_id"],
      "properties": {"handle_id": {"$ref": "#/$defs/credentialHandleId"}, "credential_class": {"$ref": "#/$defs/token"}, "scope_sigil": {"$ref": "#/$defs/sigil"}, "maximum_uses": {"$ref": "#/$defs/positiveU63"}, "side_effect_id": {"$ref": "#/$defs/sideEffectId"}}
    },
    "credentialAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "ambient_credentials", "value_exposure", "handles"], "properties": {"mode": {"const": "DENY"}, "ambient_credentials": {"const": false}, "value_exposure": {"const": "NEVER"}, "handles": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "ambient_credentials", "value_exposure", "handles"], "properties": {"mode": {"const": "OPAQUE_HANDLES"}, "ambient_credentials": {"const": false}, "value_exposure": {"const": "NEVER"}, "handles": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/credentialHandle"}, "uniqueItems": true}}}
      ]
    },
    "attemptBudget": {
      "type": "object", "additionalProperties": false, "required": ["cpu_time_seconds", "peak_memory_bytes", "storage_bytes_written", "output_bytes", "log_bytes", "process_starts", "network_egress_bytes", "network_requests"],
      "properties": {"cpu_time_seconds": {"$ref": "#/$defs/u63"}, "peak_memory_bytes": {"$ref": "#/$defs/u63"}, "storage_bytes_written": {"$ref": "#/$defs/u63"}, "output_bytes": {"$ref": "#/$defs/u63"}, "log_bytes": {"$ref": "#/$defs/u63"}, "process_starts": {"$ref": "#/$defs/u63"}, "network_egress_bytes": {"$ref": "#/$defs/u63"}, "network_requests": {"$ref": "#/$defs/u63"}}
    },
    "jobBudget": {
      "type": "object", "additionalProperties": false, "required": ["attempts", "cpu_time_seconds", "storage_bytes_written", "output_bytes", "log_bytes", "process_starts", "network_egress_bytes", "network_requests"],
      "properties": {"attempts": {"$ref": "#/$defs/positiveU63"}, "cpu_time_seconds": {"$ref": "#/$defs/u63"}, "storage_bytes_written": {"$ref": "#/$defs/u63"}, "output_bytes": {"$ref": "#/$defs/u63"}, "log_bytes": {"$ref": "#/$defs/u63"}, "process_starts": {"$ref": "#/$defs/u63"}, "network_egress_bytes": {"$ref": "#/$defs/u63"}, "network_requests": {"$ref": "#/$defs/u63"}}
    },
    "resourceAuthority": {
      "type": "object", "additionalProperties": false, "required": ["attempt_budget", "job_budget", "maximum_open_files", "maximum_file_count", "maximum_concurrent_threads"],
      "properties": {"attempt_budget": {"$ref": "#/$defs/attemptBudget"}, "job_budget": {"$ref": "#/$defs/jobBudget"}, "maximum_open_files": {"$ref": "#/$defs/u63"}, "maximum_file_count": {"$ref": "#/$defs/u63"}, "maximum_concurrent_threads": {"$ref": "#/$defs/u63"}}
    },
    "inputAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_inputs", "maximum_aggregate_bytes", "allowed_object_types", "allowed_media_types", "require_immutable_identity", "require_content_sigil"], "properties": {"mode": {"const": "DENY"}, "maximum_inputs": {"const": 0}, "maximum_aggregate_bytes": {"const": 0}, "allowed_object_types": {"type": "array", "maxItems": 0}, "allowed_media_types": {"type": "array", "maxItems": 0}, "require_immutable_identity": {"const": true}, "require_content_sigil": {"const": true}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_inputs", "maximum_aggregate_bytes", "allowed_object_types", "allowed_media_types", "require_immutable_identity", "require_content_sigil"], "properties": {"mode": {"const": "ALLOWLIST"}, "maximum_inputs": {"$ref": "#/$defs/positiveU63"}, "maximum_aggregate_bytes": {"$ref": "#/$defs/positiveU63"}, "allowed_object_types": {"type": "array", "minItems": 1, "maxItems": 17, "items": {"$ref": "#/$defs/snapshotObjectType"}, "uniqueItems": true}, "allowed_media_types": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/mediaType"}, "uniqueItems": true}, "require_immutable_identity": {"const": true}, "require_content_sigil": {"const": true}}}
      ]
    },
    "snapshotObjectType": {"enum": ["research-program", "evidence", "claim", "hypothesis", "protocol", "working", "experiment", "run", "result-bundle", "assessment", "decision", "artifact", "issue", "deviation", "reproduction-record", "review-request", "review-artifact"]},
    "pathRule": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "relative_path"], "properties": {"kind": {"const": "FIXED"}, "relative_path": {"$ref": "#/$defs/relativePath"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "relative_prefix", "maximum_depth"], "properties": {"kind": {"const": "PREFIX"}, "relative_prefix": {"$ref": "#/$defs/relativePath"}, "maximum_depth": {"$ref": "#/$defs/u63"}}}
      ]
    },
    "outputGrant": {
      "type": "object", "additionalProperties": false, "required": ["logical_name", "schema_id", "schema_sigil", "maximum_bytes", "maximum_count", "path_rule", "side_effect_id"],
      "properties": {"logical_name": {"$ref": "#/$defs/logicalName"}, "schema_id": {"$ref": "#/$defs/schemaId"}, "schema_sigil": {"$ref": "#/$defs/sigil"}, "maximum_bytes": {"$ref": "#/$defs/positiveU63"}, "maximum_count": {"$ref": "#/$defs/positiveU63"}, "path_rule": {"$ref": "#/$defs/pathRule"}, "side_effect_id": {"$ref": "#/$defs/sideEffectId"}}
    },
    "outputAuthority": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_outputs", "maximum_aggregate_bytes", "grants"], "properties": {"mode": {"const": "DENY"}, "maximum_outputs": {"const": 0}, "maximum_aggregate_bytes": {"const": 0}, "grants": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "maximum_outputs", "maximum_aggregate_bytes", "grants"], "properties": {"mode": {"const": "ALLOWLIST"}, "maximum_outputs": {"$ref": "#/$defs/positiveU63"}, "maximum_aggregate_bytes": {"$ref": "#/$defs/positiveU63"}, "grants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/outputGrant"}, "uniqueItems": true}}}
      ]
    },
    "identityBinding": {
      "type": "object", "additionalProperties": false, "required": ["identity_id", "identity_version", "identity_sigil"],
      "properties": {"identity_id": {"$ref": "#/$defs/token"}, "identity_version": {"$ref": "#/$defs/version"}, "identity_sigil": {"$ref": "#/$defs/sigil"}}
    },
    "constraintBinding": {
      "type": "object", "additionalProperties": false, "required": ["constraint_id", "constraint_sigil"],
      "properties": {"constraint_id": {"$ref": "#/$defs/token"}, "constraint_sigil": {"$ref": "#/$defs/sigil"}}
    },
    "runtimeAuthority": {
      "type": "object", "additionalProperties": false, "required": ["runtime_identities", "backend_identities", "host_constraints", "identity_requirements"],
      "properties": {
        "runtime_identities": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/identityBinding"}, "uniqueItems": true},
        "backend_identities": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/identityBinding"}, "uniqueItems": true},
        "host_constraints": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/constraintBinding"}, "uniqueItems": true},
        "identity_requirements": {"type": "object", "additionalProperties": false, "required": ["require_host_identity", "require_backend_configuration_identity", "require_runtime_content_identity"], "properties": {"require_host_identity": {"type": "boolean"}, "require_backend_configuration_identity": {"type": "boolean"}, "require_runtime_content_identity": {"type": "boolean"}}}
      }
    },
    "deadlineAuthority": {
      "type": "object", "additionalProperties": false, "required": ["lease_duration_seconds", "heartbeat_interval_seconds", "heartbeat_timeout_seconds", "lease_claim_timeout_seconds", "attempt_wall_time_seconds", "cancellation_grace_seconds", "job_wall_time_seconds", "clock_uncertainty_tolerance_seconds"],
      "properties": {"lease_duration_seconds": {"$ref": "#/$defs/positiveU63"}, "heartbeat_interval_seconds": {"$ref": "#/$defs/positiveU63"}, "heartbeat_timeout_seconds": {"$ref": "#/$defs/positiveU63"}, "lease_claim_timeout_seconds": {"$ref": "#/$defs/positiveU63"}, "attempt_wall_time_seconds": {"$ref": "#/$defs/positiveU63"}, "cancellation_grace_seconds": {"$ref": "#/$defs/u63"}, "job_wall_time_seconds": {"$ref": "#/$defs/positiveU63"}, "clock_uncertainty_tolerance_seconds": {"$ref": "#/$defs/u63"}}
    },
    "retryAuthority": {
      "type": "object", "additionalProperties": false, "required": ["maximum_attempts", "allowed_retryable_terminal_reasons", "allowed_backoff_kinds", "maximum_backoff_base_seconds", "maximum_backoff_cap_seconds", "allowed_resume_policies"],
      "properties": {"maximum_attempts": {"$ref": "#/$defs/positiveU63"}, "allowed_retryable_terminal_reasons": {"type": "array", "maxItems": 25, "items": {"$ref": "#/$defs/retryableTerminalReason"}, "uniqueItems": true}, "allowed_backoff_kinds": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"enum": ["NONE", "FIXED", "EXPONENTIAL"]}, "uniqueItems": true}, "maximum_backoff_base_seconds": {"$ref": "#/$defs/u63"}, "maximum_backoff_cap_seconds": {"$ref": "#/$defs/u63"}, "allowed_resume_policies": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["FRESH_ONLY", "ALLOW_IMMUTABLE_RESUME"]}, "uniqueItems": true}}
    },
    "retryableTerminalReason": {"enum": ["ATTEMPT_DEADLINE", "HEARTBEAT_TIMEOUT", "LEASE_CLAIM_EXPIRED", "LEASE_ACTIVE_EXPIRED", "LEASE_REVOKED", "RECOVERY_FENCE", "CLOCK_UNCERTAIN", "EXECUTOR_EPOCH_CHANGED", "SESSION_CHANNEL_LOST", "PREFLIGHT_REJECTED", "START_FAILED", "COMPUTATION_FAILED", "VALIDATION_FAILED", "RESULT_CONFLICT", "RESULT_REQUIREMENT_FAILED", "OUTPUT_VALIDATION_FAILED", "TERMINAL_SOURCE_RETENTION_FAILED", "TERMINATION_FAILED", "CLEANUP_FAILED", "LOST_OWNERSHIP", "ASSURANCE_UNMET", "ASSURANCE_UNVERIFIABLE", "BUDGET_EXHAUSTED", "ATTEMPT_REJECTED", "FATAL_INFRASTRUCTURE"]},
    "loggingAuthority": {
      "type": "object", "additionalProperties": false, "required": ["stdout_maximum_bytes", "stderr_maximum_bytes", "structured_maximum_bytes", "aggregate_maximum_bytes", "chunk_maximum_bytes", "allowed_overflow_behaviors"],
