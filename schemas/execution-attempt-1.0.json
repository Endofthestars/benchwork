{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-attempt/1.0",
  "title": "Execution Attempt",
  "description": "Closed FRESH-only immutable RFC-0012 Attempt allocation record. Shape and local integrity only; it grants no allocation, Host, Lease, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "job_id",
    "job_binding_sigil",
    "retry_ordinal",
    "fencing_generation",
    "assurance_requirement",
    "backend_identity",
    "backend_version",
    "backend_implementation_sigil",
    "backend_configuration_sigil",
    "base_identity",
    "base_sigil",
    "input_identities",
    "resume_mode",
    "crucible_id",
    "output_namespace_id",
    "log_stream_ids",
    "budget_reservation",
    "attempt_authorization_requirement",
    "created_at",
    "deadline_due_at",
    "attempt_binding_sigil"
  ],
  "properties": {
    "schema_version": {"const": "execution-attempt/1.0"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "job_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "retry_ordinal": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "fencing_generation": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/u64"},
    "assurance_requirement": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/assuranceRequirement"},
    "backend_identity": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/token"},
    "backend_version": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/version"},
    "backend_implementation_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "backend_configuration_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "base_identity": {
      "anyOf": [
        {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/token"},
        {"type": "null"}
      ]
    },
    "base_sigil": {
      "anyOf": [
        {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
        {"type": "null"}
      ]
    },
    "input_identities": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "https://benchwork.dev/schemas/task-capsule/2.0#/$defs/visibleInput"}
    },
    "resume_mode": {"const": "FRESH"},
    "crucible_id": {"$ref": "#/$defs/crucibleId"},
    "output_namespace_id": {"$ref": "#/$defs/outputNamespaceId"},
    "log_stream_ids": {"$ref": "#/$defs/logStreamIds"},
    "budget_reservation": {"$ref": "#/$defs/budgetReservation"},
    "attempt_authorization_requirement": {"$ref": "#/$defs/attemptAuthorizationRequirement"},
    "created_at": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "deadline_due_at": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "attempt_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
  },
  "oneOf": [
    {
      "properties": {
        "base_identity": {"type": "null"},
        "base_sigil": {"type": "null"}
      }
    },
    {
      "properties": {
        "base_identity": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/token"},
        "base_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
      }
    }
  ],
  "$defs": {
    "attemptId": {
      "type": "string",
      "pattern": "^AT-[A-Z0-9]+$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "logStreamId": {
      "type": "string",
      "pattern": "^LG-[A-Z0-9]+$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "crucibleId": {
      "type": "string",
      "pattern": "^CU-[A-Z0-9]+$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "outputNamespaceId": {
      "type": "string",
      "pattern": "^ON-[A-Z0-9]+$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "logStreamIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STDOUT", "STDERR", "STRUCTURED"],
      "properties": {
        "STDOUT": {"$ref": "#/$defs/logStreamId"},
        "STDERR": {"$ref": "#/$defs/logStreamId"},
        "STRUCTURED": {"$ref": "#/$defs/logStreamId"}
      }
    },
    "budgetReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "cpu_time_seconds",
        "storage_bytes_written",
        "output_bytes",
        "log_bytes",
        "process_starts",
        "network_egress_bytes",
        "network_requests"
      ],
      "properties": {
        "attempts": {"const": 1},
        "cpu_time_seconds": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "storage_bytes_written": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "output_bytes": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "log_bytes": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "process_starts": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "network_egress_bytes": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
        "network_requests": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"}
      }
    },
    "attemptAuthorizationEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_effect_id", "authority_sigil"],
      "properties": {
        "side_effect_id": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sideEffectId"},
        "authority_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
      }
    },
    "attemptAuthorizationRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effects"],
          "properties": {
            "kind": {"const": "NONE"},
            "effects": {"type": "array", "maxItems": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effects"],
          "properties": {
            "kind": {"const": "REQUIRED"},
            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/attemptAuthorizationEffect"}
            }
          }
        }
      ]
    }
  }
}

