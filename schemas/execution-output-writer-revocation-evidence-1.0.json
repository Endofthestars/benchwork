{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-output-writer-revocation-evidence/1.0",
  "title": "Execution Output Writer Revocation Evidence v1",
  "description": "Closed RFC-0012 R7 output-writer revocation evidence wire. Contract-only validation establishes shape, deterministic identity, self-Sigil, and local equality/order facts only; it does not authenticate evidence, establish writer-inventory completeness, prove immutable-generation semantics, execute a decoder, read raw bytes, resolve a profile or registry, seal/read/hash output bytes, append a Journal Event, or grant Result admission authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revocation_evidence_id", "job_id", "attempt_id",
    "attempt_binding_sigil", "lease_id", "lease_binding_sigil", "worker_id",
    "worker_session_id", "worker_session_binding_sigil", "executor_epoch",
    "fence_tuple", "preallocation_event_id", "preallocation_event_sigil",
    "preallocation_binding_sigil", "storage_subject_id", "output_handle_id",
    "transfer_id", "transfer_attempt_id", "sealed_generation_binding",
    "writer_handles", "revocation_started_at", "revocation_completed_at",
    "producer_identity", "producer_evidence_binding", "verifier_identity",
    "verifier_evidence_binding", "evidence_profile_id",
    "evidence_profile_version", "evidence_profile_sigil",
    "revocation_evidence_sigil"
  ],
  "properties": {
    "schema_version": {"const": "execution-output-writer-revocation-evidence/1.0"},
    "revocation_evidence_id": {"$ref": "#/$defs/writerRevocationEvidenceId"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "attempt_binding_sigil": {"$ref": "#/$defs/sigil"},
    "lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
    "lease_binding_sigil": {"$ref": "#/$defs/sigil"},
    "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},
    "worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},
    "worker_session_binding_sigil": {"$ref": "#/$defs/sigil"},
    "executor_epoch": {"$ref": "#/$defs/u64"},
    "fence_tuple": {"$ref": "https://benchwork.dev/schemas/execution-state/1.0#/$defs/public_fence_tuple"},
    "preallocation_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"},
    "preallocation_event_sigil": {"$ref": "#/$defs/sigil"},
    "preallocation_binding_sigil": {"$ref": "#/$defs/sigil"},
    "storage_subject_id": {"$ref": "#/$defs/sigil"},
    "output_handle_id": {"$ref": "#/$defs/opaque"},
    "transfer_id": {"$ref": "#/$defs/transferId"},
    "transfer_attempt_id": {"$ref": "#/$defs/transferAttemptId"},
    "sealed_generation_binding": {"$ref": "#/$defs/sealedGenerationBinding"},
    "writer_handles": {"$ref": "#/$defs/writerHandleSet"},
    "revocation_started_at": {"$ref": "#/$defs/timestamp"},
    "revocation_completed_at": {"$ref": "#/$defs/timestamp"},
    "producer_identity": {"$ref": "#/$defs/producerIdentity"},
    "producer_evidence_binding": {"$ref": "#/$defs/rawEvidenceBinding"},
    "verifier_identity": {"$ref": "#/$defs/verifierIdentity"},
    "verifier_evidence_binding": {"$ref": "#/$defs/rawEvidenceBinding"},
    "evidence_profile_id": {"const": "EXECUTION_OUTPUT_WRITER_REVOCATION"},
    "evidence_profile_version": {"const": "1.0"},
    "evidence_profile_sigil": {"$ref": "#/$defs/sigil"},
    "revocation_evidence_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "writerRevocationEvidenceId": {"type": "string", "pattern": "^OWR-[0-9A-F]{64}$", "minLength": 68, "maxLength": 68},
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "u64": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/u64"},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "opaque": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/opaque"},
    "transferId": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferId"},
    "transferAttemptId": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferAttemptId"},
    "sealedGenerationBinding": {
      "oneOf": [
        {"$ref": "#/$defs/backendGeneration"},
        {"$ref": "#/$defs/opaqueSealedGeneration"}
      ]
    },
    "backendGeneration": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "backend_id", "backend_profile_sigil", "object_identity_sigil", "generation"],
      "properties": {
        "kind": {"const": "BACKEND_GENERATION"},
        "backend_id": {"$ref": "#/$defs/opaque"},
        "backend_profile_sigil": {"$ref": "#/$defs/sigil"},
        "object_identity_sigil": {"$ref": "#/$defs/sigil"},
        "generation": {"$ref": "#/$defs/opaque"}
      }
    },
    "opaqueSealedGeneration": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "backend_id", "backend_profile_sigil", "object_identity_sigil", "sealed_generation_sigil"],
      "properties": {
        "kind": {"const": "OPAQUE_SEALED_GENERATION"},
        "backend_id": {"$ref": "#/$defs/opaque"},
        "backend_profile_sigil": {"$ref": "#/$defs/sigil"},
        "object_identity_sigil": {"$ref": "#/$defs/sigil"},
        "sealed_generation_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "writerHandleSet": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/writerHandle"}
    },
    "writerHandle": {
      "type": "object", "additionalProperties": false,
      "required": ["writer_handle_id", "writer_kind", "writer_identity_sigil", "handle_generation_sigil", "revoked_at", "revocation_receipt_sigil"],
      "properties": {
        "writer_handle_id": {"$ref": "#/$defs/opaque"},
        "writer_kind": {"enum": ["WORKER", "BACKEND_WRITER", "EXECUTOR_DELEGATE"]},
        "writer_identity_sigil": {"$ref": "#/$defs/sigil"},
        "handle_generation_sigil": {"$ref": "#/$defs/sigil"},
        "revoked_at": {"$ref": "#/$defs/timestamp"},
        "revocation_receipt_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "producerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_id", "implementation_version", "implementation_sigil"],
      "properties": {
        "kind": {"enum": ["EXECUTOR_SUPERVISOR", "ENFORCEMENT_BACKEND"]},
        "identity_id": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/protocolIdentifier"},
        "implementation_version": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/protocolIdentifier"},
        "implementation_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "verifierIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_id", "implementation_version", "implementation_sigil"],
      "properties": {
        "kind": {"enum": ["INDEPENDENT_BACKEND_VERIFIER", "HOST_VERIFIER"]},
        "identity_id": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/protocolIdentifier"},
        "implementation_version": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/protocolIdentifier"},
        "implementation_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "rawEvidenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_evidence_id", "raw_evidence_record_sigil"],
      "properties": {
        "raw_evidence_id": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/outputWriterRawEvidenceId"},
        "raw_evidence_record_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "ownerBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "job_id", "attempt_id", "attempt_binding_sigil", "lease_id",
        "lease_binding_sigil", "worker_id", "worker_session_id",
        "worker_session_binding_sigil", "executor_epoch", "fence_tuple",
        "preallocation_event_id", "preallocation_event_sigil",
        "preallocation_binding_sigil", "storage_subject_id", "output_handle_id",
        "transfer_id", "transfer_attempt_id"
      ],
      "properties": {
        "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
        "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
        "attempt_binding_sigil": {"$ref": "#/$defs/sigil"},
        "lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
        "lease_binding_sigil": {"$ref": "#/$defs/sigil"},
        "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},
        "worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},
        "worker_session_binding_sigil": {"$ref": "#/$defs/sigil"},
        "executor_epoch": {"$ref": "#/$defs/u64"},
        "fence_tuple": {"$ref": "https://benchwork.dev/schemas/execution-state/1.0#/$defs/public_fence_tuple"},
        "preallocation_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"},
        "preallocation_event_sigil": {"$ref": "#/$defs/sigil"},
        "preallocation_binding_sigil": {"$ref": "#/$defs/sigil"},
        "storage_subject_id": {"$ref": "#/$defs/sigil"},
        "output_handle_id": {"$ref": "#/$defs/opaque"},
        "transfer_id": {"$ref": "#/$defs/transferId"},
        "transfer_attempt_id": {"$ref": "#/$defs/transferAttemptId"}
      }
    },
    "writerRevocationEvidenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["revocation_evidence_id", "revocation_evidence_sigil"],
      "properties": {
        "revocation_evidence_id": {"$ref": "#/$defs/writerRevocationEvidenceId"},
        "revocation_evidence_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

