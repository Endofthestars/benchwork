{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-replica/1.0",
  "title": "Artifact Replica v1",
  "description": "Closed RFC-0013 artifact-replica/1.0 replay projection. This contract-only increment validates its self-contained structure and state/verification matrix; it does not read a backend or Blob, resolve Transfer, Journal, or Policy records, or establish physical availability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "replica_id", "blob_sigil", "size_bytes", "backend", "object", "state", "created_by_transfer_attempt_id", "verification", "retention_policy_ids", "revision", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-replica/1.0"},
    "replica_id": {"$ref": "#/$defs/replicaId"},
    "blob_sigil": {"$ref": "#/$defs/sigil"},
    "size_bytes": {"$ref": "#/$defs/u63"},
    "backend": {"$ref": "#/$defs/backendRef"},
    "object": {"$ref": "#/$defs/backendObjectRef"},
    "state": {"enum": ["COMMITTING", "AVAILABLE", "VERIFYING", "STALE", "CORRUPT", "ABANDONED", "DELETING", "DELETED", "DELETE_FAILED"]},
    "created_by_transfer_attempt_id": {"$ref": "#/$defs/transferAttemptId"},
    "verification": {"anyOf": [{"$ref": "#/$defs/verificationRef"}, {"type": "null"}]},
    "retention_policy_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/retentionPolicyId"}},
    "revision": {"$ref": "#/$defs/positiveU63"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["COMMITTING", "ABANDONED"]}}, "required": ["state"]},
      "then": {"properties": {"verification": {"type": "null"}}, "required": ["verification"]}
    },
    {
      "if": {"properties": {"state": {"enum": ["AVAILABLE", "VERIFYING", "STALE", "DELETING", "DELETED", "DELETE_FAILED"]}}, "required": ["state"]},
      "then": {"properties": {"verification": {"$ref": "#/$defs/verificationRef"}}, "required": ["verification"]}
    }
  ],
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "replicaId": {"type": "string", "pattern": "^SR-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "transferAttemptId": {"type": "string", "pattern": "^SA-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "retentionPolicyId": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "backendRef": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_id", "backend_profile_version", "backend_profile_sigil"],
      "properties": {
        "backend_id": {"$ref": "#/$defs/opaque"},
        "backend_profile_version": {"$ref": "#/$defs/opaque"},
        "backend_profile_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "backendObjectRef": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_id", "object_identity_sigil", "locator_sigil", "generation", "size_bytes", "blob_sigil"],
      "properties": {
        "backend_id": {"$ref": "#/$defs/opaque"},
        "object_identity_sigil": {"$ref": "#/$defs/sigil"},
        "locator_sigil": {"$ref": "#/$defs/sigil"},
        "generation": {"$ref": "#/$defs/opaque"},
        "size_bytes": {"$ref": "#/$defs/u63"},
        "blob_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}
      }
    },
    "verificationRef": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "evidence_sigil", "verified_at", "next_due_at"],
      "properties": {
        "method": {"enum": ["FULL_READBACK_SHA256", "CONFORMANCE_END_TO_END"]},
        "evidence_sigil": {"$ref": "#/$defs/sigil"},
        "verified_at": {"$ref": "#/$defs/timestamp"},
        "next_due_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    }
  }
}

