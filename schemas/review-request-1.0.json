{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/review-request/1.0",
  "title": "Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "program_id",
    "type",
    "target",
    "scope",
    "disclosure",
    "destination",
    "approval",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "review-request/1.0"},
    "review_id": {"type": "string", "pattern": "^RV-"},
    "program_id": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"
    },
    "type": {"enum": ["local_review", "external_diff_review"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "files"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": ["string", "null"], "minLength": 1},
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "checks"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes_source_code",
        "includes_private_data",
        "includes_credentials",
        "includes_unpublished_results"
      ],
      "properties": {
        "includes_source_code": {"type": "boolean"},
        "includes_private_data": {"type": "boolean"},
        "includes_credentials": {"type": "boolean"},
        "includes_unpublished_results": {"type": "boolean"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "provider"],
      "properties": {
        "execution": {"enum": ["local", "external"]},
        "provider": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "approved_by",
        "approved_at",
        "rationale"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "WAITING_FOR_DISCLOSURE_AUTHORIZATION",
            "APPROVED"
          ]
        },
        "approved_by": {"type": ["string", "null"], "minLength": 1},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "rationale": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "status": {
      "enum": [
        "PREPARED",
        "WAITING_FOR_DISCLOSURE_AUTHORIZATION",
        "APPROVED",
        "COMPLETED",
        "ACCEPTED"
      ]
    },
    "requested_at": {"type": "string", "format": "date-time"},
    "request_receipt": {"type": "string", "pattern": "^RC-"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "local_review"}}},
      "then": {
        "properties": {
          "destination": {
            "properties": {
              "execution": {"const": "local"},
              "provider": {"type": "null"}
            }
          },
          "approval": {
            "properties": {
              "required": {"const": false},
              "status": {"const": "NOT_REQUIRED"},
              "approved_by": {"type": "null"},
              "approved_at": {"type": "null"},
              "rationale": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "external_diff_review"}}},
      "then": {
        "properties": {
          "destination": {
            "properties": {
              "execution": {"const": "external"},
              "provider": {"type": "string", "minLength": 1}
            }
          },
          "approval": {"properties": {"required": {"const": true}}}
        }
      }
    }
  ]
}
