{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-transfer/1.0",
  "title": "Artifact Transfer v1",
  "description": "Closed RFC-0013 immutable transfer request. Policy resolution, Journal admission, State replay, and backend effects are semantic/runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transfer_id", "direction", "purpose", "source", "destination", "expected_blob_sigil", "bounds", "backend", "authorization_sigil", "idempotency_key_sigil", "execution", "verification_method", "provenance_policy", "retention_policy_ids", "created_at", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-transfer/1.0"},
    "transfer_id": {"$ref": "#/$defs/transferId"},
    "direction": {"enum": ["INGEST", "COPY", "EXPORT", "MATERIALIZE"]},
    "purpose": {"$ref": "https://benchwork.dev/schemas/artifact-provenance-policy/1.0#/$defs/transferPurpose"},
    "source": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/sourceDescriptor"},
    "destination": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/destinationDescriptor"},
    "expected_blob_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]},
    "bounds": {"$ref": "https://benchwork.dev/schemas/artifact-materialization/1.0#/$defs/transferBounds"},
    "backend": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/backendRef"},
    "authorization_sigil": {"$ref": "#/$defs/sigil"},
    "idempotency_key_sigil": {"$ref": "#/$defs/sigil"},
    "execution": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/executionContext"},
    "verification_method": {"enum": ["FULL_READBACK_SHA256", "CONFORMANCE_END_TO_END"]},
    "provenance_policy": {"$ref": "#/$defs/provenancePolicyBinding"},
    "retention_policy_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/policyId"}},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "transferId": {"type": "string", "pattern": "^ST-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "provenancePolicyBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_policy_id", "provenance_policy_sigil"],
      "properties": {
        "provenance_policy_id": {"$ref": "https://benchwork.dev/schemas/artifact-provenance-policy/1.0#/$defs/provenancePolicyId"},
        "provenance_policy_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

