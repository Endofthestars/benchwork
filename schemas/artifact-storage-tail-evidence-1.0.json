{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://benchwork.dev/schemas/artifact-storage-tail-evidence/1.0","title":"Artifact Storage Tail Evidence v1","description":"Closed RFC-0013 Tail Evidence record contract. Raw evidence bytes are deliberately outside this record wire contract.","type":"object","additionalProperties":false,"required":["schema_version","evidence_id","recovery_id","journal_id","kind","frame_start","observed_size","observed_bytes_sigil","previous_evidence_record_sigil","created_at","record_sigil"],"properties":{"schema_version":{"const":"artifact-storage-tail-evidence/1.0"},"evidence_id":{"$ref":"#/$defs/opaque"},"recovery_id":{"$ref":"#/$defs/opaque"},"journal_id":{"$ref":"#/$defs/journalId"},"kind":{"enum":["ORIGINAL_INTERRUPTED_APPEND","RECOVERY_EVENT_SEED","RECOVERY_FRAME_TEMPLATE","RECOVERY_FRAME_RETRY_SUFFIX"]},"frame_start":{"$ref":"#/$defs/u63"},"observed_size":{"$ref":"#/$defs/positiveU63"},"observed_bytes_sigil":{"$ref":"#/$defs/sigil"},"previous_evidence_record_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/timestamp"},"record_sigil":{"$ref":"#/$defs/sigil"}},"$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"u63":{"type":"integer","minimum":0,"maximum":9223372036854775807},"positiveU63":{"type":"integer","minimum":1,"maximum":9223372036854775807},"opaque":{"type":"string","pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","minLength":1,"maxLength":256},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"journalId":{"type":"string","pattern":"^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$","not":{"pattern":"[\\r\\n]"},"minLength":4,"maxLength":128}}}

