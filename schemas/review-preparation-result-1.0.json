          "required": ["review_type", "target", "scope", "disclosure", "destination"],
          "properties": {
            "review_type": {"enum": ["local_review", "external_diff_review"]},
            "target": {
              "$ref": "https://benchwork.dev/schemas/review-request/1.0#/properties/target"
            },
            "scope": {
              "$ref": "https://benchwork.dev/schemas/review-request/1.0#/properties/scope"
            },
            "disclosure": {
              "$ref": "https://benchwork.dev/schemas/review-request/1.0#/properties/disclosure"
            },
            "destination": {
              "$ref": "https://benchwork.dev/schemas/review-request/1.0#/properties/destination"
            }
          }
        }
      }
    }
  ]
}
