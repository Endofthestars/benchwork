{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/assessment/1.2",
  "title": "Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "program_id", "protocol_id", "study_mode", "result_bundle_id", "result_bundle", "summary", "limitations", "claim_findings", "hypothesis_findings", "status", "reviewed_at", "review_receipt"],
  "properties": {
    "schema_version": {"const": "assessment/1.2"},
    "assessment_id": {"type": "string", "pattern": "^AS-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "protocol_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/protocol_id"},
    "study_mode": {"enum": ["confirmatory", "exploratory"]},
    "result_bundle_id": {"type": "string", "pattern": "^RB-"},
    "result_bundle": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/artifact_ref"},
    "summary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "rationale"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CL-"},
          "status": {"enum": ["SUPPORTED", "CONTESTED", "REJECTED", "UNRESOLVED"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypothesis_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "status", "rationale"],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^HY-"},
          "status": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "REJECTED"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"const": "COMPLETE"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_receipt": {"type": "string", "pattern": "^RC-"}
  },
  "allOf": [
    {
      "if": {"properties": {"study_mode": {"const": "confirmatory"}}},
      "then": {"properties": {"hypothesis_findings": {"minItems": 1}}}
    }
  ]
}
