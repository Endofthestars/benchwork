{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-bundle/1.0",
  "title": "Patch Bundle v1",
  "description": "Closed RFC-0014 patch-bundle/1.0 contract-only record. Validation is local and does not resolve Base, profile, Receipt, source, Blob bytes, or export provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "base", "postimage", "operations", "payloads", "renderings", "attachments", "source", "agent_result_receipt", "limits", "bundle_sigil"],
  "properties": {
    "schema_version": {"const": "patch-bundle/1.0"},
    "bundle_id": {"$ref": "#/$defs/pbu"},
    "base": {"$ref": "#/$defs/pbRef"},
    "postimage": {"$ref": "#/$defs/postimage"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}},
    "payloads": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/blob"}},
    "renderings": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/blob"}},
    "attachments": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/blob"}},
    "source": {"$ref": "#/$defs/source"},
    "agent_result_receipt": {"$ref": "#/$defs/receipt"},
    "limits": {"$ref": "#/$defs/limits"},
    "bundle_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "maxPaths": {"type": "integer", "minimum": 1, "maximum": 100000},
    "maxBlobs": {"type": "integer", "minimum": 1, "maximum": 4096},
    "text128": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "text4096": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "pbu": {"type": "string", "pattern": "^PBU-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 5, "maxLength": 128},
    "pb": {"type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 4, "maxLength": 128},
    "pbip": {"type": "string", "pattern": "^PBIP-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 6, "maxLength": 128},
    "rc": {"type": "string", "pattern": "^RC-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 4, "maxLength": 128},
    "ce": {"type": "string", "pattern": "^CE-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 4, "maxLength": 128},
    "pbRef": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"$ref": "#/$defs/pb"}, "sigil": {"$ref": "#/$defs/sigil"}}},
    "pbipRef": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"$ref": "#/$defs/pbip"}, "sigil": {"$ref": "#/$defs/sigil"}}},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sigil", "size_bytes", "media_type"], "properties": {"sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "media_type": {"$ref": "#/$defs/text128"}}},
    "tree": {"type": "object", "additionalProperties": false, "required": ["manifest_sigil", "root_entry_sigil", "entry_count", "total_bytes"], "properties": {"manifest_sigil": {"$ref": "#/$defs/sigil"}, "root_entry_sigil": {"$ref": "#/$defs/sigil"}, "entry_count": {"type": "integer", "minimum": 0, "maximum": 100000}, "total_bytes": {"$ref": "#/$defs/u63"}}},
    "postimage": {"type": "object", "additionalProperties": false, "required": ["identity_profile", "tree", "manifest_blob"], "properties": {"identity_profile": {"$ref": "#/$defs/pbipRef"}, "tree": {"$ref": "#/$defs/tree"}, "manifest_blob": {"$ref": "#/$defs/blob"}}},
    "entry": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "ABSENT"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "blob_sigil", "size_bytes", "executable"], "properties": {"kind": {"const": "FILE"}, "blob_sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "executable": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "entry_sigil"], "properties": {"kind": {"const": "DIRECTORY"}, "entry_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "target", "target_sigil"], "properties": {"kind": {"const": "SYMLINK"}, "target": {"$ref": "#/$defs/text4096"}, "target_sigil": {"$ref": "#/$defs/sigil"}}}
    ]},
    "operation": {"type": "object", "additionalProperties": false, "required": ["path_bytes", "operation", "preimage", "postimage", "payload_sigil"], "properties": {"path_bytes": {"$ref": "#/$defs/text4096"}, "operation": {"enum": ["ADD", "MODIFY", "DELETE", "TYPE_CHANGE"]}, "preimage": {"$ref": "#/$defs/entry"}, "postimage": {"$ref": "#/$defs/entry"}, "payload_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "terminal_source_sigil", "execution_event_sigil", "frozen_at"], "properties": {"kind": {"const": "RETAINED_TERMINAL_SOURCE"}, "terminal_source_sigil": {"$ref": "#/$defs/sigil"}, "execution_event_sigil": {"$ref": "#/$defs/sigil"}, "frozen_at": {"$ref": "#/$defs/timestamp"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_sigil", "event_id", "event_body_sigil"], "properties": {"receipt_id": {"$ref": "#/$defs/rc"}, "receipt_sigil": {"$ref": "#/$defs/sigil"}, "event_id": {"$ref": "#/$defs/ce"}, "event_body_sigil": {"$ref": "#/$defs/sigil"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_paths", "max_blobs", "max_total_bytes", "max_payload_bytes"], "properties": {"max_paths": {"$ref": "#/$defs/maxPaths"}, "max_blobs": {"$ref": "#/$defs/maxBlobs"}, "max_total_bytes": {"$ref": "#/$defs/u63"}, "max_payload_bytes": {"$ref": "#/$defs/u63"}}}
  }
}

