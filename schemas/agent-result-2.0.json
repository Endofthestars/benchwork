    "outputs": {"type":"array","maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/output"}},
    "provenance": {"$ref":"#/$defs/provenance"},
    "result_sigil": {"$ref":"#/$defs/sigil"}
