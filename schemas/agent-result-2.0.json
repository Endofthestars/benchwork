    "execution_specification_binding": {"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/specificationBinding"},
    "job_outcome_binding": {"$ref":"https://benchwork.dev/schemas/agent-result-acceptance-authorization/1.0#/$defs/jobOutcomeBinding"},
