  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","task_id","program_id","task_capsule_sigil","host_identity_sigil","capability_binding","snapshot_binding","job_binding","execution_specification_binding","job_outcome_binding","terminal_event_sigil","selected_attempt_id","assurance_claim_sigil","terminal_source_binding","status","outputs","provenance","result_sigil"],
  "properties": {
    "schema_version": {"const":"agent-result/2.0"},
    "task_id": {"$ref":"https://benchwork.dev/schemas/task-capsule/2.0#/$defs/taskId"},
    "program_id": {"$ref":"https://benchwork.dev/schemas/task-capsule/2.0#/$defs/programId"},
    "task_capsule_sigil": {"$ref":"#/$defs/sigil"},
    "host_identity_sigil": {"$ref":"#/$defs/sigil"},
