    "u63": {"$ref":"https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
    "opaque": {"type":"string","pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","not":{"pattern":"[\\r\\n]"},"minLength":1,"maxLength":256},
    "output": {"type":"object","additionalProperties":false,"required":["task_output_id","declared_schema_id","declared_schema_sigil","blob_sigil","size_bytes","source_observation_member_sigil","storage_integrity_evidence_sigil"],"properties":{"task_output_id":{"$ref":"#/$defs/opaque"},"declared_schema_id":{"$ref":"#/$defs/opaque"},"declared_schema_sigil":{"$ref":"#/$defs/sigil"},"blob_sigil":{"$ref":"#/$defs/sigil"},"size_bytes":{"$ref":"#/$defs/u63"},"source_observation_member_sigil":{"$ref":"#/$defs/sigil"},"storage_integrity_evidence_sigil":{"$ref":"#/$defs/sigil"}}},
    "acceptedTerminalSourceBinding": {"oneOf":[{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"NOT_APPLICABLE"}}},{"$ref":"https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/verified_terminal_source_binding"}]},
    "provenance": {"type":"object","additionalProperties":false,"required":["executor_instance_id","executor_epoch","executor_build_sigil","worker_id","worker_binding_sigil","worker_session_id","worker_session_binding_sigil","backend_identity","backend_configuration_sigil","requested_assurance_level","assurance_profile_sigil","conformance_suite_sigil","attempt_authorization_state","budget_settlement_event_sigil","job_budget_ledger_sigil","storage_observation_binding","control_evidence_set_binding","quarantine_binding_set_binding","terminalization_storage_manifest_binding","output_root_protection"],"properties":{"executor_instance_id":{"$ref":"https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/executorInstanceId"},"executor_epoch":{"$ref":"https://benchwork.dev/schemas/execution-state/1.0#/$defs/u64"},"executor_build_sigil":{"$ref":"#/$defs/sigil"},"worker_id":{"$ref":"https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},"worker_binding_sigil":{"$ref":"#/$defs/sigil"},"worker_session_id":{"$ref":"https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},"worker_session_binding_sigil":{"$ref":"#/$defs/sigil"},"backend_identity":{"$ref":"#/$defs/opaque"},"backend_configuration_sigil":{"$ref":"#/$defs/sigil"},"requested_assurance_level":{"enum":["SANCTUM-A0","SANCTUM-A1","SANCTUM-A2"]},"assurance_profile_sigil":{"$ref":"#/$defs/sigil"},"conformance_suite_sigil":{"$ref":"#/$defs/sigil"},"attempt_authorization_state":{"$ref":"https://benchwork.dev/schemas/execution-state/1.0#/$defs/attempt_authorization_state"},"budget_settlement_event_sigil":{"$ref":"#/$defs/sigil"},"job_budget_ledger_sigil":{"$ref":"#/$defs/sigil"},"storage_observation_binding":{"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/outcomeStorageObservationBinding"},"control_evidence_set_binding":{"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/terminalControlEvidenceSetBinding"},"quarantine_binding_set_binding":{"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/terminalQuarantineBindingSetBinding"},"terminalization_storage_manifest_binding":{"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/outcomeStorageManifestBinding"},"output_root_protection":{"$ref":"https://benchwork.dev/schemas/execution-job-outcome/1.0#/$defs/outcomeRootProtection"}}}
  }
}
