{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-operational-root-plan/1.0",
  "title": "Patch Operational Root Plan v1",
  "description": "Closed RFC-0014 previsibility plan. Validation is contract-only: it does not resolve Storage records, reserve slots, or validate a future Promotion Journal event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "operational_journal_id", "activation_event_id", "activation_event_type", "payload_field", "root_kind", "operational_root_id", "control_record", "reference_set", "reference_set_registration_event", "hold_id", "hold_set_event_id", "policy_id", "policy_sigil", "authorization_kind", "plan_sigil"],
  "properties": {
    "schema_version": {"const": "patch-operational-root-plan/1.0"}, "plan_id": {"$ref": "#/$defs/plan_id"}, "operational_journal_id": {"$ref": "#/$defs/pj"}, "activation_event_id": {"$ref": "#/$defs/pje"}, "activation_event_type": {"$ref": "#/$defs/event_type"}, "payload_field": {"$ref": "#/$defs/payload_field"}, "root_kind": {"$ref": "#/$defs/root_kind"}, "operational_root_id": {"$ref": "#/$defs/root_id"}, "control_record": {"$ref": "#/$defs/control_record"}, "reference_set": {"$ref": "#/$defs/reference_set"}, "reference_set_registration_event": {"$ref": "#/$defs/storage_event"}, "hold_id": {"$ref": "#/$defs/sh"}, "hold_set_event_id": {"$ref": "#/$defs/se"}, "policy_id": {"$ref": "#/$defs/sp"}, "policy_sigil": {"$ref": "#/$defs/sigil"}, "authorization_kind": {"enum": ["PROMOTION_CONTROL", "JOURNAL_RECOVERY"]}, "plan_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {"oneOf": [
      {"properties": {"activation_event_type": {"const": "coordinator.replay-started"}, "payload_field": {"const": "SUFFIX_EVIDENCE_PROTECTION"}, "root_kind": {"const": "JOURNAL_SUFFIX"}, "authorization_kind": {"const": "JOURNAL_RECOVERY"}}},
      {"properties": {"activation_event_type": {"const": "target.guard-validated"}, "payload_field": {"const": "PRIOR_STEP_PROTECTION"}, "root_kind": {"const": "EVIDENCE"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}},
      {"properties": {"activation_event_type": {"const": "promotion.checkpoint-committed"}, "payload_field": {"const": "CHECKPOINT_PROTECTION"}, "root_kind": {"const": "CHECKPOINT"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}},
      {"properties": {"activation_event_type": {"const": "promotion.mutation-intent-committed"}, "payload_field": {"const": "INTENT_PROTECTION"}, "root_kind": {"const": "MUTATION_INTENT"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}},
      {"properties": {"activation_event_type": {"const": "recovery.checkpoint-verified"}, "payload_field": {"const": "CHECKPOINT_PROTECTION"}, "root_kind": {"const": "CHECKPOINT"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}},
      {"properties": {"activation_event_type": {"const": "recovery.intent-committed"}, "payload_field": {"const": "INTENT_PROTECTION"}, "root_kind": {"const": "RECOVERY_INTENT"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}},
      {"properties": {"activation_event_type": {"enum": ["promotion.verification-started", "promotion.applied", "promotion.recovered-postimage-observed", "promotion.already-applied", "promotion.stale", "promotion.conflicted", "promotion.failed", "promotion.partial", "promotion.cancelled", "recovery.verification-started", "recovery.base-restored", "recovery.postimage-accepted", "recovery.abandoned", "recovery.stale", "recovery.failed", "recovery.partial", "recovery.cancelled"]}, "payload_field": {"const": "EVIDENCE_PROTECTION"}, "root_kind": {"const": "EVIDENCE"}, "authorization_kind": {"const": "PROMOTION_CONTROL"}}}
    ]},
    {"if": {"properties": {"root_kind": {"const": "CHECKPOINT"}}}, "then": {"properties": {"control_record": {"properties": {"schema_version": {"const": "patch-promotion-checkpoint/1.0"}}}}}},
    {"if": {"properties": {"root_kind": {"const": "MUTATION_INTENT"}}}, "then": {"properties": {"control_record": {"properties": {"schema_version": {"const": "patch-promotion-mutation-intent/1.0"}}}}}},
    {"if": {"properties": {"root_kind": {"const": "RECOVERY_INTENT"}}}, "then": {"properties": {"control_record": {"properties": {"schema_version": {"const": "patch-promotion-recovery-intent/1.0"}}}}}},
    {"if": {"properties": {"root_kind": {"enum": ["EVIDENCE", "JOURNAL_SUFFIX"]}}}, "then": {"properties": {"control_record": {"properties": {"schema_version": {"const": "patch-operational-evidence-manifest/1.0"}}}}}}
  ],
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "pj": {"type": "string", "pattern": "^PJ-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 4, "maxLength": 128}, "pje": {"type": "string", "pattern": "^PJE-[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 5, "maxLength": 128}, "plan_id": {"type": "string", "pattern": "^PORP-[A-F0-9]{64}$", "minLength": 69, "maxLength": 69}, "root_id": {"type": "string", "pattern": "^PROOT-[0-9a-f]{32}$", "minLength": 38, "maxLength": 38},
    "sh": {"type": "string", "pattern": "^SH-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "se": {"type": "string", "pattern": "^SE-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "sp": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "rs": {"type": "string", "pattern": "^RS-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "sj": {"type": "string", "pattern": "^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "storage_opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "event_type": {"enum": ["coordinator.replay-started", "target.guard-validated", "promotion.checkpoint-committed", "promotion.mutation-intent-committed", "promotion.verification-started", "promotion.applied", "promotion.recovered-postimage-observed", "promotion.already-applied", "promotion.stale", "promotion.conflicted", "promotion.failed", "promotion.partial", "promotion.cancelled", "recovery.checkpoint-verified", "recovery.intent-committed", "recovery.verification-started", "recovery.base-restored", "recovery.postimage-accepted", "recovery.abandoned", "recovery.stale", "recovery.failed", "recovery.partial", "recovery.cancelled"]},
    "payload_field": {"enum": ["CHECKPOINT_PROTECTION", "INTENT_PROTECTION", "PRIOR_STEP_PROTECTION", "EVIDENCE_PROTECTION", "SUFFIX_EVIDENCE_PROTECTION"]}, "root_kind": {"enum": ["CHECKPOINT", "MUTATION_INTENT", "RECOVERY_INTENT", "EVIDENCE", "JOURNAL_SUFFIX"]},
    "control_record": {"type": "object", "additionalProperties": false, "required": ["schema_version", "record_id", "record_sigil"], "properties": {"schema_version": {"$ref": "#/$defs/storage_opaque"}, "record_id": {"$ref": "#/$defs/storage_opaque"}, "record_sigil": {"$ref": "#/$defs/sigil"}}},
    "reference_set": {"type": "object", "additionalProperties": false, "required": ["reference_set_id", "reference_set_sigil"], "properties": {"reference_set_id": {"$ref": "#/$defs/rs"}, "reference_set_sigil": {"$ref": "#/$defs/sigil"}}},
    "storage_event": {"type": "object", "additionalProperties": false, "required": ["journal_id", "event_id", "sequence", "event_sigil"], "properties": {"journal_id": {"$ref": "#/$defs/sj"}, "event_id": {"$ref": "#/$defs/se"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "event_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

