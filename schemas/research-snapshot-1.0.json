{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/research-snapshot/1.0",
  "title": "Research Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "program_id",
    "chronicle_head_sigil",
    "objects",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "research-snapshot/1.0"},
    "snapshot_id": {"type": "string", "pattern": "^SS-[A-Z0-9]+$"},
    "program_id": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"
    },
    "chronicle_head_sigil": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "object_type", "object_sigil"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "object_type": {
            "enum": [
              "research-program",
              "evidence",
              "claim",
              "hypothesis",
              "protocol",
              "working",
              "experiment",
              "run",
              "result-bundle",
              "assessment",
              "decision",
              "artifact",
              "issue",
              "deviation",
              "reproduction-record"
            ]
          },
          "object_sigil": {
            "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
