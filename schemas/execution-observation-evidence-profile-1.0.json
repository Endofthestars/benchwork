{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-observation-evidence-profile/1.0",
  "title": "Execution Observation Evidence Profile v1",
  "description": "Closed RFC-0012 O8 structural profile. Contract-only validation does not install or execute a decoder, read raw evidence, authenticate an issuer or source, resolve a registry or implementation, establish counter semantics or independence, validate the evidence-graph time matrix, append a Journal Event, or grant evidence authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_profile_id",
    "evidence_profile_version",
    "subject_kind",
    "producer_implementations",
    "verifier_implementations",
    "allowed_role_pairs",
    "decoder_profiles",
    "raw_media_profiles",
    "authentication_profiles",
    "source_authentication_profiles",
    "process_identity_profile_sigil",
    "cpu_clock_profile_sigil",
    "memory_observation_profile_sigil",
    "independence_profile_sigil",
    "maximum_raw_payload_bytes",
    "profile_sigil"
  ],
  "properties": {
    "schema_version": {"const": "execution-observation-evidence-profile/1.0"},
    "evidence_profile_id": {"$ref": "#/$defs/protocolIdentifier"},
    "evidence_profile_version": {"$ref": "#/$defs/protocolIdentifier"},
    "subject_kind": {"const": "EXECUTION_OBSERVATION"},
    "producer_implementations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/implementationEntry"},
          {"properties": {"role_kind": {"const": "WORKER_SESSION"}}}
        ]
      }
    },
    "verifier_implementations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/implementationEntry"},
          {
            "properties": {
              "role_kind": {
                "enum": [
                  "EXECUTOR_SUPERVISOR",
                  "ENFORCEMENT_BACKEND",
                  "HOST_VERIFIER",
                  "INDEPENDENT_BACKEND_VERIFIER"
                ]
              }
            }
          }
        ]
      }
    },
    "allowed_role_pairs": {"$ref": "#/$defs/allowedRolePairArray"},
    "decoder_profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decoderProfile"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {"role": {"const": "PRODUCER"}},
            "required": ["role"]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {"role": {"const": "VERIFIER"}},
            "required": ["role"]
          },
          "minContains": 1
        }
      ]
    },
    "raw_media_profiles": {"$ref": "#/$defs/rawMediaProfileArray"},
    "authentication_profiles": {"$ref": "#/$defs/authenticationProfileArray"},
    "source_authentication_profiles": {"$ref": "#/$defs/sourceAuthenticationProfileArray"},
    "process_identity_profile_sigil": {"$ref": "#/$defs/sigil"},
    "cpu_clock_profile_sigil": {"$ref": "#/$defs/sigil"},
    "memory_observation_profile_sigil": {"$ref": "#/$defs/sigil"},
    "independence_profile_sigil": {"$ref": "#/$defs/sigil"},
    "maximum_raw_payload_bytes": {"$ref": "#/$defs/positiveU63"},
    "profile_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/sigil"},
    "positiveU63": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/positiveU63"},
    "protocolIdentifier": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/protocolIdentifier"},
    "evidenceMediaType": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/evidenceMediaType"},
    "roleKind": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/roleKind"},
    "authorityKind": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/authorityKind"},
    "issuerKind": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/issuerIdentity/properties/issuer_kind"},
    "decoderBinding": {"$ref": "https://benchwork.dev/schemas/execution-evidence-issuer-authentication/1.0#/$defs/decoderBinding"},
    "evidenceRole": {"enum": ["PRODUCER", "VERIFIER"]},
    "observationSource": {"enum": ["WORKER", "EXECUTOR_SUPERVISOR", "ENFORCEMENT_BACKEND"]},
    "sourceRoleKind": {"enum": ["WORKER_SESSION", "EXECUTOR_SUPERVISOR", "ENFORCEMENT_BACKEND"]},
    "proofKind": {"enum": ["SIGNATURE", "ATTESTATION"]},
    "implementationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_kind", "implementation_version", "implementation_sigil"],
      "properties": {
        "role_kind": {"$ref": "#/$defs/roleKind"},
        "implementation_version": {"$ref": "#/$defs/protocolIdentifier"},
        "implementation_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "allowedRolePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_role_kind", "observation_source", "verifier_role_kind"],
      "properties": {
        "producer_role_kind": {"const": "WORKER_SESSION"},
        "observation_source": {"$ref": "#/$defs/observationSource"},
        "verifier_role_kind": {"$ref": "#/$defs/roleKind"}
      },
      "oneOf": [
        {
          "properties": {
            "observation_source": {"const": "WORKER"},
            "verifier_role_kind": {
              "enum": [
                "EXECUTOR_SUPERVISOR",
                "ENFORCEMENT_BACKEND",
                "HOST_VERIFIER",
                "INDEPENDENT_BACKEND_VERIFIER"
              ]
            }
          }
        },
        {
          "properties": {
            "observation_source": {"const": "EXECUTOR_SUPERVISOR"},
            "verifier_role_kind": {
              "enum": ["ENFORCEMENT_BACKEND", "HOST_VERIFIER", "INDEPENDENT_BACKEND_VERIFIER"]
            }
          }
        },
        {
          "properties": {
            "observation_source": {"const": "ENFORCEMENT_BACKEND"},
            "verifier_role_kind": {
              "enum": ["EXECUTOR_SUPERVISOR", "HOST_VERIFIER", "INDEPENDENT_BACKEND_VERIFIER"]
            }
          }
        }
      ]
    },
    "allowedRolePairArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/allowedRolePair"}
    },
    "decoderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "decoder_binding",
        "media_type",
        "maximum_input_bytes",
        "maximum_output_bytes",
        "maximum_cpu_time_milliseconds",
        "maximum_memory_bytes",
        "maximum_recursion_depth",
        "decoded_contract_sigil"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/evidenceRole"},
        "decoder_binding": {"$ref": "#/$defs/decoderBinding"},
        "media_type": {"$ref": "#/$defs/evidenceMediaType"},
        "maximum_input_bytes": {"$ref": "#/$defs/positiveU63"},
        "maximum_output_bytes": {"$ref": "#/$defs/positiveU63"},
        "maximum_cpu_time_milliseconds": {"$ref": "#/$defs/positiveU63"},
        "maximum_memory_bytes": {"$ref": "#/$defs/positiveU63"},
        "maximum_recursion_depth": {"$ref": "#/$defs/positiveU63"},
        "decoded_contract_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "rawMediaProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "media_type", "maximum_input_bytes"],
      "properties": {
        "role": {"$ref": "#/$defs/evidenceRole"},
        "media_type": {"$ref": "#/$defs/evidenceMediaType"},
        "maximum_input_bytes": {"$ref": "#/$defs/positiveU63"}
      }
    },
    "rawMediaProfileArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rawMediaProfile"}
    },
    "authenticationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "evidence_kind",
        "role_kind",
        "authority_kind",
        "issuer_kind",
        "registry_id",
        "registry_version",
        "registry_snapshot_sigil",
        "allowed_key_profile_sigil",
        "verification_profile_sigil",
        "allowed_proof_kind"
      ],
      "properties": {
        "subject_kind": {"const": "EXECUTION_OBSERVATION"},
        "evidence_kind": {"$ref": "#/$defs/evidenceRole"},
        "role_kind": {"$ref": "#/$defs/roleKind"},
        "authority_kind": {"$ref": "#/$defs/authorityKind"},
        "issuer_kind": {"$ref": "#/$defs/issuerKind"},
        "registry_id": {"$ref": "#/$defs/protocolIdentifier"},
        "registry_version": {"$ref": "#/$defs/protocolIdentifier"},
        "registry_snapshot_sigil": {"$ref": "#/$defs/sigil"},
        "allowed_key_profile_sigil": {"$ref": "#/$defs/sigil"},
        "verification_profile_sigil": {"$ref": "#/$defs/sigil"},
        "allowed_proof_kind": {"$ref": "#/$defs/proofKind"}
      },
      "oneOf": [
        {
          "properties": {
            "evidence_kind": {"const": "PRODUCER"},
            "role_kind": {"const": "WORKER_SESSION"},
            "authority_kind": {"const": "RESULT_INGRESS_RECEIPT"}
          }
        },
        {
          "properties": {
            "evidence_kind": {"const": "VERIFIER"},
            "role_kind": {
              "enum": [
                "EXECUTOR_SUPERVISOR",
                "ENFORCEMENT_BACKEND",
                "HOST_VERIFIER",
                "INDEPENDENT_BACKEND_VERIFIER"
              ]
            },
            "authority_kind": {"const": "TRUSTED_VERIFIER_IDENTITY"}
          }
        }
      ]
    },
    "authenticationProfileArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authenticationProfile"}
    },
    "sourceAuthenticationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_source",
        "source_role_kind",
        "source_identity_profile_sigil",
        "source_channel_profile_sigil",
        "source_registry_id",
        "source_registry_profile_sigil",
        "verifier_role_kind"
      ],
      "properties": {
        "observation_source": {"$ref": "#/$defs/observationSource"},
        "source_role_kind": {"$ref": "#/$defs/sourceRoleKind"},
        "source_identity_profile_sigil": {"$ref": "#/$defs/sigil"},
        "source_channel_profile_sigil": {"$ref": "#/$defs/sigil"},
        "source_registry_id": {"$ref": "#/$defs/protocolIdentifier"},
        "source_registry_profile_sigil": {"$ref": "#/$defs/sigil"},
        "verifier_role_kind": {"$ref": "#/$defs/roleKind"}
      },
      "oneOf": [
        {
          "properties": {
            "observation_source": {"const": "WORKER"},
            "source_role_kind": {"const": "WORKER_SESSION"},
            "verifier_role_kind": {
              "enum": [
                "EXECUTOR_SUPERVISOR",
                "ENFORCEMENT_BACKEND",
                "HOST_VERIFIER",
                "INDEPENDENT_BACKEND_VERIFIER"
              ]
            }
          }
        },
        {
          "properties": {
            "observation_source": {"const": "EXECUTOR_SUPERVISOR"},
            "source_role_kind": {"const": "EXECUTOR_SUPERVISOR"},
            "verifier_role_kind": {
              "enum": ["ENFORCEMENT_BACKEND", "HOST_VERIFIER", "INDEPENDENT_BACKEND_VERIFIER"]
            }
          }
        },
        {
          "properties": {
            "observation_source": {"const": "ENFORCEMENT_BACKEND"},
            "source_role_kind": {"const": "ENFORCEMENT_BACKEND"},
            "verifier_role_kind": {
              "enum": ["EXECUTOR_SUPERVISOR", "HOST_VERIFIER", "INDEPENDENT_BACKEND_VERIFIER"]
            }
          }
        }
      ]
    },
    "sourceAuthenticationProfileArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceAuthenticationProfile"}
    }
  }
}

