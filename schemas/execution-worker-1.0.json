{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-worker/1.0",
  "title": "Execution Worker v1",
  "description": "Closed RFC-0012 immutable Worker definition revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_id", "definition_revision", "implementation_name", "implementation_version", "supported_runtimes", "resource_ceilings", "declared_backend_capabilities", "verified_capability_tuples", "maximum_concurrency", "definition_created_at", "worker_binding_sigil"],
  "properties": {
    "schema_version": {"const": "execution-worker/1.0"},
    "worker_id": {"$ref": "#/$defs/workerId"},
    "definition_revision": {"$ref": "#/$defs/u64"},
    "supersedes_worker_binding_sigil": {"$ref": "#/$defs/sigil"},
    "implementation_name": {"$ref": "#/$defs/opaque128"},
    "implementation_version": {"$ref": "#/$defs/version"},
    "supported_runtimes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/runtimeSupport"}},
    "resource_ceilings": {"$ref": "#/$defs/resourceCeilings"},
    "declared_backend_capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/declaredBackendCapability"}},
    "verified_capability_tuples": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/verifiedCapabilityTuple"}},
    "maximum_concurrency": {"$ref": "#/$defs/positiveU63"},
    "definition_created_at": {"$ref": "#/$defs/timestamp"},
    "worker_binding_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {"if": {"properties": {"definition_revision": {"const": 0}}, "required": ["definition_revision"]}, "then": {"not": {"required": ["supersedes_worker_binding_sigil"]}}, "else": {"required": ["supersedes_worker_binding_sigil"]}}
  ],
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "version": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/version"},
    "positiveU63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "u63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/timestamp"},
    "workerId": {"type": "string", "pattern": "^WK-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "minLength": 4, "maxLength": 128},
    "opaque128": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 128},
    "runtimeSupport": {"type": "object", "additionalProperties": false, "required": ["runtime_id", "runtime_version", "runtime_sigil"], "properties": {"runtime_id": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/runtimeId"}, "runtime_version": {"$ref": "#/$defs/version"}, "runtime_sigil": {"$ref": "#/$defs/sigil"}}},
    "resourceCeilings": {"type": "object", "additionalProperties": false, "required": ["attempt_budget", "maximum_open_files", "maximum_file_count", "maximum_concurrent_threads"], "properties": {"attempt_budget": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/attemptBudget"}, "maximum_open_files": {"$ref": "#/$defs/u63"}, "maximum_file_count": {"$ref": "#/$defs/u63"}, "maximum_concurrent_threads": {"$ref": "#/$defs/u63"}}},
    "declaredBackendCapability": {"type": "object", "additionalProperties": false, "required": ["capability_id", "capability_version", "declaration_sigil"], "properties": {"capability_id": {"$ref": "#/$defs/opaque128"}, "capability_version": {"$ref": "#/$defs/version"}, "declaration_sigil": {"$ref": "#/$defs/sigil"}}},
    "verifiedCapabilityTuple": {"type": "object", "additionalProperties": false, "required": ["backend_id", "backend_version", "backend_implementation_sigil", "assurance_profile_version", "assurance_profile_sigil", "conformance_suite_id", "conformance_suite_sigil", "backend_configuration_sigil", "verified_at", "evidence_sigils", "tuple_sigil"], "properties": {"backend_id": {"$ref": "#/$defs/opaque128"}, "backend_version": {"$ref": "#/$defs/version"}, "backend_implementation_sigil": {"$ref": "#/$defs/sigil"}, "assurance_profile_version": {"$ref": "#/$defs/version"}, "assurance_profile_sigil": {"$ref": "#/$defs/sigil"}, "conformance_suite_id": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/conformanceSuiteId"}, "conformance_suite_sigil": {"$ref": "#/$defs/sigil"}, "backend_configuration_sigil": {"$ref": "#/$defs/sigil"}, "verified_at": {"$ref": "#/$defs/timestamp"}, "evidence_sigils": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sigil"}}, "tuple_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

