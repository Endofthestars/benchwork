{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://benchwork.dev/schemas/patch-promotion-outcome-response/1.0","type":"object","additionalProperties":false,"required":["schema_version","kind","record_id","record_sigil","receipt","response_sigil"],"properties":{"schema_version":{"const":"patch-promotion-outcome-response/1.0"},"kind":{"enum":["PROMOTION_OUTCOME","RECOVERY_RECORD"]},"record_id":{"type":"string"},"record_sigil":{"$ref":"#/$defs/sigil"},"receipt":{"$ref":"https://benchwork.dev/schemas/patch-promotion-recovery-attempt/1.0#/$defs/receipt"},"response_sigil":{"$ref":"#/$defs/sigil"}},"allOf":[{"if":{"properties":{"kind":{"const":"PROMOTION_OUTCOME"}}},"then":{"properties":{"record_id":{"$ref":"#/$defs/po"}}}},{"if":{"properties":{"kind":{"const":"RECOVERY_RECORD"}}},"then":{"properties":{"record_id":{"$ref":"#/$defs/prr"}}}}],"$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"po":{"type":"string","pattern":"^PO-[A-Za-z0-9][A-Za-z0-9._-]*$","minLength":4,"maxLength":128},"prr":{"type":"string","pattern":"^PRR-[A-Za-z0-9][A-Za-z0-9._-]*$","minLength":5,"maxLength":128}}}

