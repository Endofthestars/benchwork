{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://benchwork.dev/schemas/artifact-materialization/1.0",
  "title":"Artifact Materialization v1",
  "description":"Closed RFC-0013 artifact-materialization/1.0 wire contract. Local validation only; referenced records, state history, capacity, and runtime effects are not resolved.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","materialization_id","source_blob_sigil","source_replica_id","source_verification_sigil","destination_class","destination_sigil","task_id","attempt_id","access_mode","bounds","reservation","destination_staging_object","commit_intent","residual_staging_cleanup","state","verification","cleanup","created_at","terminal_at","revision","record_sigil"],
  "properties":{
    "schema_version":{"const":"artifact-materialization/1.0"},"materialization_id":{"$ref":"#/$defs/materializationId"},"source_blob_sigil":{"$ref":"#/$defs/sigil"},"source_replica_id":{"$ref":"#/$defs/replicaId"},"source_verification_sigil":{"$ref":"#/$defs/sigil"},"destination_class":{"enum":["SANCTUM_INPUT","CRUCIBLE_WORKSPACE","PROJECT_EXPORT"]},"destination_sigil":{"$ref":"#/$defs/sigil"},"task_id":{"anyOf":[{"$ref":"#/$defs/opaque"},{"type":"null"}]},"attempt_id":{"anyOf":[{"$ref":"#/$defs/opaque"},{"type":"null"}]},"access_mode":{"enum":["READ_ONLY","COPY_ON_WRITE","WRITABLE_COPY"]},"bounds":{"$ref":"#/$defs/transferBounds"},"reservation":{"$ref":"#/$defs/reservationRef"},"destination_staging_object":{"anyOf":[{"$ref":"#/$defs/backendObjectRef"},{"type":"null"}]},"commit_intent":{"anyOf":[{"$ref":"#/$defs/materializationCommitIntent"},{"type":"null"}]},"residual_staging_cleanup":{"$ref":"#/$defs/residualStagingCleanup"},"state":{"enum":["PREPARED","STREAMING","VERIFYING","COMMITTING","AVAILABLE","CLEANING","CLEANED","CLEANUP_FAILED","FAILED","QUARANTINED"]},"verification":{"anyOf":[{"$ref":"#/$defs/verificationRef"},{"type":"null"}]},"cleanup":{"$ref":"#/$defs/cleanupResult"},"created_at":{"$ref":"#/$defs/timestamp"},"terminal_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"revision":{"$ref":"#/$defs/positiveU63"},"record_sigil":{"$ref":"#/$defs/sigil"}
  },
  "$defs":{
    "sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"u63":{"type":"integer","minimum":0,"maximum":9223372036854775807},"positiveU63":{"type":"integer","minimum":1,"maximum":9223372036854775807},"u64":{"type":"integer","minimum":0,"maximum":18446744073709551615},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"opaque":{"type":"string","pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","minLength":1,"maxLength":256},"materializationId":{"type":"string","pattern":"^SM-[A-Za-z0-9][A-Za-z0-9._:-]*$","minLength":4,"maxLength":128},"replicaId":{"type":"string","pattern":"^SR-[A-Za-z0-9][A-Za-z0-9._:-]*$","minLength":4,"maxLength":128},
    "blobRef":{"type":"object","additionalProperties":false,"required":["blob_sigil","size_bytes"],"properties":{"blob_sigil":{"$ref":"#/$defs/sigil"},"size_bytes":{"$ref":"#/$defs/u63"}}},
    "transferBounds":{"type":"object","additionalProperties":false,"required":["max_bytes","max_duration_millis","max_file_count","max_chunk_count","buffer_bytes"],"properties":{"max_bytes":{"$ref":"#/$defs/u63"},"max_duration_millis":{"$ref":"#/$defs/u63"},"max_file_count":{"anyOf":[{"$ref":"#/$defs/u63"},{"type":"null"}]},"max_chunk_count":{"$ref":"#/$defs/u63"},"buffer_bytes":{"$ref":"#/$defs/positiveU63"}}},
    "quotaClaim":{"type":"object","additionalProperties":false,"required":["quota_class","byte_count","object_count","inode_count","stream_count","journal_bytes","control_record_bytes"],"properties":{"quota_class":{"enum":["JOURNAL","CONTROL_RECORD","STAGING","QUARANTINE","COMMITTED","MATERIALIZATION","STREAM","INODE"]},"byte_count":{"$ref":"#/$defs/u63"},"object_count":{"$ref":"#/$defs/u63"},"inode_count":{"$ref":"#/$defs/u63"},"stream_count":{"$ref":"#/$defs/u63"},"journal_bytes":{"$ref":"#/$defs/u63"},"control_record_bytes":{"$ref":"#/$defs/u63"}}},
    "capacityPlan":{"type":"object","additionalProperties":false,"required":["allowed_event_types","max_event_frame_count","max_control_record_count","max_recovery_evidence_count","max_event_frame_bytes","max_control_record_bytes","max_recovery_evidence_bytes"],"properties":{"allowed_event_types":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)+$"}},"max_event_frame_count":{"$ref":"#/$defs/positiveU63"},"max_control_record_count":{"$ref":"#/$defs/u63"},"max_recovery_evidence_count":{"$ref":"#/$defs/u63"},"max_event_frame_bytes":{"$ref":"#/$defs/positiveU63"},"max_control_record_bytes":{"$ref":"#/$defs/positiveU63"},"max_recovery_evidence_bytes":{"$ref":"#/$defs/positiveU63"}}},
    "clockRef":{"type":"object","additionalProperties":false,"required":["utc","monotonic_anchor_id","monotonic_ticks","monotonic_frequency_hz","uncertainty_micros","observation_sigil"],"properties":{"utc":{"$ref":"#/$defs/timestamp"},"monotonic_anchor_id":{"$ref":"#/$defs/opaque"},"monotonic_ticks":{"$ref":"#/$defs/u63"},"monotonic_frequency_hz":{"$ref":"#/$defs/positiveU63"},"uncertainty_micros":{"$ref":"#/$defs/u63"},"observation_sigil":{"$ref":"#/$defs/sigil"}}},
    "reservationRef":{"type":"object","additionalProperties":false,"required":["reservation_id","claims","capacity_plan","expires_at","created_clock","remaining_micros_at_creation"],"properties":{"reservation_id":{"$ref":"#/$defs/opaque"},"claims":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/quotaClaim"}},"capacity_plan":{"$ref":"#/$defs/capacityPlan"},"expires_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"created_clock":{"$ref":"#/$defs/clockRef"},"remaining_micros_at_creation":{"anyOf":[{"$ref":"#/$defs/u63"},{"type":"null"}]}}},
    "backendObjectRef":{"type":"object","additionalProperties":false,"required":["backend_id","object_identity_sigil","locator_sigil","generation","size_bytes","blob_sigil"],"properties":{"backend_id":{"$ref":"#/$defs/opaque"},"object_identity_sigil":{"$ref":"#/$defs/sigil"},"locator_sigil":{"$ref":"#/$defs/sigil"},"generation":{"$ref":"#/$defs/opaque"},"size_bytes":{"$ref":"#/$defs/u63"},"blob_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]}}},
    "fence":{"type":"object","additionalProperties":false,"required":["execution_journal_id","executor_epoch","job_id","attempt_id","lease_id","fencing_generation","execution_event_sigil","job_fence_floor","tombstone_present"],"properties":{"execution_journal_id":{"$ref":"#/$defs/opaque"},"executor_epoch":{"$ref":"#/$defs/u64"},"job_id":{"$ref":"#/$defs/opaque"},"attempt_id":{"$ref":"#/$defs/opaque"},"lease_id":{"$ref":"#/$defs/opaque"},"fencing_generation":{"$ref":"#/$defs/u64"},"execution_event_sigil":{"$ref":"#/$defs/sigil"},"job_fence_floor":{"$ref":"#/$defs/u64"},"tombstone_present":{"type":"boolean"}}},
    "materializationCommitIntent":{"type":"object","additionalProperties":false,"required":["intent_id","staging_object","destination_object","expected_blob","destination_identity_sigil","execution_fence","reservation","recorded_clock"],"properties":{"intent_id":{"$ref":"#/$defs/opaque"},"staging_object":{"$ref":"#/$defs/backendObjectRef"},"destination_object":{"$ref":"#/$defs/backendObjectRef"},"expected_blob":{"$ref":"#/$defs/blobRef"},"destination_identity_sigil":{"$ref":"#/$defs/sigil"},"execution_fence":{"anyOf":[{"$ref":"#/$defs/fence"},{"type":"null"}]},"reservation":{"$ref":"#/$defs/reservationRef"},"recorded_clock":{"$ref":"#/$defs/clockRef"}}},
    "reason":{"type":"object","additionalProperties":false,"required":["code","evidence_sigils"],"properties":{"code":{"enum":["AUTHORIZATION_DENIED","BACKEND_AMBIGUOUS","BACKEND_CONFLICT","BACKEND_UNAVAILABLE","BOUNDS_EXCEEDED","CANCELLED","CHRONICLE_REFERENCE_CHANGED","CLOCK_UNCERTAIN","CONFLICT","CORRUPT","DESTINATION_CONFLICT","DISPOSITION_EXPIRED","DURABILITY_UNVERIFIED","EXECUTION_HOLD_LIFETIME_EXPIRED","EXECUTION_ROOT_ORPHAN_ABORTED","EXECUTION_ROOT_OWNER_TERMINATED","FENCE_REJECTED","GC_ROOT_CHANGED","GENERATION_MISMATCH","HASH_MISMATCH","INTEGRITY_FAILURE","INVALID_MESSAGE","LEASE_EXPIRED","LEGACY_PROTECTION_FAILED","MINIMUM_REPLICA_VIOLATION","OPERATIONAL_ROOT_TERMINATED","PAYLOAD_LOST","POLICY_REJECTED","QUARANTINE_RESERVATION_FAILED","QUOTA_EXHAUSTED","RECOVERY_INTERRUPTED_PRECOMMIT","RECOVERY_PAYLOAD_LOST","RETENTION_BLOCKED","SOURCE_CHANGED","TAIL_INCOMPLETE","TIMEOUT","UNKNOWN_SCHEMA","UNSAFE_PATH","VERIFICATION_FAILED"]},"evidence_sigils":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/sigil"}}}},
    "residualStagingCleanup":{"type":"object","additionalProperties":false,"required":["state","staging_object","evidence_sigil","reason"],"properties":{"state":{"enum":["NOT_REQUIRED","PENDING","CLEANED","FAILED","HELD_FOR_DISPOSITION"]},"staging_object":{"anyOf":[{"$ref":"#/$defs/backendObjectRef"},{"type":"null"}]},"evidence_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"reason":{"anyOf":[{"$ref":"#/$defs/reason"},{"type":"null"}]}}},
    "cleanupResult":{"type":"object","additionalProperties":false,"required":["state","evidence_sigil","reason"],"properties":{"state":{"enum":["NOT_REQUIRED","PENDING","CLEANED","FAILED"]},"evidence_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"reason":{"anyOf":[{"$ref":"#/$defs/reason"},{"type":"null"}]}}},
    "verificationRef":{"type":"object","additionalProperties":false,"required":["method","evidence_sigil","verified_at","next_due_at"],"properties":{"method":{"enum":["FULL_READBACK_SHA256","CONFORMANCE_END_TO_END"]},"evidence_sigil":{"$ref":"#/$defs/sigil"},"verified_at":{"$ref":"#/$defs/timestamp"},"next_due_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}}}
  }
}
