{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/benchwork-skill-metadata/1.0",
  "title": "Benchwork Skill Compatibility Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "skills_api", "requires"],
  "properties": {
    "schema_version": {"const": "benchwork-skill-metadata/1.0"},
    "name": {
      "type": "string",
      "pattern": "^benchwork-[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "skills_api": {"const": "1"},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp"],
      "properties": {
        "mcp": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^benchwork_[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
