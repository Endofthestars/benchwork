{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-provenance-policy/1.0",
  "title": "Artifact Provenance Policy v1",
  "description": "Closed RFC-0013 project-scoped managed INGEST/COPY provenance-admission policy. Registration, State resolution, and Transfer admission are semantic/runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance_policy_id", "policy_version", "scope", "allowed_directions", "allowed_purposes", "allowed_source_kinds", "allowed_destination_kinds", "allowed_relations", "execution_requirement", "allowed_verification_methods", "minimum_verification_evidence", "transformation_mode", "required_retention_policy_ids", "authorization_sigil", "registered_at", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-provenance-policy/1.0"},
    "provenance_policy_id": {"$ref": "#/$defs/provenancePolicyId"},
    "policy_version": {"const": "1.0"},
    "scope": {"$ref": "#/$defs/projectScope"},
    "allowed_directions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["INGEST", "COPY"]}},
    "allowed_purposes": {"type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/transferPurpose"}},
    "allowed_source_kinds": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceKind"}},
    "allowed_destination_kinds": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "MANAGED_BACKEND"}},
    "allowed_relations": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/transferProvenanceRelation"}},
    "execution_requirement": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]},
    "allowed_verification_methods": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["FULL_READBACK_SHA256", "CONFORMANCE_END_TO_END"]}},
    "minimum_verification_evidence": {"type": "integer", "minimum": 1, "maximum": 4096},
    "transformation_mode": {"enum": ["NONE_ONLY", "DERIVED_ALLOWED"]},
    "required_retention_policy_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/policyId"}},
    "authorization_sigil": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/sigil"},
    "registered_at": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/timestamp"},
    "record_sigil": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/sigil"}
  },
  "$defs": {
    "provenancePolicyId": {"type": "string", "pattern": "^SPP-[A-Za-z0-9._:-]{1,124}$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "projectScope": {"type": "object", "additionalProperties": false, "required": ["kind", "project_id"], "properties": {"kind": {"const": "PROJECT"}, "project_id": {"$ref": "https://benchwork.dev/schemas/artifact-retention-policy/1.0#/$defs/opaque"}}},
    "transferPurpose": {"enum": ["ARTIFACT_IMPORT", "ATTEMPT_OUTPUT", "LEGACY_V1_PROTECTION", "REPLICA_COPY", "REPLICA_REPAIR", "SANCTUM_INPUT", "PATCH_BUNDLE", "USER_EXPORT", "QUARANTINE_REINSPECTION"]},
    "sourceKind": {"enum": ["LOCAL_FILE", "REPLICA", "ATTEMPT_OUTPUT", "EXTERNAL", "STAGING", "LEGACY_ARTIFACT"]},
    "transferProvenanceRelation": {"enum": ["CAPTURED", "IMPORTED", "COPIED", "DERIVED"]}
  }
}

