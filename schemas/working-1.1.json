{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/working/1.1",
  "title": "Rite Working",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "working_id", "rite_id", "rite_sigil", "rite", "program_id", "protocol_id", "stage", "status", "history"],
  "properties": {
    "schema_version": {"const": "working/1.1"},
    "working_id": {"type": "string", "pattern": "^WK-"},
    "rite_id": {"type": "string", "pattern": "@"},
    "rite_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
    "rite": {"$ref": "https://benchwork.dev/schemas/rite-definition/1.1"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "protocol_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/protocol_id"},
    "stage": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "status": {"enum": ["ACTIVE", "COMPLETED"]},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "at", "reason", "canonical_event_id", "object_id"],
        "properties": {
          "stage": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1},
          "canonical_event_id": {"type": "string", "pattern": "^CE-"},
          "object_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
