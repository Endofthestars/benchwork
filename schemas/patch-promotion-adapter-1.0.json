{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-adapter/1.0",
  "title": "Patch Promotion Adapter v1",
  "description": "Closed RFC-0014 patch-promotion-adapter/1.0 contract-only record. Validation does not assert an adapter's actual Host, filesystem, clock, guard, or recovery capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "mode", "platform_profile", "deadline_policy", "guard_backend", "mutation_semantics", "recovery_semantics", "disabled_behaviors", "limits", "configuration_sigil", "adapter_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-adapter/1.0"},
    "adapter_id": {"$ref": "#/$defs/ppa"}, "adapter_version": {"$ref": "#/$defs/text64"}, "mode": {"enum": ["FULL_TREE_ATOMIC_CAS", "PER_ENTRY_GENERATIONAL_CAS"]},
    "platform_profile": {"$ref": "#/$defs/platform"}, "deadline_policy": {"$ref": "#/$defs/deadline"}, "guard_backend": {"$ref": "#/$defs/guard"}, "mutation_semantics": {"$ref": "#/$defs/mutation"}, "recovery_semantics": {"$ref": "#/$defs/recovery"},
    "disabled_behaviors": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/text128"}}, "limits": {"$ref": "#/$defs/limits"}, "configuration_sigil": {"$ref": "#/$defs/sigil"}, "adapter_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}, "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text64": {"type": "string", "minLength": 0, "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text128": {"type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "ppa": {"type": "string", "pattern": "^PPA-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "platform": {"type": "object", "additionalProperties": false, "required": ["os_family", "filesystem_sigil", "path_profile_sigil", "atomic_replace_scope", "conformance_suite_sigil"], "properties": {"os_family": {"enum": ["POSIX", "WINDOWS"]}, "filesystem_sigil": {"$ref": "#/$defs/sigil"}, "path_profile_sigil": {"$ref": "#/$defs/sigil"}, "atomic_replace_scope": {"enum": ["FULL_TREE", "PER_ENTRY"]}, "conformance_suite_sigil": {"$ref": "#/$defs/sigil"}}},
    "deadline": {"type": "object", "additionalProperties": false, "required": ["preview_lifetime_seconds", "guard_lifetime_seconds", "guard_renewal_interval_seconds", "clock_uncertainty_tolerance_seconds", "trusted_utc_source_profile_sigil", "monotonic_source_profile_sigil", "suspend_policy"], "properties": {"preview_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "guard_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "guard_renewal_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}, "clock_uncertainty_tolerance_seconds": {"type": "integer", "minimum": 0, "maximum": 300}, "trusted_utc_source_profile_sigil": {"$ref": "#/$defs/sigil"}, "monotonic_source_profile_sigil": {"$ref": "#/$defs/sigil"}, "suspend_policy": {"enum": ["FENCE_ON_UNPROVABLE", "COUNT_TRUSTED_SUSPEND"]}}},
    "guard": {"type": "object", "additionalProperties": false, "required": ["backend_id", "profile_sigil", "cas_semantics", "readback_semantics", "durable_tombstones", "durable_fence_floor", "generation_successor_profile_sigil", "max_active_guards"], "properties": {"backend_id": {"$ref": "#/$defs/text128"}, "profile_sigil": {"$ref": "#/$defs/sigil"}, "cas_semantics": {"const": "EXACT_GENERATION"}, "readback_semantics": {"const": "LINEARIZABLE"}, "durable_tombstones": {"const": true}, "durable_fence_floor": {"const": true}, "generation_successor_profile_sigil": {"$ref": "#/$defs/sigil"}, "max_active_guards": {"type": "integer", "minimum": 1, "maximum": 4096}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["descriptor_relative_nofollow", "preimage_compare_and_swap", "topology_compare_and_swap", "mode", "atomicity", "per_step_receipts"], "properties": {"descriptor_relative_nofollow": {"const": true}, "preimage_compare_and_swap": {"const": true}, "topology_compare_and_swap": {"const": true}, "mode": {"enum": ["FULL_TREE_ATOMIC_CAS", "PER_ENTRY_GENERATIONAL_CAS"]}, "atomicity": {"enum": ["FULL_TREE", "TARGET_WIDE_GENERATION"]}, "per_step_receipts": {"type": "boolean"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["actions", "checkpoint_required", "verifier_readback_required", "partial_fence_required"], "properties": {"actions": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["RESTORE_BASE", "ACCEPT_POSTIMAGE", "ABANDON"]}}, "checkpoint_required": {"const": true}, "verifier_readback_required": {"const": true}, "partial_fence_required": {"const": true}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_paths", "max_total_bytes", "max_operation_bytes", "max_backend_retries", "max_active_guards"], "properties": {"max_paths": {"type": "integer", "minimum": 1, "maximum": 100000}, "max_total_bytes": {"$ref": "#/$defs/u63"}, "max_operation_bytes": {"$ref": "#/$defs/u63"}, "max_backend_retries": {"type": "integer", "minimum": 0, "maximum": 64}, "max_active_guards": {"type": "integer", "minimum": 1, "maximum": 4096}}}
  }
}

