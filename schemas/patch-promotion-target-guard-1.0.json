{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-target-guard/1.0",
  "title": "Patch Promotion Target Guard v1",
  "description": "Closed RFC-0014 patch-promotion-target-guard/1.0 contract-only record. Validation does not reconstruct a Journal prefix or assert physical guard ownership.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "guard_id", "target_id", "owner_kind", "owner_attempt_id", "coordinator_id", "coordinator_epoch", "state", "backend_generation", "fencing_generation", "fence_floor", "target_content_generation", "deadline_policy_sigil", "clock_anchor_evidence_sigil", "original_remaining_ns", "acquired_at", "expires_at", "recovery_of_guard_id", "revision", "guard_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-target-guard/1.0"}, "guard_id": {"$ref": "#/$defs/pg"}, "target_id": {"$ref": "#/$defs/pt"}, "owner_kind": {"enum": ["PROMOTION", "RECOVERY"]}, "owner_attempt_id": {"$ref": "#/$defs/text128"}, "coordinator_id": {"$ref": "#/$defs/pc"}, "coordinator_epoch": {"$ref": "#/$defs/u64"}, "state": {"enum": ["NONE", "ACQUIRING", "HELD", "RENEWING", "RELEASING", "FENCING", "RECOVERING", "RELEASED", "FENCED", "FAILED"]},
    "backend_generation": {"anyOf": [{"$ref": "#/$defs/text256"}, {"type": "null"}]}, "fencing_generation": {"$ref": "#/$defs/u64"}, "fence_floor": {"$ref": "#/$defs/u64"}, "target_content_generation": {"$ref": "#/$defs/text256"}, "deadline_policy_sigil": {"$ref": "#/$defs/sigil"}, "clock_anchor_evidence_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "original_remaining_ns": {"anyOf": [{"$ref": "#/$defs/u64"}, {"type": "null"}]}, "acquired_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "expires_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "recovery_of_guard_id": {"anyOf": [{"$ref": "#/$defs/pg"}, {"type": "null"}]}, "revision": {"$ref": "#/$defs/u64"}, "guard_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}, "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text128": {"type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text256": {"type": "string", "minLength": 0, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "pg": {"type": "string", "pattern": "^PG-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pt": {"type": "string", "pattern": "^PT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pc": {"type": "string", "pattern": "^PC-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}
  }
}

