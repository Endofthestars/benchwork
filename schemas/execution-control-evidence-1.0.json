{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-control-evidence/1.0",
  "title": "Execution Control Evidence v1",
  "description": "Closed RFC-0012 Control Evidence wire contract. Local validation establishes shape, ordering, binding identity, and deficiency consistency only; it does not execute evidence predicates, resolve external records, establish assurance, or grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "control_evidence_id", "job_id", "attempt_id", "control_dimension", "required_state", "realized_state", "phase_evidence", "bindings", "deficiencies", "control_evidence_sigil"],
  "properties": {
    "schema_version": {"const": "execution-control-evidence/1.0"},
    "control_evidence_id": {"$ref": "#/$defs/controlEvidenceId"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "control_dimension": {"$ref": "#/$defs/controlDimension"},
    "required_state": {"$ref": "#/$defs/requiredState"},
    "realized_state": {"$ref": "#/$defs/realizedState"},
    "phase_evidence": {"$ref": "#/$defs/phaseEvidence"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "deficiencies": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/deficiency"}},
    "control_evidence_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "controlEvidenceId": {"type": "string", "pattern": "^CVE-[0-7][0-9A-HJKMNP-TV-Z]{25}$", "minLength": 30, "maxLength": 30},
    "evidenceIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "minLength": 1, "maxLength": 128},
    "controlDimension": {"enum": ["IDENTITY_AUTHORIZATION", "FILESYSTEM", "NETWORK", "PROCESS_EXECUTABLE", "RESOURCE", "ENVIRONMENT_CREDENTIAL", "LOG_OUTPUT_CAPTURE", "RUNTIME_INPUT_OUTPUT_IDENTITY", "CANCELLATION_FENCING", "TERMINATION_CLEANUP"]},
    "requiredState": {"enum": ["ENFORCED", "VERIFIED", "OBSERVED", "ANY_RECORDED"]},
    "realizedState": {"enum": ["ENFORCED", "VERIFIED", "OBSERVED", "UNAVAILABLE"]},
    "phase": {"enum": ["PREFLIGHT", "RUNTIME", "TERMINATION", "CLEANUP"]},
    "evidenceKind": {"enum": ["TASK_BINDING", "CAPABILITY_BINDING", "SNAPSHOT_BINDING", "WARD_DECISION", "APPROVAL_RECEIPT", "BACKEND_CONFIGURATION", "HOST_IDENTITY", "POLICY_RESOLUTION", "BASE_IDENTITY", "INPUT_IDENTITY", "MATERIALIZATION_IDENTITY", "ENVIRONMENT_CONSTRUCTION", "FILESYSTEM_POLICY", "NETWORK_POLICY", "EXECUTABLE_SELECTION", "PROCESS_TREE", "WALL_TIME_ENFORCEMENT", "RESOURCE_ACCOUNTING", "CREDENTIAL_NONINHERITANCE", "LOG_CAPTURE", "OUTPUT_VALIDATION", "STORAGE_OBSERVATION", "FENCE_TOMBSTONE", "TERMINATION", "HANDLE_REVOCATION", "CLEANUP", "QUARANTINE", "TERMINAL_SOURCE_VERIFICATION", "CONFORMANCE_FIXTURE"]},
    "deficiency_reason_code": {"enum": ["COMPLETION_ESTABLISHED", "CANCEL_REQUESTED", "JOB_DEADLINE", "ATTEMPT_DEADLINE", "HEARTBEAT_TIMEOUT", "LEASE_CLAIM_EXPIRED", "LEASE_ACTIVE_EXPIRED", "LEASE_REVOKED", "RECOVERY_FENCE", "CLOCK_UNCERTAIN", "EXECUTOR_EPOCH_CHANGED", "SESSION_CHANNEL_LOST", "POLICY_VIOLATION", "ADMISSION_INVALID", "PREFLIGHT_REJECTED", "START_FAILED", "COMPUTATION_FAILED", "VALIDATION_FAILED", "RESULT_CONFLICT", "RESULT_REQUIREMENT_FAILED", "OUTPUT_VALIDATION_FAILED", "TERMINAL_SOURCE_RETENTION_FAILED", "TERMINATION_FAILED", "CLEANUP_FAILED", "LOST_OWNERSHIP", "ASSURANCE_UNMET", "ASSURANCE_UNVERIFIABLE", "BUDGET_EXHAUSTED", "RETRY_EXHAUSTED", "ATTEMPT_NONRETRYABLE", "ATTEMPT_REJECTED", "FATAL_INFRASTRUCTURE", "INTEGRITY_FAILURE", "ADMIN_DRAIN", "ADMIN_RETIRE", "DEFINITION_SUPERSEDED", "CAPABILITY_REVOKED", "VERIFICATION_FAILED", "CONTROL_CHANNEL_LOST", "WORKER_SHUTDOWN", "BACKEND_CLOSE_FAILED", "MALFORMED_MESSAGE", "UNKNOWN_SCHEMA", "INVALID_SIGIL", "WRONG_ENTITY", "WRONG_SESSION", "WRONG_EPOCH", "STALE_REVISION", "CONFLICTING_DUPLICATE", "SEQUENCE_GAP", "STATE_INELIGIBLE", "CREDENTIAL_INVALID", "LEASE_NOT_CURRENT", "FENCE_STALE", "DEADLINE_ALREADY_DUE", "MESSAGE_TOO_LARGE", "LIMIT_EXCEEDED", "RESULT_SCHEMA_INVALID", "OUTPUT_SCHEMA_INVALID", "EVIDENCE_MISSING", "EVIDENCE_INVALID", "PROFILE_MISMATCH", "CONFORMANCE_SUITE_MISMATCH", "CLAIM_INVALID", "ACCOUNTING_PARTIAL", "ACCOUNTING_UNAVAILABLE", "RESOURCE_AMBIGUOUS", "NO_ATTEMPT_ALLOCATED"]},
    "eventRef": {"type": "object", "additionalProperties": false, "required": ["journal_id", "event_id", "sequence", "event_sigil"], "properties": {"journal_id": {"type": "string", "pattern": "^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "event_id": {"type": "string", "pattern": "^SE-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "event_sigil": {"$ref": "#/$defs/sigil"}}},
    "transferRef": {"type": "object", "additionalProperties": false, "required": ["transfer_id", "transfer_attempt_id", "request_record_sigil", "attempt_record_sigil", "terminal_event"], "properties": {"transfer_id": {"type": "string", "pattern": "^ST-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "transfer_attempt_id": {"type": "string", "pattern": "^SA-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128}, "request_record_sigil": {"$ref": "#/$defs/sigil"}, "attempt_record_sigil": {"$ref": "#/$defs/sigil"}, "terminal_event": {"$ref": "#/$defs/eventRef"}}},
    "stagingReference": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "storage_subject_id", "transfer", "provenance_id", "provenance_sigil"], "properties": {"kind": {"const": "TRANSFER"}, "storage_subject_id": {"$ref": "#/$defs/sigil"}, "transfer": {"$ref": "#/$defs/transferRef"}, "provenance_id": {"$ref": "#/$defs/opaque"}, "provenance_sigil": {"$ref": "#/$defs/sigil"}}}]},
    "phaseEvidenceEntry": {"type": "object", "additionalProperties": false, "required": ["evidence_kind", "producer_identity", "verifier_identity", "collected_at", "byte_size", "blob_sigil", "staging_reference"], "properties": {"evidence_kind": {"$ref": "#/$defs/evidenceKind"}, "producer_identity": {"$ref": "#/$defs/evidenceIdentity"}, "verifier_identity": {"$ref": "#/$defs/evidenceIdentity"}, "collected_at": {"$ref": "#/$defs/timestamp"}, "byte_size": {"anyOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]}, "blob_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}, "staging_reference": {"$ref": "#/$defs/stagingReference"}}},
    "phaseEvidence": {"type": "object", "additionalProperties": false, "required": ["preflight", "runtime", "termination", "cleanup"], "properties": {"preflight": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/phaseEvidenceEntry"}}, "runtime": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/phaseEvidenceEntry"}}, "termination": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/phaseEvidenceEntry"}}, "cleanup": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/phaseEvidenceEntry"}}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["backend_sigil", "host_sigil", "runtime_sigil", "policy_set_sigil", "input_set_sigil", "output_set_sigil"], "properties": {"backend_sigil": {"$ref": "#/$defs/sigil"}, "host_sigil": {"$ref": "#/$defs/sigil"}, "runtime_sigil": {"$ref": "#/$defs/sigil"}, "policy_set_sigil": {"$ref": "#/$defs/sigil"}, "input_set_sigil": {"$ref": "#/$defs/sigil"}, "output_set_sigil": {"$ref": "#/$defs/sigil"}}},
    "deficiency": {"type": "object", "additionalProperties": false, "required": ["reason_code", "phase", "evidence_kind", "detail_sigil"], "properties": {"reason_code": {"$ref": "#/$defs/deficiency_reason_code"}, "phase": {"$ref": "#/$defs/phase"}, "evidence_kind": {"$ref": "#/$defs/evidenceKind"}, "detail_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

