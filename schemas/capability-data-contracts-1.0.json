{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/capability-data-contracts/1.0",
  "title": "Capability-specific Proposal Data Contracts",
  "$defs": {
    "research_orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workstreams", "dependencies", "gates", "open_issues"],
      "properties": {
        "workstreams": {"$ref": "#/$defs/non_empty_strings"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "gates": {"$ref": "#/$defs/non_empty_strings"},
        "open_issues": {"$ref": "#/$defs/strings"}
      }
    },
    "evidence_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "sources", "screened_count", "candidate_evidence", "unresolved_queries", "limitations"],
      "properties": {
        "queries": {"$ref": "#/$defs/non_empty_strings"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "screened_count": {"type": "integer", "minimum": 0},
        "candidate_evidence": {"type": "array", "items": {"$ref": "#/$defs/candidate_evidence"}},
        "unresolved_queries": {"$ref": "#/$defs/strings"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "evidence_synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "synthesis", "contradictions", "uncertainties", "limitations"],
      "properties": {
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-"}},
        "synthesis": {"type": "string", "minLength": 1},
        "contradictions": {"$ref": "#/$defs/strings"},
        "uncertainties": {"$ref": "#/$defs/strings"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "evidence_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_resolved", "content_inspected", "verification_notes", "limitations"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EV-"},
        "source_resolved": {"type": "boolean"},
        "content_inspected": {"type": "boolean"},
        "verification_notes": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "hypothesis_framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypotheses", "assumptions", "open_questions"],
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "falsification_criteria", "evidence_ids"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "falsification_criteria": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-"}}
            }
          }
        },
        "assumptions": {"$ref": "#/$defs/strings"},
        "open_questions": {"$ref": "#/$defs/strings"}
      }
    },
    "hypothesis_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "challenges", "counterevidence", "validity_threats", "recommendation"],
      "properties": {
        "hypothesis_id": {"type": "string", "pattern": "^HY-"},
        "challenges": {"$ref": "#/$defs/non_empty_strings"},
        "counterevidence": {"$ref": "#/$defs/strings"},
        "validity_threats": {"$ref": "#/$defs/non_empty_strings"},
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "study_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_proposal", "hypotheses", "estimand", "validity_threats", "open_issues"],
      "properties": {
        "protocol_proposal": {"type": "object", "minProperties": 1},
        "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "estimand": {"type": "string", "minLength": 1},
        "validity_threats": {"$ref": "#/$defs/non_empty_strings"},
        "open_issues": {"$ref": "#/$defs/strings"}
      }
    },
    "study_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "findings", "validity_threats", "open_issues", "recommendation"],
      "properties": {
        "protocol_id": {"type": "string", "pattern": "^PT-"},
        "findings": {"$ref": "#/$defs/non_empty_strings"},
        "validity_threats": {"$ref": "#/$defs/strings"},
        "open_issues": {"$ref": "#/$defs/strings"},
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "code_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected_files", "findings", "tests_considered", "residual_risks"],
      "properties": {
        "inspected_files": {"$ref": "#/$defs/non_empty_strings"},
        "findings": {"$ref": "#/$defs/strings"},
        "tests_considered": {"$ref": "#/$defs/strings"},
        "residual_risks": {"$ref": "#/$defs/strings"}
      }
    },
    "code_modification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "changed_files", "tests_run", "validation", "residual_risks"],
      "properties": {
        "patch": {"type": "string", "minLength": 1},
        "changed_files": {"$ref": "#/$defs/non_empty_strings"},
        "tests_run": {"$ref": "#/$defs/non_empty_strings"},
        "validation": {"type": "string", "minLength": 1},
        "residual_risks": {"$ref": "#/$defs/strings"}
      }
    },
    "experiment_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_proposal", "run_matrix", "controls", "failure_criteria", "risks"],
      "properties": {
        "experiment_proposal": {"type": "object", "minProperties": 1},
        "run_matrix": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}},
        "controls": {"$ref": "#/$defs/non_empty_strings"},
        "failure_criteria": {"$ref": "#/$defs/non_empty_strings"},
        "risks": {"$ref": "#/$defs/strings"}
      }
    },
    "experiment_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "commands", "run_ids", "status", "failures"],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^EX-"},
        "commands": {"$ref": "#/$defs/non_empty_strings"},
        "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED"]},
        "failures": {"$ref": "#/$defs/strings"}
      }
    },
    "experiment_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_ids", "artifacts", "missing_outputs", "quality_checks", "limitations"],
      "properties": {
        "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "missing_outputs": {"$ref": "#/$defs/strings"},
        "quality_checks": {"$ref": "#/$defs/non_empty_strings"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "analysis_computation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_bundle", "included_run_ids", "excluded_runs", "method", "warnings"],
      "properties": {
        "result_bundle": {"type": "object", "minProperties": 1},
        "included_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
        "excluded_runs": {"type": "array", "items": {"type": "object", "minProperties": 1}},
        "method": {"type": "string", "minLength": 1},
        "warnings": {"$ref": "#/$defs/strings"}
      }
    },
    "analysis_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "findings", "uncertainty", "practical_significance", "limitations"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^RB-"},
        "findings": {"$ref": "#/$defs/non_empty_strings"},
        "uncertainty": {"$ref": "#/$defs/non_empty_strings"},
        "practical_significance": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "decision_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_ids", "competing_interpretations", "unresolved_issues", "recommendation"],
      "properties": {
        "assessment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AS-"}},
        "competing_interpretations": {"$ref": "#/$defs/strings"},
        "unresolved_issues": {"$ref": "#/$defs/strings"},
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "decision_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "rationale", "assessment_ids", "required_actions", "uncertainties"],
      "properties": {
        "outcome": {"enum": ["CONTINUE", "REPAIR", "PIVOT", "STOP", "INSUFFICIENT_EVIDENCE", "REVIEW_REQUIRED"]},
        "rationale": {"type": "string", "minLength": 1},
        "assessment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AS-"}},
        "required_actions": {"$ref": "#/$defs/strings"},
        "uncertainties": {"$ref": "#/$defs/strings"}
      }
    },
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "title"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "candidate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_uri", "claim", "relevance", "uncertainty"],
      "properties": {
        "source_uri": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "relevance": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sigil"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sigil": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
