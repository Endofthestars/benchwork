{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/hypothesis/1.0",
  "title": "Research Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "program_id", "claim_ids", "statement", "prediction", "status"],
  "properties": {
    "schema_version": {"const": "hypothesis/1.0"},
    "hypothesis_id": {"type": "string", "pattern": "^HY-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CL-"}
    },
    "statement": {"type": "string", "minLength": 1},
    "prediction": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACTIVE", "SUPPORTED", "NOT_SUPPORTED", "INCONCLUSIVE", "REJECTED"]}
  }
}
