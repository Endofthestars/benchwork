{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/agent-contract/1.0",
  "title": "Agent Task Capsule and Result",
  "oneOf": [
    {"$ref": "#/$defs/task_capsule"},
    {"$ref": "#/$defs/agent_result"}
  ],
  "$defs": {
    "task_capsule": {
      "type": "object",
      "required": ["schema_version", "task_id", "host", "capability", "input_sigil", "circle", "capsule_sigil"],
      "properties": {
        "schema_version": {"const": "task-capsule/1.0"},
        "task_id": {"type": "string", "pattern": "^TK-"},
        "host": {"enum": ["cli", "codex", "claude-code"]},
        "capability": {"type": "string", "pattern": "^bench\\."},
        "input_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
        "capsule_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
        "circle": {
          "type": "object",
          "required": ["tools", "time_budget_seconds", "network"],
          "properties": {
            "tools": {"type": "array", "items": {"type": "string"}},
            "time_budget_seconds": {"type": "integer", "minimum": 1},
            "network": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agent_result": {
      "type": "object",
      "required": ["schema_version", "task_id", "input_sigil", "artifacts", "status"],
      "properties": {
        "schema_version": {"const": "agent-result/1.0"},
        "task_id": {"type": "string", "pattern": "^TK-"},
        "input_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
        "artifacts": {"type": "array", "items": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/artifact_ref"}},
        "status": {"enum": ["COMPLETED", "FAILED", "CANCELLED"]}
      },
      "additionalProperties": false
    }
  }
}
