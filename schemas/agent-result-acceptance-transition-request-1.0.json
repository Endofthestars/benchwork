  "properties":{
    "schema_version":{"const":"agent-result-acceptance-transition-request/1.0"},"transition_request_id":{"$ref":"#/$defs/transitionRequestId"},"event_type":{"const":"agent-result.accepted"},"expected_chronicle_head":{"$ref":"https://benchwork.dev/schemas/execution-job/1.0#/$defs/chronicleHeadRef"},"agent_result":{"$ref":"https://benchwork.dev/schemas/agent-result/2.0"},"job_outcome_binding":{"$ref":"https://benchwork.dev/schemas/agent-result-acceptance-authorization/1.0#/$defs/jobOutcomeBinding"},"acceptance_request_sigil":{"$ref":"#/$defs/sigil"},"idempotency_key_sigil":{"$ref":"#/$defs/sigil"},"reference_sets":{"type":"array","minItems":1,"maxItems":1,"uniqueItems":true,"items":{"$ref":"https://benchwork.dev/schemas/artifact-storage-reference-intent/1.0#/$defs/referenceSetRef"}},"managed_blob_sigils":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/sigil"}},"acceptance_storage_binding":{"$ref":"https://benchwork.dev/schemas/agent-result-acceptance-authorization/1.0#/$defs/acceptanceStorageBinding"},"actor":{"$ref":"https://benchwork.dev/schemas/execution-cancel-request/1.0#/$defs/actor_binding"},"host_invocation":{"$ref":"https://benchwork.dev/schemas/execution-cancel-request/1.0#/$defs/host_invocation_binding"},"chronicle_actor":{"$ref":"https://benchwork.dev/schemas/actor/1.0"},"acceptance_authorization":{"$ref":"https://benchwork.dev/schemas/agent-result-acceptance-authorization/1.0"},"authorization_sigil":{"$ref":"#/$defs/sigil"},"requested_at":{"$ref":"https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},"transition_request_sigil":{"$ref":"#/$defs/sigil"}
  },
  "$defs":{"sigil":{"$ref":"https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},"transitionRequestId":{"type":"string","pattern":"^ATR-[A-F0-9]{64}$","minLength":68,"maxLength":68}}
