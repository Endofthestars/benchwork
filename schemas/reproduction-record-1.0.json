{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/reproduction-record/1.0",
  "title": "Reproduction Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reproduction_id",
    "program_id",
    "evidence_id",
    "run_ids",
    "result_bundle_id",
    "artifact_ids",
    "assessment_id",
    "status",
    "recorded_at",
    "record_receipt"
  ],
  "properties": {
    "schema_version": {"const": "reproduction-record/1.0"},
    "reproduction_id": {"type": "string", "pattern": "^RR-"},
    "program_id": {"type": "string", "pattern": "^RP-"},
    "evidence_id": {"type": "string", "pattern": "^EV-"},
    "run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RUN-"}
    },
    "result_bundle_id": {"type": "string", "pattern": "^RB-"},
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AR-"}
    },
    "assessment_id": {"type": "string", "pattern": "^AS-"},
    "status": {"enum": ["REPRODUCED", "NOT_REPRODUCED", "INCONCLUSIVE"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "record_receipt": {"type": "string", "pattern": "^RC-"}
  }
}
