{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-operational-evidence-manifest/1.0",
  "title": "Patch Operational Evidence Manifest v1",
  "description": "Closed RFC-0014 event-evidence or Journal-suffix source manifest. Contract-only validation does not resolve a Promotion Journal payload, control record, Blob, Reference Set, plan, hold, or external authority and does not append an Event or release Storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_manifest_id",
    "activation",
    "body",
    "control_records",
    "blob_refs",
    "evidence_sigils",
    "manifest_sigil"
  ],
  "properties": {
    "schema_version": {"const": "patch-operational-evidence-manifest/1.0"},
    "evidence_manifest_id": {"$ref": "#/$defs/evidenceManifestId"},
    "activation": {"$ref": "#/$defs/evidenceActivation"},
    "body": {"$ref": "#/$defs/operationalEvidenceBody"},
    "control_records": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/controlRef"}
    },
    "blob_refs": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/blobRef"}
    },
    "evidence_sigils": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sigil"}
    },
    "manifest_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "u63": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "evidenceManifestId": {
      "type": "string",
      "pattern": "^PEM-[A-F0-9]{64}$",
      "minLength": 68,
      "maxLength": 68
    },
    "pj": {
      "type": "string",
      "pattern": "^PJ-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "pje": {
      "type": "string",
      "pattern": "^PJE-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 5,
      "maxLength": 128
    },
    "pat": {
      "type": "string",
      "pattern": "^PAT-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 5,
      "maxLength": 128
    },
    "pra": {
      "type": "string",
      "pattern": "^PRA-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 5,
      "maxLength": 128
    },
    "ptri": {
      "type": "string",
      "pattern": "^PTRI-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 6,
      "maxLength": 128
    },
    "eventType": {
      "enum": [
        "coordinator.replay-started",
        "target.guard-validated",
        "promotion.verification-started",
        "promotion.applied",
        "promotion.recovered-postimage-observed",
        "promotion.already-applied",
        "promotion.stale",
        "promotion.conflicted",
        "promotion.failed",
        "promotion.partial",
        "promotion.cancelled",
        "recovery.verification-started",
        "recovery.base-restored",
        "recovery.postimage-accepted",
        "recovery.abandoned",
        "recovery.stale",
        "recovery.failed",
        "recovery.partial",
        "recovery.cancelled"
      ]
    },
    "evidenceActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operational_journal_id",
        "activation_event_id",
        "activation_event_type",
        "payload_field"
      ],
      "properties": {
        "operational_journal_id": {"$ref": "#/$defs/pj"},
        "activation_event_id": {"$ref": "#/$defs/pje"},
        "activation_event_type": {"$ref": "#/$defs/eventType"},
        "payload_field": {
          "enum": [
            "PRIOR_STEP_PROTECTION",
            "EVIDENCE_PROTECTION",
            "SUFFIX_EVIDENCE_PROTECTION"
          ]
        }
      }
    },
    "promotionEvidenceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "attempt_id"],
      "properties": {
        "kind": {"const": "PROMOTION"},
        "attempt_id": {"$ref": "#/$defs/pat"}
      }
    },
    "recoveryEvidenceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovery_attempt_id", "parent_attempt_id"],
      "properties": {
        "kind": {"const": "RECOVERY"},
        "recovery_attempt_id": {"$ref": "#/$defs/pra"},
        "parent_attempt_id": {"$ref": "#/$defs/pat"}
      }
    },
    "journalSuffixEvidenceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "journal_id", "recovery_id"],
      "properties": {
        "kind": {"const": "JOURNAL_SUFFIX"},
        "journal_id": {"$ref": "#/$defs/pj"},
        "recovery_id": {"$ref": "#/$defs/ptri"}
      }
    },
    "eventEvidenceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner",
        "role",
        "claims_sigil",
        "evidence_binding_sigil"
      ],
      "properties": {
        "kind": {"const": "EVENT_EVIDENCE"},
        "owner": {
          "oneOf": [
            {"$ref": "#/$defs/promotionEvidenceOwner"},
            {"$ref": "#/$defs/recoveryEvidenceOwner"}
          ]
        },
        "role": {
          "enum": [
            "GUARD_VALIDATION",
            "VERIFICATION",
            "TERMINAL",
            "ABANDONMENT"
          ]
        },
        "claims_sigil": {"$ref": "#/$defs/sigil"},
        "evidence_binding_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "journalSuffixEvidenceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner",
        "old_head",
        "observed_eof",
        "suffix_kind",
        "last_complete_offset",
        "target_head",
        "original_suffix_blob",
        "classification_sigil"
      ],
      "properties": {
        "kind": {"const": "JOURNAL_SUFFIX"},
        "owner": {"$ref": "#/$defs/journalSuffixEvidenceOwner"},
        "old_head": {"$ref": "https://benchwork.dev/schemas/patch-promotion-journal-head/1.0"},
        "observed_eof": {"$ref": "#/$defs/u64"},
        "suffix_kind": {"enum": ["COMPLETE", "TORN_EOF"]},
        "last_complete_offset": {"$ref": "#/$defs/u64"},
        "target_head": {"$ref": "https://benchwork.dev/schemas/patch-promotion-journal-head/1.0"},
        "original_suffix_blob": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/blobRef"},
        "classification_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "operationalEvidenceBody": {
      "oneOf": [
        {"$ref": "#/$defs/eventEvidenceBody"},
        {"$ref": "#/$defs/journalSuffixEvidenceBody"}
      ]
    }
  }
}

