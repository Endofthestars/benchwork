{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/capability-contract/1.0",
  "title": "Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "allowed_tools",
    "network",
    "max_time_seconds",
    "requires_approval",
    "expected_outputs"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "allowed_tools": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "network": {"type": "boolean"},
    "max_time_seconds": {"type": "integer", "minimum": 1},
    "requires_approval": {"type": "boolean"},
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema"],
        "properties": {
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
