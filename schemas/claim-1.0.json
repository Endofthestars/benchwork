{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/claim/1.0",
  "title": "Research Claim",
  "type": "object",
  "required": ["schema_version", "claim_id", "program_id", "type", "statement", "status"],
  "properties": {
    "schema_version": {"const": "claim/1.0"},
    "claim_id": {"type": "string", "pattern": "^CL-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "type": {"enum": ["empirical", "theoretical", "methodological", "operational"]},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "SUPPORTED", "CONTESTED", "REJECTED", "UNRESOLVED"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-"}}
  }
}
