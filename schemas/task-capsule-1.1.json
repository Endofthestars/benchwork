{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/task-capsule/1.1",
  "title": "Task Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "host",
    "program_id",
    "objective",
    "capability",
    "snapshot",
    "expected_outputs",
    "circle",
    "capsule_sigil"
  ],
  "properties": {
    "schema_version": {"const": "task-capsule/1.1"},
    "task_id": {"type": "string", "pattern": "^TK-[A-Z0-9]+$"},
    "host": {"enum": ["cli", "codex", "claude-code"]},
    "program_id": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"
    },
    "objective": {"type": "string", "minLength": 1},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "contract_sigil"],
      "properties": {
        "id": {"type": "string", "pattern": "^bench\\."},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "contract_sigil": {
          "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sigil"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^SS-[A-Z0-9]+$"},
        "snapshot_sigil": {
          "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema"],
        "properties": {
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$"
          }
        }
      },
      "uniqueItems": true
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "time_budget_seconds", "network"],
      "properties": {
        "tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "time_budget_seconds": {"type": "integer", "minimum": 1},
        "network": {"type": "boolean"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_id": {"type": "string", "pattern": "^RV-"}
      }
    },
    "capsule_sigil": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
    }
  }
}
