{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-log-chunk/1.0",
  "title": "Execution Log Chunk v1",
  "description": "Closed RFC-0012 L1-L12 immutable accepted-byte record. Shape and pure local validation do not authorize capture, resolve live ownership, establish sequence eligibility, consume an ingress key, append a Journal Event, acknowledge a request, or grant storage, assurance, Artifact, Run, or scientific authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "log_stream_id",
    "job_id",
    "attempt_id",
    "lease_id",
    "worker_id",
    "worker_session_id",
    "executor_epoch",
    "attempt_binding_sigil",
    "lease_binding_sigil",
    "worker_session_binding_sigil",
    "fence_tuple",
    "stream",
    "sequence",
    "byte_length",
    "media_type",
    "encoding",
    "blob_sigil",
    "staging_reference",
    "observed_at",
    "received_at",
    "split_utf8_boundary",
    "split_line",
    "chunk_record_sigil"
  ],
  "properties": {
    "schema_version": {"const": "execution-log-chunk/1.0"},
    "chunk_id": {"$ref": "#/$defs/chunk_id"},
    "log_stream_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/logStreamId"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
    "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},
    "worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},
    "executor_epoch": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/u64"},
    "attempt_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "lease_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "worker_session_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "fence_tuple": {"$ref": "https://benchwork.dev/schemas/execution-state/1.0#/$defs/public_fence_tuple"},
    "stream": {"enum": ["STDOUT", "STDERR", "STRUCTURED"]},
    "sequence": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
    "byte_length": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "media_type": {"enum": ["application/octet-stream", "application/x-ndjson"]},
    "encoding": {"enum": ["BINARY", "UTF-8"]},
    "blob_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "staging_reference": {"$ref": "#/$defs/staging_reference"},
    "observed_at": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "received_at": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "split_utf8_boundary": {"type": "boolean"},
    "split_line": {"type": "boolean"},
    "chunk_record_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
  },
  "$defs": {
    "chunk_id": {
      "type": "string",
      "pattern": "^LC-[A-Z0-9]+$",
      "not": {"pattern": "[\\r\\n]"},
      "minLength": 4,
      "maxLength": 128
    },
    "staging_record_id": {
      "type": "string",
      "pattern": "^LSR-[0-9A-F]{64}$",
      "minLength": 68,
      "maxLength": 68
    },
    "staging_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "staging_record_id", "staging_record_sigil"],
      "properties": {
        "kind": {"const": "EXECUTION_LOG_SPOOL_RECORD"},
        "staging_record_id": {"$ref": "#/$defs/staging_record_id"},
        "staging_record_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stream": {"enum": ["STDOUT", "STDERR"]}}},
      "then": {
        "properties": {
          "media_type": {"const": "application/octet-stream"},
          "encoding": {"const": "BINARY"},
          "split_utf8_boundary": {"const": false},
          "split_line": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"stream": {"const": "STRUCTURED"}}},
      "then": {
        "properties": {
          "media_type": {"const": "application/x-ndjson"},
          "encoding": {"const": "UTF-8"}
        }
      }
    }
  ]
}

