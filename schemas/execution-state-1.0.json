{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-state/1.0",
  "title": "Execution State v1",
  "description": "Closed replaceable RFC-0012 replay cache. Validation grants no replay, append, worker, lease, result, storage, assurance, or scientific authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limit_profile", "journal_binding", "executor", "recoveries", "workers", "worker_sessions", "jobs", "attempts", "leases", "log_streams", "deadlines", "idempotency_records", "state_sigil"],
  "properties": {
    "schema_version": {"const": "execution-state/1.0"},
    "limit_profile": {"const": "EXECUTION_JOURNAL_V1_FIXED_LIMITS"},
    "journal_binding": {"$ref": "#/$defs/journal_binding"},
    "executor": {"$ref": "#/$defs/executor_projection"},
    "recoveries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/recovery_projection"}},
    "workers": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/worker_projection"}},
    "worker_sessions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/worker_session_projection"}},
    "jobs": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/job_projection"}},
    "attempts": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/attempt_projection"}},
    "leases": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/lease_projection"}},
    "log_streams": {"type": "array", "maxItems": 12288, "items": {"$ref": "#/$defs/log_stream_projection"}},
    "deadlines": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/deadline_projection"}},
    "idempotency_records": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/idempotency_record"}},
    "state_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positive_u63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_:+-]{0,127}$", "minLength": 1, "maxLength": 128},
    "event_id": {"type": "string", "pattern": "^JE-[A-Z0-9]+$", "minLength": 4, "maxLength": 128},
    "journal_id": {"type": "string", "pattern": "^EJ-[A-Z0-9]+$", "minLength": 4, "maxLength": 128},
    "recovery_id": {"type": "string", "pattern": "^RY-[A-Z0-9]+$", "minLength": 4, "maxLength": 128},
    "log_stream_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/logStreamId"},
    "nullable_sigil": {"oneOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]},
    "nullable_u63": {"oneOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]},
    "nullable_u64": {"oneOf": [{"$ref": "#/$defs/u64"}, {"type": "null"}]},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "nullable_event_id": {"oneOf": [{"$ref": "#/$defs/event_id"}, {"type": "null"}]},
    "nullable_attempt_id": {"oneOf": [{"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/attemptId"}, {"type": "null"}]},
    "nullable_lease_id": {"oneOf": [{"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"}, {"type": "null"}]},

    "public_fence_tuple": {
      "type": "object", "additionalProperties": false,
      "required": ["journal_id", "executor_epoch", "job_id", "attempt_id", "lease_id", "fencing_generation"],
      "properties": {
        "journal_id": {"$ref": "#/$defs/journal_id"}, "executor_epoch": {"$ref": "#/$defs/u64"},
        "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
        "attempt_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/attemptId"},
        "lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
        "fencing_generation": {"$ref": "#/$defs/u64"}
      }
    },
    "executor_build_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_id", "implementation_version", "source_revision_sigil", "executable_artifact_sigil", "dependency_set_sigil", "build_configuration_sigil", "executor_build_sigil"],
      "properties": {
        "implementation_id": {"$ref": "#/$defs/opaque_id"}, "implementation_version": {"$ref": "#/$defs/opaque_id"},
        "source_revision_sigil": {"$ref": "#/$defs/sigil"}, "executable_artifact_sigil": {"$ref": "#/$defs/sigil"},
        "dependency_set_sigil": {"$ref": "#/$defs/sigil"}, "build_configuration_sigil": {"$ref": "#/$defs/sigil"},
        "executor_build_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "job_state": {"enum": ["SUBMITTED", "QUEUED", "ACTIVE", "RETRY_WAIT", "STOPPING", "SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "POLICY_VIOLATION"]},
    "attempt_state": {"enum": ["CREATED", "PREFLIGHTING", "READY", "LEASED", "STARTING", "RUNNING", "DRAINING", "STOPPING", "CLEANING", "SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "POLICY_VIOLATION", "LEASE_EXPIRED", "LOST", "FENCED", "REJECTED"]},
    "worker_state": {"enum": ["REGISTERED", "ENABLED", "DRAINING", "QUARANTINED", "RETIRED"]},
    "worker_session_state": {"enum": ["REGISTERED", "READY", "BUSY", "DRAINING", "OFFLINE", "QUARANTINED", "CLOSED"]},
    "lease_state": {"enum": ["OFFERED", "ACTIVE", "RELEASED", "REVOKED", "EXPIRED", "FENCED"]},

    "journal_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["journal_id", "through_sequence", "through_event_id", "through_event_sigil"],
      "properties": {"journal_id": {"$ref": "#/$defs/journal_id"}, "through_sequence": {"$ref": "#/$defs/positive_u63"}, "through_event_id": {"$ref": "#/$defs/event_id"}, "through_event_sigil": {"$ref": "#/$defs/sigil"}}
    },
    "terminal_event_binding": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "terminal_state", "terminal_event_id", "terminal_event_sigil", "terminal_sequence", "terminal_recorded_at"], "properties": {"kind": {"const": "PRESENT"}, "terminal_state": {"anyOf": [{"$ref": "#/$defs/job_state"}, {"$ref": "#/$defs/attempt_state"}, {"$ref": "#/$defs/lease_state"}]}, "terminal_event_id": {"$ref": "#/$defs/event_id"}, "terminal_event_sigil": {"$ref": "#/$defs/sigil"}, "terminal_sequence": {"$ref": "#/$defs/positive_u63"}, "terminal_recorded_at": {"$ref": "#/$defs/timestamp"}}}
      ]
    },
    "resource_counter_floors": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_time_seconds", "storage_bytes_written", "network_egress_bytes"],
      "properties": {"cpu_time_seconds": {"$ref": "#/$defs/nullable_u63"}, "storage_bytes_written": {"$ref": "#/$defs/nullable_u63"}, "network_egress_bytes": {"$ref": "#/$defs/nullable_u63"}}
    },

    "attempt_authorization_requirement": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptAuthorizationRequirement"},
    "attempt_authorization_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_subject_id", "authorization_subject_sigil", "authorization_transition_request_id", "authorization_transition_request_sigil", "authorization_event_id", "authorization_event_body_sigil", "authorization_receipt_id", "authorization_receipt_sigil", "authorization_binding_sigil"],
      "properties": {
        "authorization_subject_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/authorizationSubjectId"}, "authorization_subject_sigil": {"$ref": "#/$defs/sigil"},
        "authorization_transition_request_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-transition-request/1.0#/$defs/transitionRequestId"}, "authorization_transition_request_sigil": {"$ref": "#/$defs/sigil"},
        "authorization_event_id": {"$ref": "#/$defs/opaque_id"}, "authorization_event_body_sigil": {"$ref": "#/$defs/sigil"},
        "authorization_receipt_id": {"type": "string", "pattern": "^RC-[A-Z0-9]+$", "minLength": 4, "maxLength": 128}, "authorization_receipt_sigil": {"$ref": "#/$defs/sigil"}, "authorization_binding_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "attempt_authorization_state": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PENDING"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "authorization_subject", "attempt_authorization_binding"], "properties": {"kind": {"const": "BOUND"}, "authorization_subject": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0"}, "attempt_authorization_binding": {"$ref": "#/$defs/attempt_authorization_binding"}}}
      ]
    },
    "reason_codes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque_id"}},
    "attempt_assurance_binding": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PENDING"}}},
        {"$ref": "#/$defs/attempt_assurance_claimed"}, {"$ref": "#/$defs/attempt_assurance_negative"}
      ]
    },
    "attempt_assurance_claimed": {"type": "object", "additionalProperties": false, "required": ["kind", "evaluation_event_id", "evaluation_event_sigil", "evaluation_sequence", "assurance_claim_sigil", "evidence_set_sigil"], "properties": {"kind": {"const": "CLAIMED"}, "evaluation_event_id": {"$ref": "#/$defs/event_id"}, "evaluation_event_sigil": {"$ref": "#/$defs/sigil"}, "evaluation_sequence": {"$ref": "#/$defs/positive_u63"}, "assurance_claim_sigil": {"$ref": "#/$defs/sigil"}, "evidence_set_sigil": {"$ref": "#/$defs/sigil"}}},
    "attempt_assurance_negative": {"type": "object", "additionalProperties": false, "required": ["kind", "evaluation_event_id", "evaluation_event_sigil", "evaluation_sequence", "reason_codes", "evidence_set_sigil"], "properties": {"kind": {"enum": ["UNMET", "UNVERIFIABLE"]}, "evaluation_event_id": {"$ref": "#/$defs/event_id"}, "evaluation_event_sigil": {"$ref": "#/$defs/sigil"}, "evaluation_sequence": {"$ref": "#/$defs/positive_u63"}, "reason_codes": {"$ref": "#/$defs/reason_codes"}, "evidence_set_sigil": {"$ref": "#/$defs/sigil"}}},
    "job_assurance_binding": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PENDING"}}},
        {"$ref": "#/$defs/job_assurance_claimed"}, {"$ref": "#/$defs/job_assurance_negative"},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evaluation_event_id", "evaluation_event_sigil", "evaluation_sequence", "reason", "evidence_set_sigil"], "properties": {"kind": {"const": "NOT_APPLICABLE"}, "evaluation_event_id": {"$ref": "#/$defs/event_id"}, "evaluation_event_sigil": {"$ref": "#/$defs/sigil"}, "evaluation_sequence": {"$ref": "#/$defs/positive_u63"}, "reason": {"const": "NO_ATTEMPT_ALLOCATED"}, "evidence_set_sigil": {"$ref": "#/$defs/sigil"}}}
      ]
    },
    "job_assurance_claimed": {"type": "object", "additionalProperties": false, "required": ["kind", "evaluation_event_id", "evaluation_event_sigil", "evaluation_sequence", "attempt_id", "attempt_assurance_event_sigil", "assurance_claim_sigil", "evidence_set_sigil"], "properties": {"kind": {"const": "CLAIMED"}, "evaluation_event_id": {"$ref": "#/$defs/event_id"}, "evaluation_event_sigil": {"$ref": "#/$defs/sigil"}, "evaluation_sequence": {"$ref": "#/$defs/positive_u63"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/attemptId"}, "attempt_assurance_event_sigil": {"$ref": "#/$defs/sigil"}, "assurance_claim_sigil": {"$ref": "#/$defs/sigil"}, "evidence_set_sigil": {"$ref": "#/$defs/sigil"}}},
    "job_assurance_negative": {"type": "object", "additionalProperties": false, "required": ["kind", "evaluation_event_id", "evaluation_event_sigil", "evaluation_sequence", "attempt_id", "attempt_assurance_event_sigil", "reason_codes", "evidence_set_sigil"], "properties": {"kind": {"enum": ["UNMET", "UNVERIFIABLE"]}, "evaluation_event_id": {"$ref": "#/$defs/event_id"}, "evaluation_event_sigil": {"$ref": "#/$defs/sigil"}, "evaluation_sequence": {"$ref": "#/$defs/positive_u63"}, "attempt_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/attemptId"}, "attempt_assurance_event_sigil": {"$ref": "#/$defs/sigil"}, "reason_codes": {"$ref": "#/$defs/reason_codes"}, "evidence_set_sigil": {"$ref": "#/$defs/sigil"}}},

    "budget_dimension": {"type": "object", "additionalProperties": false, "required": ["limit", "reserved", "consumed", "exhaustion_status"], "properties": {"limit": {"$ref": "#/$defs/u63"}, "reserved": {"$ref": "#/$defs/u63"}, "consumed": {"$ref": "#/$defs/u63"}, "exhaustion_status": {"enum": ["AVAILABLE", "EXHAUSTED", "EXCEEDED"]}}},
    "budget_ledger": {"type": "object", "additionalProperties": false, "required": ["attempts", "cpu_time_seconds", "storage_bytes_written", "output_bytes", "log_bytes", "process_starts", "network_egress_bytes", "network_requests", "budget_ledger_sigil"], "properties": {"attempts": {"$ref": "#/$defs/budget_dimension"}, "cpu_time_seconds": {"$ref": "#/$defs/budget_dimension"}, "storage_bytes_written": {"$ref": "#/$defs/budget_dimension"}, "output_bytes": {"$ref": "#/$defs/budget_dimension"}, "log_bytes": {"$ref": "#/$defs/budget_dimension"}, "process_starts": {"$ref": "#/$defs/budget_dimension"}, "network_egress_bytes": {"$ref": "#/$defs/budget_dimension"}, "network_requests": {"$ref": "#/$defs/budget_dimension"}, "budget_ledger_sigil": {"$ref": "#/$defs/sigil"}}},
    "budget_settlement_binding": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PENDING"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "event_id", "event_sigil", "accounting_capture_event_id", "accounting_capture_event_sigil", "usage_status"], "properties": {"kind": {"const": "SETTLED"}, "event_id": {"$ref": "#/$defs/event_id"}, "event_sigil": {"$ref": "#/$defs/sigil"}, "accounting_capture_event_id": {"$ref": "#/$defs/event_id"}, "accounting_capture_event_sigil": {"$ref": "#/$defs/sigil"}, "usage_status": {"enum": ["MEASURED", "PARTIAL", "UNAVAILABLE"]}}}]},
    "accounting_capture_binding": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PENDING"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "event_id", "event_sigil", "usage_status", "accounting_evidence_set_sigil"], "properties": {"kind": {"const": "CAPTURED"}, "event_id": {"$ref": "#/$defs/event_id"}, "event_sigil": {"$ref": "#/$defs/sigil"}, "usage_status": {"enum": ["MEASURED", "PARTIAL", "UNAVAILABLE"]}, "accounting_evidence_set_sigil": {"$ref": "#/$defs/sigil"}}}]},

    "executor_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_instance_id", "executor_epoch", "executor_build_binding", "revision", "clock_state", "last_trusted_utc", "clock_uncertain_event_id", "active_recovery_id", "authority_gates", "last_event_id", "last_event_sigil"],
      "properties": {"executor_instance_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/executorInstanceId"}, "executor_epoch": {"$ref": "#/$defs/u64"}, "executor_build_binding": {"$ref": "#/$defs/executor_build_binding"}, "revision": {"$ref": "#/$defs/u64"}, "clock_state": {"enum": ["TRUSTED", "UNCERTAIN"]}, "last_trusted_utc": {"$ref": "#/$defs/timestamp"}, "clock_uncertain_event_id": {"$ref": "#/$defs/nullable_event_id"}, "active_recovery_id": {"oneOf": [{"$ref": "#/$defs/recovery_id"}, {"type": "null"}]}, "authority_gates": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["INTEGRITY_FAILURE", "CLOCK_UNCERTAIN", "RECOVERY_ACTIVE"]}}, "last_event_id": {"$ref": "#/$defs/event_id"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}},
      "allOf": [{"if": {"properties": {"clock_state": {"const": "TRUSTED"}}}, "then": {"properties": {"clock_uncertain_event_id": {"type": "null"}}}}, {"if": {"properties": {"clock_state": {"const": "UNCERTAIN"}}}, "then": {"properties": {"clock_uncertain_event_id": {"$ref": "#/$defs/event_id"}}}}]
    },
    "recovery_projection": {"type": "object", "additionalProperties": false, "required": ["recovery_id", "revision", "state", "prior_recovery_id", "started_event_sigil", "current_action_set_sigil", "last_event_id", "last_event_sigil"], "properties": {"recovery_id": {"$ref": "#/$defs/recovery_id"}, "revision": {"$ref": "#/$defs/u64"}, "state": {"enum": ["STARTED", "FENCING", "RECONCILING", "FINALIZING", "COMPLETED"]}, "prior_recovery_id": {"oneOf": [{"$ref": "#/$defs/recovery_id"}, {"type": "null"}]}, "started_event_sigil": {"$ref": "#/$defs/sigil"}, "current_action_set_sigil": {"$ref": "#/$defs/nullable_sigil"}, "last_event_id": {"$ref": "#/$defs/event_id"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}},
    "worker_projection": {"type": "object", "additionalProperties": false, "required": ["worker_id", "revision", "state", "worker_binding_sigil", "definition_revision", "worker_session_ids", "last_event_id", "last_event_sigil"], "properties": {"worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"}, "revision": {"$ref": "#/$defs/u64"}, "state": {"$ref": "#/$defs/worker_state"}, "worker_binding_sigil": {"$ref": "#/$defs/sigil"}, "definition_revision": {"$ref": "#/$defs/u64"}, "worker_session_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"}}, "last_event_id": {"$ref": "#/$defs/event_id"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}}},
    "worker_session_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_session_id", "revision", "state", "worker_id", "worker_binding_sigil", "worker_session_binding_sigil", "executor_epoch", "worker_session_heartbeat_policy_id", "worker_session_heartbeat_policy_sigil", "capacity", "capacity_in_use", "last_heartbeat_sequence", "last_heartbeat_message_sigil", "last_resource_sample_sigil", "resource_counter_floors", "next_heartbeat_due_at", "lease_ids", "last_event_id", "last_event_sigil"],
      "properties": {"worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"}, "revision": {"$ref": "#/$defs/u64"}, "state": {"$ref": "#/$defs/worker_session_state"}, "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"}, "worker_binding_sigil": {"$ref": "#/$defs/sigil"}, "worker_session_binding_sigil": {"$ref": "#/$defs/sigil"}, "executor_epoch": {"$ref": "#/$defs/u64"}, "worker_session_heartbeat_policy_id": {"oneOf": [{"type": "string", "pattern": "^WSHP-[0-9A-F]{64}$", "minLength": 69, "maxLength": 69}, {"type": "null"}]}, "worker_session_heartbeat_policy_sigil": {"$ref": "#/$defs/nullable_sigil"}, "capacity": {"$ref": "#/$defs/nullable_u63"}, "capacity_in_use": {"$ref": "#/$defs/u63"}, "last_heartbeat_sequence": {"$ref": "#/$defs/nullable_u63"}, "last_heartbeat_message_sigil": {"$ref": "#/$defs/nullable_sigil"}, "last_resource_sample_sigil": {"$ref": "#/$defs/nullable_sigil"}, "resource_counter_floors": {"$ref": "#/$defs/resource_counter_floors"}, "next_heartbeat_due_at": {"$ref": "#/$defs/nullable_timestamp"}, "lease_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"}}, "last_event_id": {"$ref": "#/$defs/event_id"}, "last_event_sigil": {"$ref": "#/$defs/sigil"}},
      "allOf": [{"if": {"properties": {"capacity": {"type": "null"}}}, "then": {"properties": {"worker_session_heartbeat_policy_id": {"type": "null"}, "worker_session_heartbeat_policy_sigil": {"type": "null"}, "capacity_in_use": {"const": 0}}}}, {"if": {"properties": {"capacity": {"type": "integer"}}}, "then": {"properties": {"worker_session_heartbeat_policy_id": {"type": "string"}, "worker_session_heartbeat_policy_sigil": {"type": "string"}}}}]
    },

    "queue_key": {"type": "object", "additionalProperties": false, "required": ["ready_sequence", "job_id"], "properties": {"ready_sequence": {"$ref": "#/$defs/positive_u63"}, "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"}}},
    "output_hold_release_schedule": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "storage_root_manifest_id", "storage_root_manifest_sigil", "reference_set_id", "reference_set_sigil", "hold_id", "hold_set_event", "retention_duration_seconds", "root_inactivation_event_id", "release_due_at", "deadline_status"], "properties": {"attempt_id": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/attemptId"}, "storage_root_manifest_id": {"$ref": "#/$defs/opaque_id"}, "storage_root_manifest_sigil": {"$ref": "#/$defs/sigil"}, "reference_set_id": {"$ref": "#/$defs/opaque_id"}, "reference_set_sigil": {"$ref": "#/$defs/sigil"}, "hold_id": {"$ref": "#/$defs/opaque_id"}, "hold_set_event": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_ref"}, "retention_duration_seconds": {"$ref": "#/$defs/u63"}, "root_inactivation_event_id": {"$ref": "#/$defs/event_id"}, "release_due_at": {"$ref": "#/$defs/timestamp"}, "deadline_status": {"enum": ["EXACT", "OVERFLOW_FAIL_CLOSED"]}}},
    "job_projection": {
