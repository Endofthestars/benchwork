{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-base-identity-profile/1.0",
  "title": "Patch Base Identity Profile v1",
  "description": "Closed RFC-0014 patch-base-identity-profile/1.0 contract-only record. Validation is local and does not inspect a filesystem, resolve a Profile, or calculate a tree identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "path_scope", "path_semantics", "entry_semantics", "limits", "protected_paths", "profile_sigil"],
  "properties": {
    "schema_version": {"const": "patch-base-identity-profile/1.0"},
    "profile_id": {"$ref": "#/$defs/pbip"},
    "path_scope": {"$ref": "#/$defs/pathScope"},
    "path_semantics": {"$ref": "#/$defs/pathSemantics"},
    "entry_semantics": {"$ref": "#/$defs/entrySemantics"},
    "limits": {"$ref": "#/$defs/limits"},
    "protected_paths": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "profile_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "maxPaths": {"type": "integer", "minimum": 1, "maximum": 100000},
    "maxDepth": {"type": "integer", "minimum": 1, "maximum": 4096},
    "pbip": {"type": "string", "pattern": "^PBIP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/\\u0000-\\u001F\\u007F-\\u009F]+(?:/[^/\\u0000-\\u001F\\u007F-\\u009F]+)*$", "not": {"pattern": "[\\r\\n]"}},
    "pathScope": {"type": "object", "additionalProperties": false, "required": ["root_kind", "included_paths", "excluded_paths"], "properties": {"root_kind": {"enum": ["CRUCIBLE", "PROMOTION_TARGET"]}, "included_paths": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "excluded_paths": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}}},
    "pathSemantics": {"type": "object", "additionalProperties": false, "required": ["separator", "unicode_normalization", "case_mode", "dot_segments", "link_traversal", "reserved_name_policy"], "properties": {"separator": {"const": "SLASH"}, "unicode_normalization": {"const": "NFC"}, "case_mode": {"enum": ["SENSITIVE", "INSENSITIVE_REJECT_COLLISIONS"]}, "dot_segments": {"const": "REJECT"}, "link_traversal": {"const": "NOFOLLOW"}, "reserved_name_policy": {"const": "REJECT"}}},
    "entrySemantics": {"type": "object", "additionalProperties": false, "required": ["supported_types", "content_digest", "executable_bit", "symlink_target", "metadata_policy"], "properties": {"supported_types": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["FILE", "DIRECTORY", "SYMLINK"]}}, "content_digest": {"const": "SHA256"}, "executable_bit": {"enum": ["SIGNIFICANT", "IGNORED"]}, "symlink_target": {"const": "UTF8_NOFOLLOW"}, "metadata_policy": {"const": "TYPE_CONTENT_MODE_ONLY"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_paths", "max_total_bytes", "max_file_bytes", "max_depth", "max_symlink_bytes"], "properties": {"max_paths": {"$ref": "#/$defs/maxPaths"}, "max_total_bytes": {"$ref": "#/$defs/u63"}, "max_file_bytes": {"$ref": "#/$defs/u63"}, "max_depth": {"$ref": "#/$defs/maxDepth"}, "max_symlink_bytes": {"$ref": "#/$defs/maxDepth"}}}
  }
}

