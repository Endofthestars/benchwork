{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-provenance/1.0",
  "title": "Artifact Provenance v1",
  "description": "Closed RFC-0013 artifact-provenance/1.0 record. This contract-only increment validates local wire shape and local canonical collections; it does not resolve records, authorization, time causality, or runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance_id", "relation", "blob", "source", "destination", "actor_id", "authorization_sigil", "execution", "backend", "transfer", "provenance_policy", "verifications", "transformation", "times", "terminal_reason", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-provenance/1.0"},
    "provenance_id": {"$ref": "#/$defs/opaque"},
    "relation": {"enum": ["CAPTURED", "IMPORTED", "COPIED", "DERIVED", "EXPORTED", "MATERIALIZED", "VERIFIED", "DELETED"]},
    "blob": {"$ref": "#/$defs/blobRef"},
    "source": {"$ref": "#/$defs/sourceDescriptor"},
    "destination": {"$ref": "#/$defs/destinationDescriptor"},
    "actor_id": {"$ref": "#/$defs/opaque"},
    "authorization_sigil": {"$ref": "#/$defs/sigil"},
    "execution": {"$ref": "#/$defs/executionContext"},
    "backend": {"$ref": "#/$defs/backendRef"},
    "transfer": {"$ref": "#/$defs/transferRef"},
    "provenance_policy": {"$ref": "#/$defs/provenancePolicyRef"},
    "verifications": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/provenanceVerification"}},
    "transformation": {"$ref": "#/$defs/transformationRef"},
    "times": {"$ref": "#/$defs/timeSet"},
    "terminal_reason": {"anyOf": [{"$ref": "#/$defs/reason"}, {"type": "null"}]},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "operationalId": {"type": "string", "pattern": "^[A-Z]+-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 3, "maxLength": 128},
    "replicaId": {"type": "string", "pattern": "^SR-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "provenancePolicyId": {"type": "string", "pattern": "^SPP-[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "transferId": {"type": "string", "pattern": "^ST-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "transferAttemptId": {"type": "string", "pattern": "^SA-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "journalId": {"type": "string", "pattern": "^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "eventId": {"type": "string", "pattern": "^SE-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "materializationId": {"type": "string", "pattern": "^SM-[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 4, "maxLength": 128},
    "blobRef": {"type": "object", "additionalProperties": false, "required": ["blob_sigil", "size_bytes"], "properties": {"blob_sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}}},
    "backendRef": {"type": "object", "additionalProperties": false, "required": ["backend_id", "backend_profile_version", "backend_profile_sigil"], "properties": {"backend_id": {"$ref": "#/$defs/opaque"}, "backend_profile_version": {"$ref": "#/$defs/opaque"}, "backend_profile_sigil": {"$ref": "#/$defs/sigil"}}},
    "backendObjectRef": {"type": "object", "additionalProperties": false, "required": ["backend_id", "object_identity_sigil", "locator_sigil", "generation", "size_bytes", "blob_sigil"], "properties": {"backend_id": {"$ref": "#/$defs/opaque"}, "object_identity_sigil": {"$ref": "#/$defs/sigil"}, "locator_sigil": {"$ref": "#/$defs/sigil"}, "generation": {"$ref": "#/$defs/opaque"}, "size_bytes": {"$ref": "#/$defs/u63"}, "blob_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]}}},
    "executionFenceRef": {"type": "object", "additionalProperties": false, "required": ["execution_journal_id", "executor_epoch", "job_id", "attempt_id", "lease_id", "fencing_generation", "execution_event_sigil", "job_fence_floor", "tombstone_present"], "properties": {"execution_journal_id": {"$ref": "#/$defs/opaque"}, "executor_epoch": {"$ref": "#/$defs/u64"}, "job_id": {"$ref": "#/$defs/opaque"}, "attempt_id": {"$ref": "#/$defs/opaque"}, "lease_id": {"$ref": "#/$defs/opaque"}, "fencing_generation": {"$ref": "#/$defs/u64"}, "execution_event_sigil": {"$ref": "#/$defs/sigil"}, "job_fence_floor": {"$ref": "#/$defs/u64"}, "tombstone_present": {"type": "boolean"}}},
    "executionContext": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "execution_journal_id", "executor_epoch", "job_id", "attempt_id"], "properties": {"kind": {"const": "ATTEMPT"}, "execution_journal_id": {"$ref": "#/$defs/opaque"}, "executor_epoch": {"$ref": "#/$defs/u64"}, "job_id": {"$ref": "#/$defs/opaque"}, "attempt_id": {"$ref": "#/$defs/opaque"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "execution_journal_id", "executor_epoch", "job_id", "attempt_id", "lease_id", "worker_id", "worker_session_id", "fence"], "properties": {"kind": {"const": "LEASED"}, "execution_journal_id": {"$ref": "#/$defs/opaque"}, "executor_epoch": {"$ref": "#/$defs/u64"}, "job_id": {"$ref": "#/$defs/opaque"}, "attempt_id": {"$ref": "#/$defs/opaque"}, "lease_id": {"$ref": "#/$defs/opaque"}, "worker_id": {"$ref": "#/$defs/opaque"}, "worker_session_id": {"$ref": "#/$defs/opaque"}, "fence": {"$ref": "#/$defs/executionFenceRef"}}}
    ]},
    "sourceDescriptor": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "authorization_scope_sigil", "lexical_identity_sigil", "resolved_file_identity_sigil"], "properties": {"kind": {"const": "LOCAL_FILE"}, "authorization_scope_sigil": {"$ref": "#/$defs/sigil"}, "lexical_identity_sigil": {"$ref": "#/$defs/sigil"}, "resolved_file_identity_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "blob", "replica_id", "verification_sigil"], "properties": {"kind": {"const": "REPLICA"}, "blob": {"$ref": "#/$defs/blobRef"}, "replica_id": {"$ref": "#/$defs/replicaId"}, "verification_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "execution", "output_handle_id"], "properties": {"kind": {"const": "ATTEMPT_OUTPUT"}, "execution": {"$ref": "#/$defs/executionContext"}, "output_handle_id": {"$ref": "#/$defs/opaque"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "source_class", "sanitized_identity_sigil", "authorization_sigil"], "properties": {"kind": {"const": "EXTERNAL"}, "source_class": {"$ref": "#/$defs/opaque"}, "sanitized_identity_sigil": {"$ref": "#/$defs/sigil"}, "authorization_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "transfer_attempt_id", "object"], "properties": {"kind": {"const": "STAGING"}, "transfer_attempt_id": {"$ref": "#/$defs/transferAttemptId"}, "object": {"$ref": "#/$defs/backendObjectRef"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "artifact_id", "receipt_sigil", "location_sigil"], "properties": {"kind": {"const": "LEGACY_ARTIFACT"}, "artifact_id": {"$ref": "#/$defs/opaque"}, "receipt_sigil": {"$ref": "#/$defs/sigil"}, "location_sigil": {"$ref": "#/$defs/sigil"}}}
    ]},
    "destinationDescriptor": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "backend"], "properties": {"kind": {"const": "MANAGED_BACKEND"}, "backend": {"$ref": "#/$defs/backendRef"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "destination_class", "destination_identity_sigil", "authorization_sigil"], "properties": {"kind": {"const": "EXPORT"}, "destination_class": {"$ref": "#/$defs/opaque"}, "destination_identity_sigil": {"$ref": "#/$defs/sigil"}, "authorization_sigil": {"$ref": "#/$defs/sigil"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "materialization_id", "destination_class", "destination_identity_sigil"], "properties": {"kind": {"const": "MATERIALIZATION"}, "materialization_id": {"$ref": "#/$defs/materializationId"}, "destination_class": {"$ref": "#/$defs/opaque"}, "destination_identity_sigil": {"$ref": "#/$defs/sigil"}}}
    ]},
    "eventRef": {"type": "object", "additionalProperties": false, "required": ["journal_id", "event_id", "sequence", "event_sigil"], "properties": {"journal_id": {"$ref": "#/$defs/journalId"}, "event_id": {"$ref": "#/$defs/eventId"}, "sequence": {"$ref": "#/$defs/positiveU63"}, "event_sigil": {"$ref": "#/$defs/sigil"}}},
    "transferRef": {"type": "object", "additionalProperties": false, "required": ["transfer_id", "transfer_attempt_id", "request_record_sigil", "attempt_record_sigil", "terminal_event"], "properties": {"transfer_id": {"$ref": "#/$defs/transferId"}, "transfer_attempt_id": {"$ref": "#/$defs/transferAttemptId"}, "request_record_sigil": {"$ref": "#/$defs/sigil"}, "attempt_record_sigil": {"$ref": "#/$defs/sigil"}, "terminal_event": {"$ref": "#/$defs/eventRef"}}},
    "provenancePolicyRef": {"type": "object", "additionalProperties": false, "required": ["provenance_policy_id", "provenance_policy_sigil"], "properties": {"provenance_policy_id": {"$ref": "#/$defs/provenancePolicyId"}, "provenance_policy_sigil": {"$ref": "#/$defs/sigil"}}},
    "verificationRef": {"type": "object", "additionalProperties": false, "required": ["method", "evidence_sigil", "verified_at", "next_due_at"], "properties": {"method": {"enum": ["FULL_READBACK_SHA256", "CONFORMANCE_END_TO_END"]}, "evidence_sigil": {"$ref": "#/$defs/sigil"}, "verified_at": {"$ref": "#/$defs/timestamp"}, "next_due_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}}},
    "provenanceVerification": {"type": "object", "additionalProperties": false, "required": ["event", "replica_id", "blob", "backend", "backend_object", "verification"], "properties": {"event": {"$ref": "#/$defs/eventRef"}, "replica_id": {"$ref": "#/$defs/replicaId"}, "blob": {"$ref": "#/$defs/blobRef"}, "backend": {"$ref": "#/$defs/backendRef"}, "backend_object": {"$ref": "#/$defs/backendObjectRef"}, "verification": {"$ref": "#/$defs/verificationRef"}}},
    "transformationRef": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "contract_id", "contract_version", "implementation_sigil", "parameters_sigil", "input_blobs"], "properties": {"kind": {"const": "DERIVED"}, "contract_id": {"$ref": "#/$defs/opaque"}, "contract_version": {"$ref": "#/$defs/opaque"}, "implementation_sigil": {"$ref": "#/$defs/sigil"}, "parameters_sigil": {"$ref": "#/$defs/sigil"}, "input_blobs": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/blobRef"}}}}
    ]},
    "timeSet": {"type": "object", "additionalProperties": false, "required": ["observed_at", "started_at", "committed_at", "verified_at", "terminal_at"], "properties": {"observed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "started_at": {"$ref": "#/$defs/timestamp"}, "committed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "verified_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "terminal_at": {"$ref": "#/$defs/timestamp"}}},
    "reason": {"type": "object", "additionalProperties": false, "required": ["code", "evidence_sigils"], "properties": {"code": {"enum": ["AUTHORIZATION_DENIED", "BACKEND_AMBIGUOUS", "BACKEND_CONFLICT", "BACKEND_UNAVAILABLE", "BOUNDS_EXCEEDED", "CANCELLED", "CHRONICLE_REFERENCE_CHANGED", "CLOCK_UNCERTAIN", "CONFLICT", "CORRUPT", "DESTINATION_CONFLICT", "DISPOSITION_EXPIRED", "DURABILITY_UNVERIFIED", "EXECUTION_HOLD_LIFETIME_EXPIRED", "EXECUTION_ROOT_ORPHAN_ABORTED", "EXECUTION_ROOT_OWNER_TERMINATED", "FENCE_REJECTED", "GC_ROOT_CHANGED", "GENERATION_MISMATCH", "HASH_MISMATCH", "INTEGRITY_FAILURE", "INVALID_MESSAGE", "LEASE_EXPIRED", "LEGACY_PROTECTION_FAILED", "MINIMUM_REPLICA_VIOLATION", "OPERATIONAL_ROOT_TERMINATED", "PAYLOAD_LOST", "POLICY_REJECTED", "QUARANTINE_RESERVATION_FAILED", "QUOTA_EXHAUSTED", "RECOVERY_INTERRUPTED_PRECOMMIT", "RECOVERY_PAYLOAD_LOST", "RETENTION_BLOCKED", "SOURCE_CHANGED", "TAIL_INCOMPLETE", "TIMEOUT", "UNKNOWN_SCHEMA", "UNSAFE_PATH", "VERIFICATION_FAILED"]}, "evidence_sigils": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sigil"}}}}
  }
}
