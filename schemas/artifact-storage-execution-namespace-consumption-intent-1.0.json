{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-consumption-intent/1.0",
  "title": "Artifact Storage Execution Namespace Consumption Intent v1",
  "description": "Closed RFC-0013 E1 embedded consumption-intent leaf. It grants no standalone visibility, record installation, Storage Event append, locking, recovery, or transfer authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumption_intent_id", "namespace_reservation_id", "namespace_reservation_record_sigil", "namespace_activation_record_sigil", "job_id", "attempt_id", "storage_subject_id", "output_handle_id", "transfer_id", "transfer_attempt_id", "transfer_request", "transfer_request_sigil", "initial_transfer_attempt", "initial_transfer_attempt_sigil", "prepared_event_id", "prepared_event_payload", "created_at", "intent_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-execution-namespace-consumption-intent/1.0"},
    "consumption_intent_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-activation/1.0#/$defs/consumptionIntentId"},
    "namespace_reservation_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-reservation/1.0#/$defs/namespaceReservationId"},
    "namespace_reservation_record_sigil": {"$ref": "#/$defs/sigil"},
    "namespace_activation_record_sigil": {"$ref": "#/$defs/sigil"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "storage_subject_id": {"$ref": "#/$defs/sigil"},
    "output_handle_id": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/opaque"},
    "transfer_id": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferId"},
    "transfer_attempt_id": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferAttemptId"},
    "transfer_request": {"$ref": "https://benchwork.dev/schemas/artifact-transfer/1.0"},
    "transfer_request_sigil": {"$ref": "#/$defs/sigil"},
    "initial_transfer_attempt": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0"},
    "initial_transfer_attempt_sigil": {"$ref": "#/$defs/sigil"},
    "prepared_event_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-activation/1.0#/$defs/preparedEventId"},
    "prepared_event_payload": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/p_transfer_prepared"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "intent_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27}
  }
}

