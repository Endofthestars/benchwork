{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/working/1.0",
  "title": "Rite Working",
  "type": "object",
  "required": ["schema_version", "working_id", "rite_id", "rite_sigil", "rite", "program_id", "protocol_id", "stage", "history"],
  "properties": {
    "schema_version": {"const": "working/1.0"},
    "working_id": {"type": "string", "pattern": "^WK-"},
    "rite_id": {"type": "string", "pattern": "@"},
    "rite_sigil": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"},
    "rite": {"type": "object"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "protocol_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/protocol_id"},
    "stage": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "history": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
