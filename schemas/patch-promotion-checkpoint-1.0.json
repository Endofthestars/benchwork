{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-checkpoint/1.0",
  "title": "Patch Promotion Checkpoint v1",
  "description": "Closed RFC-0014 patch-promotion-checkpoint/1.0 contract-only record. Validation is local and does not resolve a Base, Attempt, Target, Blob bytes, or verifier evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "attempt_id", "target_id", "base", "affected_paths", "entries", "checkpoint_blobs", "created_at", "verified_at", "checkpoint_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-checkpoint/1.0"},
    "checkpoint_id": {"$ref": "#/$defs/pck"},
    "attempt_id": {"$ref": "#/$defs/pat"},
    "target_id": {"$ref": "#/$defs/pt"},
    "base": {"$ref": "#/$defs/pbRef"},
    "affected_paths": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "entries": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/checkpointEntry"}},
    "checkpoint_blobs": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/blob"}},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "checkpoint_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "text128": {"type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "text4096": {"type": "string", "minLength": 0, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "path": {"allOf": [{"$ref": "#/$defs/text4096"}, {"type": "string", "minLength": 1}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "pck": {"type": "string", "pattern": "^PCK-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "pat": {"type": "string", "pattern": "^PAT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "pt": {"type": "string", "pattern": "^PT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "pb": {"type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "pbRef": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"$ref": "#/$defs/pb"}, "sigil": {"$ref": "#/$defs/sigil"}}},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sigil", "size_bytes", "media_type"], "properties": {"sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "media_type": {"$ref": "#/$defs/text128"}}},
    "absent": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "ABSENT"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["kind", "blob_sigil", "size_bytes", "executable"], "properties": {"kind": {"const": "FILE"}, "blob_sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "executable": {"type": "boolean"}}},
    "directory": {"type": "object", "additionalProperties": false, "required": ["kind", "entry_sigil"], "properties": {"kind": {"const": "DIRECTORY"}, "entry_sigil": {"$ref": "#/$defs/sigil"}}},
    "symlink": {"type": "object", "additionalProperties": false, "required": ["kind", "target", "target_sigil"], "properties": {"kind": {"const": "SYMLINK"}, "target": {"$ref": "#/$defs/text4096"}, "target_sigil": {"$ref": "#/$defs/sigil"}}},
    "entryIdentity": {"oneOf": [{"$ref": "#/$defs/absent"}, {"$ref": "#/$defs/file"}, {"$ref": "#/$defs/directory"}, {"$ref": "#/$defs/symlink"}]},
    "checkpointEntry": {"type": "object", "additionalProperties": false, "required": ["path_bytes", "preimage", "checkpoint_blob", "verification_sigil"], "properties": {"path_bytes": {"$ref": "#/$defs/path"}, "preimage": {"$ref": "#/$defs/entryIdentity"}, "checkpoint_blob": {"anyOf": [{"$ref": "#/$defs/blob"}, {"type": "null"}]}, "verification_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

