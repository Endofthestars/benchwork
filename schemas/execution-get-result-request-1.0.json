{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-get-result-request/1.0",
  "title": "Execution Get Result Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id"],
  "properties": {
    "schema_version": {"const": "execution-get-result-request/1.0"},
    "job_id": {
      "type": "string",
      "pattern": "^JB-[A-F0-9]{64}$",
      "minLength": 67,
      "maxLength": 67
    }
  }
}
