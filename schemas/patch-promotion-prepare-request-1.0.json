{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://benchwork.dev/schemas/patch-promotion-prepare-request/1.0", "title":"Patch Promotion Prepare Request v1", "description":"Closed RFC-0014 patch-promotion-prepare-request/1.0 contract-only request. Validation does not resolve references, token, clock, or idempotency state.", "type":"object", "additionalProperties":false,
  "required":["schema_version","request_id","kind","proposal","validation_policy","validation_evidence","target_state_evidence","adapter","mode","recovery","abandoned_lineage","actor","host","requested_at","idempotency_key","request_sigil"],
  "properties":{"schema_version":{"const":"patch-promotion-prepare-request/1.0"},"request_id":{"$ref":"#/$defs/pmr"},"kind":{"enum":["PROMOTE","RECOVER_PARTIAL"]},"proposal":{"$ref":"#/$defs/ppRef"},"validation_policy":{"$ref":"#/$defs/pvpRef"},"validation_evidence":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/pveRef"}},"target_state_evidence":{"$ref":"#/$defs/ptseRef"},"adapter":{"$ref":"#/$defs/ppaRef"},"mode":{"enum":["FULL_TREE_ATOMIC_CAS","PER_ENTRY_GENERATIONAL_CAS"]},"recovery":{"anyOf":[{"$ref":"https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/recovery"},{"type":"null"}]},"abandoned_lineage":{"anyOf":[{"$ref":"https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/abandoned"},{"type":"null"}]},"actor":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/actor"},"host":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/host"},"requested_at":{"$ref":"#/$defs/timestamp"},"idempotency_key":{"$ref":"#/$defs/text256"},"request_sigil":{"$ref":"#/$defs/sigil"}},
  "allOf":[{"if":{"properties":{"kind":{"const":"RECOVER_PARTIAL"}}},"then":{"properties":{"recovery":{"$ref":"https://benchwork.dev/schemas/patch-promotion-authorization/1.0#/$defs/recovery"},"abandoned_lineage":{"type":"null"}}}},{"if":{"properties":{"kind":{"const":"PROMOTE"}}},"then":{"properties":{"recovery":{"type":"null"}}}}],
  "$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"text256":{"type":"string","minLength":0,"maxLength":256,"pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]*$","not":{"pattern":"[\\r\\n]"}},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"pmr":{"type":"string","pattern":"^PMR-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"pp":{"type":"string","pattern":"^PP-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":4,"maxLength":128},"pvp":{"type":"string","pattern":"^PVP-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"pve":{"type":"string","pattern":"^PVE-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"ptse":{"type":"string","pattern":"^PTSE-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":6,"maxLength":128},"ppa":{"type":"string","pattern":"^PPA-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"ref":{"type":"object","additionalProperties":false,"required":["id","sigil"],"properties":{"id":{"type":"string"},"sigil":{"$ref":"#/$defs/sigil"}}},"ppRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/pp"}}}]},"pvpRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/pvp"}}}]},"pveRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/pve"}}}]},"ptseRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/ptse"}}}]},"ppaRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/ppa"}}}]}}
}

