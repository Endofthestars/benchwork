{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/run/1.0",
  "title": "Experimental Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "program_id", "protocol_id", "experiment_id", "status", "analysis_included", "seed", "metrics", "artifacts"],
  "properties": {
    "schema_version": {"const": "run/1.0"},
    "run_id": {"type": "string", "pattern": "^RUN-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "protocol_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/protocol_id"},
    "experiment_id": {"type": "string", "pattern": "^EX-"},
    "status": {"enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED", "LOST"]},
    "analysis_included": {"type": "boolean"},
    "seed": {"type": ["integer", "null"]},
    "metrics": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "number"}
    },
    "artifacts": {"type": "array", "items": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/artifact_ref"}}
  },
  "allOf": [
    {
      "if": {"properties": {"analysis_included": {"const": true}}},
      "then": {
        "properties": {
          "status": {"const": "COMPLETED"},
          "metrics": {"minProperties": 1}
        }
      }
    }
  ]
}
