{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-validation-policy/1.0",
  "title": "Patch Validation Policy v1",
  "description": "Closed RFC-0014 patch-validation-policy/1.0 contract-only record. Validation does not resolve assurance, environment, validator, independence, or selected Evidence claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "required_checks", "optional_checks", "minimum_assurance", "independence", "environment_rules", "limits", "policy_sigil"],
  "properties": {
    "schema_version": {"const": "patch-validation-policy/1.0"}, "policy_id": {"$ref": "#/$defs/pvp"}, "policy_version": {"$ref": "#/$defs/text64"},
    "required_checks": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement"}}, "optional_checks": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement"}},
    "minimum_assurance": {"$ref": "#/$defs/assurance"}, "independence": {"$ref": "#/$defs/independence"}, "environment_rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/environment"}}, "limits": {"$ref": "#/$defs/limits"}, "policy_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}, "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text64": {"type": "string", "minLength": 0, "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text128": {"type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "pvp": {"type": "string", "pattern": "^PVP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["check_id", "check_type", "required_status", "assurance_level", "validator_profile_sigil", "environment_profile_sigil", "timeout_seconds"], "properties": {"check_id": {"$ref": "#/$defs/text128"}, "check_type": {"enum": ["COMMAND", "STATIC_ANALYSIS", "TEST", "LOCAL_REVIEW", "EXTERNAL_REVIEW", "CUSTOM"]}, "required_status": {"const": "PASS"}, "assurance_level": {"$ref": "#/$defs/text64"}, "validator_profile_sigil": {"$ref": "#/$defs/sigil"}, "environment_profile_sigil": {"$ref": "#/$defs/sigil"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}},
    "assurance": {"type": "object", "additionalProperties": false, "required": ["minimum_level", "assurance_profile_sigil", "control_evidence_profile_sigil"], "properties": {"minimum_level": {"$ref": "#/$defs/text64"}, "assurance_profile_sigil": {"$ref": "#/$defs/sigil"}, "control_evidence_profile_sigil": {"$ref": "#/$defs/sigil"}}},
    "independence": {"type": "object", "additionalProperties": false, "required": ["mode", "minimum_distinct_validators"], "properties": {"mode": {"enum": ["SAME_VALIDATOR_ALLOWED", "DISTINCT_VALIDATOR", "DISTINCT_CIRCLE", "EXTERNAL"]}, "minimum_distinct_validators": {"type": "integer", "minimum": 1, "maximum": 4096}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["rule_id", "kind", "value_sigil", "required"], "properties": {"rule_id": {"$ref": "#/$defs/text128"}, "kind": {"enum": ["REQUIRE", "FORBID", "MATCH"]}, "value_sigil": {"$ref": "#/$defs/sigil"}, "required": {"type": "boolean"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_checks", "max_log_refs", "max_result_artifacts", "max_runtime_seconds"], "properties": {"max_checks": {"type": "integer", "minimum": 1, "maximum": 4096}, "max_log_refs": {"type": "integer", "minimum": 0, "maximum": 256}, "max_result_artifacts": {"type": "integer", "minimum": 0, "maximum": 4096}, "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}}
  }
}

