{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/capability-registry/2.0",
  "title": "Sanctum Capability Registry v2",
  "description": "Structural contract for RFC-0011 capability-registry/2.0. Map-key order, self-Sigil validation, embedded Capability semantics, and prior-revision resolution are semantic requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_revision", "created_at", "supersedes_registry_sigil", "capabilities", "registry_sigil"],
  "properties": {
    "schema_version": {"const": "capability-registry/2.0"},
    "registry_id": {"$ref": "#/$defs/registryId"},
    "registry_revision": {"$ref": "#/$defs/u63"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "supersedes_registry_sigil": {"anyOf": [{"$ref": "#/$defs/sigil"}, {"type": "null"}]},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {"$ref": "#/$defs/capabilityId"},
      "additionalProperties": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0"}
    },
    "registry_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {
      "if": {"properties": {"registry_revision": {"const": 0}}, "required": ["registry_revision"]},
      "then": {"properties": {"supersedes_registry_sigil": {"type": "null"}}},
      "else": {"properties": {"supersedes_registry_sigil": {"$ref": "#/$defs/sigil"}}}
    }
  ],
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]Z$", "minLength": 20, "maxLength": 20},
    "capabilityId": {"type": "string", "pattern": "^bench[.][a-z0-9]+(?:[.][a-z0-9]+)+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 9, "maxLength": 128},
    "registryId": {"type": "string", "pattern": "^CR-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}
  }
}

