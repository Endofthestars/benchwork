{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://benchwork.dev/schemas/patch-promotion-prepare-response/1.0", "title":"Patch Promotion Prepare Response v1", "description":"Closed RFC-0014 patch-promotion-prepare-response/1.0 contract-only response. The confirmation token is present only for the response Sigil's redacted projection.", "type":"object", "additionalProperties":false,
  "required":["schema_version","preview","confirmation_token","journal_event_id","journal_event_sigil","response_sigil"],
  "properties":{"schema_version":{"const":"patch-promotion-prepare-response/1.0"},"preview":{"$ref":"https://benchwork.dev/schemas/patch-promotion-preview/1.0"},"confirmation_token":{"$ref":"#/$defs/token"},"journal_event_id":{"$ref":"#/$defs/pje"},"journal_event_sigil":{"$ref":"#/$defs/sigil"},"response_sigil":{"$ref":"#/$defs/sigil"}},
  "$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"token":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$","minLength":43,"maxLength":43},"pje":{"type":"string","pattern":"^PJE-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128}}
}

