{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/sanctum-assurance-profile/1.0",
  "title": "Sanctum Assurance Profile v1",
  "description": "Structural contract for RFC-0012 sanctum-assurance-profile/1.0. Canonical ordering, level and suite self-Sigils, and matrix minima are semantic requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "levels", "conformance_suites", "profile_sigil"],
  "properties": {
    "schema_version": {"const": "sanctum-assurance-profile/1.0"},
    "profile_version": {"$ref": "#/$defs/version"},
    "levels": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/a0Level"}, {"$ref": "#/$defs/a1Level"}, {"$ref": "#/$defs/a2Level"}
      ],
      "items": false
    },
    "conformance_suites": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/conformanceSuite"}},
    "profile_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+(?:[.][0-9]+)?$", "not": {"pattern": "[\\r\\n]"}, "minLength": 3, "maxLength": 32},
    "suiteId": {"type": "string", "pattern": "^CS-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "level": {"enum": ["SANCTUM-A0", "SANCTUM-A1", "SANCTUM-A2"]},
    "state": {"enum": ["ANY_RECORDED", "OBSERVED", "VERIFIED", "ENFORCED"]},
    "dimension": {"enum": ["IDENTITY_AUTHORIZATION", "FILESYSTEM", "NETWORK", "PROCESS_EXECUTABLE", "RESOURCE", "ENVIRONMENT_CREDENTIAL", "LOG_OUTPUT_CAPTURE", "RUNTIME_INPUT_OUTPUT_IDENTITY", "CANCELLATION_FENCING", "TERMINATION_CLEANUP"]},
    "evidenceKind": {"enum": ["TASK_BINDING", "CAPABILITY_BINDING", "SNAPSHOT_BINDING", "WARD_DECISION", "APPROVAL_RECEIPT", "BACKEND_CONFIGURATION", "HOST_IDENTITY", "POLICY_RESOLUTION", "BASE_IDENTITY", "INPUT_IDENTITY", "MATERIALIZATION_IDENTITY", "ENVIRONMENT_CONSTRUCTION", "FILESYSTEM_POLICY", "NETWORK_POLICY", "EXECUTABLE_SELECTION", "PROCESS_TREE", "WALL_TIME_ENFORCEMENT", "RESOURCE_ACCOUNTING", "CREDENTIAL_NONINHERITANCE", "LOG_CAPTURE", "OUTPUT_VALIDATION", "STORAGE_OBSERVATION", "FENCE_TOMBSTONE", "TERMINATION", "HANDLE_REVOCATION", "CLEANUP", "QUARANTINE", "TERMINAL_SOURCE_VERIFICATION", "CONFORMANCE_FIXTURE"]},
    "controlRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["control_dimension", "required_state", "required_evidence_kinds", "requirement_evidence_profile_sigil"],
      "properties": {
        "control_dimension": {"$ref": "#/$defs/dimension"}, "required_state": {"$ref": "#/$defs/state"},
        "required_evidence_kinds": {"type": "array", "minItems": 1, "maxItems": 29, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceKind"}},
        "requirement_evidence_profile_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "levelBase": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "rank", "name", "threat_model_sigil", "control_requirements", "level_sigil"],
      "properties": {
        "level": {"$ref": "#/$defs/level"}, "rank": {"type": "integer", "minimum": 0, "maximum": 2},
        "name": {"enum": ["DECLARED_ATTEMPT", "SUPERVISED", "ISOLATED"]}, "threat_model_sigil": {"$ref": "#/$defs/sigil"},
        "control_requirements": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/controlRequirement"}},
        "level_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "a0Level": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"level": {"const": "SANCTUM-A0"}, "rank": {"const": 0}, "name": {"const": "DECLARED_ATTEMPT"}}, "required": ["level", "rank", "name"]}]},
    "a1Level": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"level": {"const": "SANCTUM-A1"}, "rank": {"const": 1}, "name": {"const": "SUPERVISED"}}, "required": ["level", "rank", "name"]}]},
    "a2Level": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"level": {"const": "SANCTUM-A2"}, "rank": {"const": 2}, "name": {"const": "ISOLATED"}}, "required": ["level", "rank", "name"]}]},
    "conformanceSuite": {
      "type": "object", "additionalProperties": false,
      "required": ["conformance_suite_id", "suite_version", "level", "backend_constraints_sigil", "host_constraints_sigil", "fixture_set_sigil", "evidence_oracle_sigil", "conformance_suite_sigil"],
      "properties": {
        "conformance_suite_id": {"$ref": "#/$defs/suiteId"}, "suite_version": {"$ref": "#/$defs/version"}, "level": {"$ref": "#/$defs/level"},
        "backend_constraints_sigil": {"$ref": "#/$defs/sigil"}, "host_constraints_sigil": {"$ref": "#/$defs/sigil"}, "fixture_set_sigil": {"$ref": "#/$defs/sigil"}, "evidence_oracle_sigil": {"$ref": "#/$defs/sigil"}, "conformance_suite_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

