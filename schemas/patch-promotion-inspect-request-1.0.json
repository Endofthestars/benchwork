{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-inspect-request/1.0",
  "title": "Patch Promotion Inspect Request v1",
  "description": "Closed RFC-0014 contract-only read request. Validation checks wire syntax only and does not resolve a Journal prefix or return records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selector", "page_size", "cursor", "fixed_prefix", "request_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-inspect-request/1.0"},
    "selector": {"oneOf": [
      {"$ref": "#/$defs/proposal"}, {"$ref": "#/$defs/preview"}, {"$ref": "#/$defs/decision"},
      {"$ref": "#/$defs/promotion_attempt"}, {"$ref": "#/$defs/recovery_attempt"},
      {"$ref": "#/$defs/promotion_outcome"}, {"$ref": "#/$defs/recovery_record"}
    ]},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 256},
    "cursor": {"anyOf": [{"$ref": "#/$defs/text512"}, {"type": "null"}]},
    "fixed_prefix": {"anyOf": [{"$ref": "#/$defs/journal_prefix"}, {"type": "null"}]},
    "request_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [{
    "if": {"properties": {"cursor": {"type": "string"}}},
    "then": {"properties": {"fixed_prefix": {"$ref": "#/$defs/journal_prefix"}}}
  }],
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "text512": {"type": "string", "minLength": 0, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}},
    "pp": {"type": "string", "pattern": "^PP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "prv": {"type": "string", "pattern": "^PRV-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "pat": {"type": "string", "pattern": "^PAT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "pra": {"type": "string", "pattern": "^PRA-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "po": {"type": "string", "pattern": "^PO-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "prr": {"type": "string", "pattern": "^PRR-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["kind", "proposal_id"], "properties": {"kind": {"const": "PROPOSAL"}, "proposal_id": {"$ref": "#/$defs/pp"}}},
    "preview": {"type": "object", "additionalProperties": false, "required": ["kind", "preview_id"], "properties": {"kind": {"const": "PREVIEW"}, "preview_id": {"$ref": "#/$defs/prv"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["kind", "preview_id"], "properties": {"kind": {"const": "DECISION"}, "preview_id": {"$ref": "#/$defs/prv"}}},
    "promotion_attempt": {"type": "object", "additionalProperties": false, "required": ["kind", "attempt_id"], "properties": {"kind": {"const": "PROMOTION_ATTEMPT"}, "attempt_id": {"$ref": "#/$defs/pat"}}},
    "recovery_attempt": {"type": "object", "additionalProperties": false, "required": ["kind", "recovery_attempt_id"], "properties": {"kind": {"const": "RECOVERY_ATTEMPT"}, "recovery_attempt_id": {"$ref": "#/$defs/pra"}}},
    "promotion_outcome": {"type": "object", "additionalProperties": false, "required": ["kind", "outcome_id"], "properties": {"kind": {"const": "PROMOTION_OUTCOME"}, "outcome_id": {"$ref": "#/$defs/po"}}},
    "recovery_record": {"type": "object", "additionalProperties": false, "required": ["kind", "recovery_record_id"], "properties": {"kind": {"const": "RECOVERY_RECORD"}, "recovery_record_id": {"$ref": "#/$defs/prr"}}},
    "journal_prefix": {"type": "object", "additionalProperties": false, "required": ["head", "state_sigil"], "properties": {"head": {"$ref": "https://benchwork.dev/schemas/patch-promotion-journal-head/1.0"}, "state_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

