{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-heartbeat-raw-frame/1.0",
  "title": "Execution Heartbeat Raw Frame v1",
  "description": "Closed RFC-0012 H8 immutable raw-frame record. Structural validity and pure resolution do not prove protected-channel authority, committed package visibility, collision-gate disposition, Heartbeat admission, or Journal/State effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "raw_frame_record_id",
    "owner_kind",
    "owner_id",
    "message_kind",
    "received_bytes_sigil",
    "received_size_bytes",
    "first_received_at",
    "first_authenticated_ingress_binding",
    "raw_frame_record_sigil"
  ],
  "properties": {
    "schema_version": {"const": "execution-heartbeat-raw-frame/1.0"},
    "raw_frame_record_id": {"$ref": "#/$defs/rawFrameRecordId"},
    "owner_kind": {"enum": ["WORKER_SESSION", "LEASE"]},
    "owner_id": {"type": "string"},
    "message_kind": {"enum": ["WORKER_SESSION_HEARTBEAT", "LEASE_HEARTBEAT"]},
    "received_bytes_sigil": {"$ref": "#/$defs/sigil"},
    "received_size_bytes": {"$ref": "#/$defs/u63"},
    "first_received_at": {"$ref": "#/$defs/timestamp"},
    "first_authenticated_ingress_binding": {"$ref": "#/$defs/firstAuthenticatedIngressBinding"},
    "raw_frame_record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "allOf": [
    {
      "if": {"properties": {"owner_kind": {"const": "WORKER_SESSION"}}, "required": ["owner_kind"]},
      "then": {
        "properties": {
          "owner_id": {"$ref": "#/$defs/workerSessionId"},
          "message_kind": {"const": "WORKER_SESSION_HEARTBEAT"}
        }
      }
    },
    {
      "if": {"properties": {"owner_kind": {"const": "LEASE"}}, "required": ["owner_kind"]},
      "then": {
        "properties": {
          "owner_id": {"$ref": "#/$defs/leaseId"},
          "message_kind": {"const": "LEASE_HEARTBEAT"}
        }
      }
    }
  ],
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "u63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "workerSessionId": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},
    "leaseId": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
    "rawFrameRecordId": {
      "type": "string",
      "pattern": "^HFR-[0-9A-F]{64}$",
      "minLength": 68,
      "maxLength": 68
    },
    "authenticatedIngressRecordId": {
      "type": "string",
      "pattern": "^HAI-[0-9A-F]{64}$",
      "minLength": 68,
      "maxLength": 68
    },
    "installManifestId": {
      "type": "string",
      "pattern": "^HMI-[0-9A-F]{64}$",
      "minLength": 68,
      "maxLength": 68
    },
    "firstAuthenticatedIngressBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated_ingress_record_id",
        "authenticated_ingress_record_sigil",
        "envelope_canonical_bytes_sigil",
        "install_manifest_id",
        "install_manifest_sigil"
      ],
      "properties": {
        "authenticated_ingress_record_id": {"$ref": "#/$defs/authenticatedIngressRecordId"},
        "authenticated_ingress_record_sigil": {"$ref": "#/$defs/sigil"},
        "envelope_canonical_bytes_sigil": {"$ref": "#/$defs/sigil"},
        "install_manifest_id": {"$ref": "#/$defs/installManifestId"},
        "install_manifest_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

