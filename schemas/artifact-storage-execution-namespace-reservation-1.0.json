{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-reservation/1.0",
  "title": "Artifact Storage Execution Namespace Reservation v1",
  "description": "Closed RFC-0013 embedded ST/SA namespace reservation leaf. This contract does not define a standalone visibility path, replacement index, allocation, append, locking, or recovery authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace_reservation_id", "reservation_key_sigil", "job_id", "attempt_id", "attempt_binding_sigil", "lease_id", "lease_binding_sigil", "worker_id", "worker_session_id", "worker_session_binding_sigil", "executor_epoch", "fence_tuple", "preallocation_event_id", "preallocation_binding_sigil", "storage_subject_id", "output_handle_id", "transfer_id", "transfer_attempt_id", "authorized_maximum_bytes", "reserved_at", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-execution-namespace-reservation/1.0"},
    "namespace_reservation_id": {"$ref": "#/$defs/namespaceReservationId"},
    "reservation_key_sigil": {"$ref": "#/$defs/sigil"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "attempt_binding_sigil": {"$ref": "#/$defs/sigil"},
    "lease_id": {"$ref": "https://benchwork.dev/schemas/execution-lease/1.0#/$defs/leaseId"},
    "lease_binding_sigil": {"$ref": "#/$defs/sigil"},
    "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},
    "worker_session_id": {"$ref": "https://benchwork.dev/schemas/execution-worker-session/1.0#/$defs/workerSessionId"},
    "worker_session_binding_sigil": {"$ref": "#/$defs/sigil"},
    "executor_epoch": {"$ref": "#/$defs/u64"},
    "fence_tuple": {"$ref": "https://benchwork.dev/schemas/execution-state/1.0#/$defs/public_fence_tuple"},
    "preallocation_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"},
    "preallocation_binding_sigil": {"$ref": "#/$defs/sigil"},
    "storage_subject_id": {"$ref": "#/$defs/sigil"},
    "output_handle_id": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/opaque"},
    "transfer_id": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferId"},
    "transfer_attempt_id": {"$ref": "https://benchwork.dev/schemas/artifact-transfer-attempt/1.0#/$defs/transferAttemptId"},
    "authorized_maximum_bytes": {"$ref": "#/$defs/positiveU63"},
    "reserved_at": {"$ref": "#/$defs/timestamp"},
    "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "namespaceReservationId": {"type": "string", "pattern": "^SNR-[0-9A-F]{64}$", "minLength": 68, "maxLength": 68}
  }
}

