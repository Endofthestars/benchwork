{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/actor/1.0",
  "title": "Audit Actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "actor_type", "host", "authenticated_by"],
  "properties": {
    "actor_id": {"type": "string", "minLength": 1},
    "actor_type": {"enum": ["human", "policy", "tool", "agent"]},
    "host": {"enum": ["cli", "codex", "claude-code"]},
    "authenticated_by": {"type": "string", "minLength": 1}
  }
}
