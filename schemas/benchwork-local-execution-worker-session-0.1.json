{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/benchwork-local-execution-worker-session/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_session_id",
    "worker_id",
    "worker_binding_sigil",
    "executor_instance_id",
    "executor_epoch",
    "maximum_concurrency",
    "opened_at",
    "worker_session_binding_sigil"
  ],
  "properties": {
    "schema_version": {"const": "benchwork-local-execution-worker-session/0.1"},
    "worker_session_id": {"type": "string", "pattern": "^WS-[A-Z0-9][A-Z0-9._-]*$"},
    "worker_id": {"type": "string", "pattern": "^WK-[A-Z0-9][A-Z0-9._-]*$"},
    "worker_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executor_instance_id": {"type": "string", "pattern": "^XI-[A-Z0-9][A-Z0-9._-]*$"},
    "executor_epoch": {"type": "integer", "minimum": 1},
    "maximum_concurrency": {"const": 1},
    "opened_at": {"type": "string", "format": "date-time"},
    "worker_session_binding_sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

