{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-journal-head/1.0",
  "title": "Execution Journal Head v1",
  "description": "Closed RFC-0012 execution-journal-head/1.0 cache record. Exact event-prefix and replay validation are outside this contract-only Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limit_profile", "journal_id", "last_sequence", "last_event_id", "last_event_sigil", "updated_at", "head_sigil"],
  "properties": {
    "schema_version": {"const": "execution-journal-head/1.0"},
    "limit_profile": {"const": "EXECUTION_JOURNAL_V1_FIXED_LIMITS"},
    "journal_id": {"$ref": "#/$defs/journalId"},
    "last_sequence": {"$ref": "#/$defs/positiveU63"},
    "last_event_id": {"$ref": "#/$defs/eventId"},
    "last_event_sigil": {"$ref": "#/$defs/sigil"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "head_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "journalId": {"type": "string", "pattern": "^EJ-[A-Z0-9]+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "eventId": {"type": "string", "pattern": "^JE-[A-Z0-9]+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27}
  }
}

