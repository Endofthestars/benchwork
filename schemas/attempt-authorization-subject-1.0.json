{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0",
  "title": "Attempt Authorization Subject v1",
  "description": "Closed RFC-0012 per-Attempt authorization subject. Effect ordering, content-derived ID, and self-Sigil are semantic requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_subject_id", "job_id", "job_binding_sigil", "attempt_id", "attempt_binding_sigil", "retry_ordinal", "specification_id", "specification_sigil", "effects", "authorization_subject_sigil"],
  "properties": {
    "schema_version": {"const": "attempt-authorization-subject/1.0"},
    "authorization_subject_id": {"$ref": "#/$defs/authorizationSubjectId"},
    "job_id": {"$ref": "#/$defs/jobId"},
    "job_binding_sigil": {"$ref": "#/$defs/sigil"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "attempt_binding_sigil": {"$ref": "#/$defs/sigil"},
    "retry_ordinal": {"$ref": "#/$defs/positiveU63"},
    "specification_id": {"$ref": "#/$defs/specificationId"},
    "specification_sigil": {"$ref": "#/$defs/sigil"},
    "effects": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/effect"}},
    "authorization_subject_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "authorizationSubjectId": {"type": "string", "pattern": "^AA-[0-9A-F]{64}$", "minLength": 67, "maxLength": 67},
    "jobId": {"type": "string", "pattern": "^JB-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "attemptId": {"type": "string", "pattern": "^AT-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "specificationId": {"type": "string", "pattern": "^ES-[A-Z0-9]+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "sideEffectId": {"type": "string", "pattern": "^SE-[A-Z0-9]+(?:[._-][A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "effect": {"type": "object", "additionalProperties": false, "required": ["side_effect_id", "authority_sigil"], "properties": {"side_effect_id": {"$ref": "#/$defs/sideEffectId"}, "authority_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

