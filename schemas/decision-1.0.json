{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/decision/1.0",
  "title": "Scientific Decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "program_id", "outcome", "assessment_ids", "rationale"],
  "properties": {
    "schema_version": {"const": "decision/1.0"},
    "decision_id": {"type": "string", "pattern": "^DE-"},
    "program_id": {"$ref": "common-definitions-1.0.json#/$defs/program_id"},
    "outcome": {"enum": ["CONTINUE", "REPAIR", "PIVOT", "STOP", "INSUFFICIENT_EVIDENCE", "REVIEW_REQUIRED"]},
    "assessment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AS-"}},
    "rationale": {"type": "string", "minLength": 1}
  }
}
