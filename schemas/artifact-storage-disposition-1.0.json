{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://benchwork.dev/schemas/artifact-storage-disposition/1.0","title":"Artifact Storage Disposition v1","description":"Closed RFC-0013 artifact-storage-disposition/1.0 authorization wire contract; local validation only.","type":"object","additionalProperties":false,
  "required":["schema_version","disposition_id","target_kind","target_id","target_generation","expected_blob_sigil","expected_size_or_bound","reason_code","actor_id","policy_sigil","approval_evidence_sigil","authorization_sigil","authorized_at","expires_at","idempotency_key_sigil","record_sigil"],
  "properties":{"schema_version":{"const":"artifact-storage-disposition/1.0"},"disposition_id":{"$ref":"#/$defs/dispositionId"},"target_kind":{"enum":["STAGING","MATERIALIZATION_STAGING","MATERIALIZATION_DESTINATION","QUARANTINE"]},"target_id":{"$ref":"#/$defs/opaque"},"target_generation":{"$ref":"#/$defs/opaque"},"expected_blob_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"expected_size_or_bound":{"$ref":"#/$defs/expectedSizeOrBound"},"reason_code":{"$ref":"#/$defs/reasonCode"},"actor_id":{"$ref":"#/$defs/opaque"},"policy_sigil":{"$ref":"#/$defs/sigil"},"approval_evidence_sigil":{"$ref":"#/$defs/sigil"},"authorization_sigil":{"$ref":"#/$defs/sigil"},"authorized_at":{"$ref":"#/$defs/timestamp"},"expires_at":{"$ref":"#/$defs/timestamp"},"idempotency_key_sigil":{"$ref":"#/$defs/sigil"},"record_sigil":{"$ref":"#/$defs/sigil"}},
  "$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"u63":{"type":"integer","minimum":0,"maximum":9223372036854775807},"opaque":{"type":"string","pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","minLength":1,"maxLength":256},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"dispositionId":{"type":"string","pattern":"^SD-[A-Za-z0-9][A-Za-z0-9._:-]*$","not":{"pattern":"[\\r\\n]"},"minLength":4,"maxLength":128},"expectedSizeOrBound":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","size_bytes"],"properties":{"kind":{"const":"EXACT"},"size_bytes":{"$ref":"#/$defs/u63"}}},{"type":"object","additionalProperties":false,"required":["kind","max_size_bytes"],"properties":{"kind":{"const":"UPPER_BOUND"},"max_size_bytes":{"$ref":"#/$defs/u63"}}}]},"reasonCode":{"enum":["AUTHORIZATION_DENIED","BACKEND_AMBIGUOUS","BACKEND_CONFLICT","BACKEND_UNAVAILABLE","BOUNDS_EXCEEDED","CANCELLED","CHRONICLE_REFERENCE_CHANGED","CLOCK_UNCERTAIN","CONFLICT","CORRUPT","DESTINATION_CONFLICT","DISPOSITION_EXPIRED","DURABILITY_UNVERIFIED","EXECUTION_HOLD_LIFETIME_EXPIRED","EXECUTION_ROOT_ORPHAN_ABORTED","EXECUTION_ROOT_OWNER_TERMINATED","FENCE_REJECTED","GC_ROOT_CHANGED","GENERATION_MISMATCH","HASH_MISMATCH","INTEGRITY_FAILURE","INVALID_MESSAGE","LEASE_EXPIRED","LEGACY_PROTECTION_FAILED","MINIMUM_REPLICA_VIOLATION","OPERATIONAL_ROOT_TERMINATED","PAYLOAD_LOST","POLICY_REJECTED","QUARANTINE_RESERVATION_FAILED","QUOTA_EXHAUSTED","RECOVERY_INTERRUPTED_PRECOMMIT","RECOVERY_PAYLOAD_LOST","RETENTION_BLOCKED","SOURCE_CHANGED","TAIL_INCOMPLETE","TIMEOUT","UNKNOWN_SCHEMA","UNSAFE_PATH","VERIFICATION_FAILED"]}}
