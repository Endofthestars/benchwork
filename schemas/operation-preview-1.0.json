{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/operation-preview/1.0",
  "title": "Immutable Operation Preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "operation",
    "target_id",
    "arguments",
    "chronicle_head_sigil",
    "content_sigil",
    "changed_fields",
    "gate",
    "required_approval",
    "preview_sigil"
  ],
  "properties": {
    "schema_version": {"const": "operation-preview/1.0"},
    "preview_id": {"type": "string", "pattern": "^PV-[A-Z0-9]+$"},
    "operation": {"enum": ["rq_seal", "protocol_seal", "decision_seal"]},
    "target_id": {"type": "string", "minLength": 1},
    "arguments": {"type": "object"},
    "chronicle_head_sigil": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "content_sigil": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
    },
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["PASS"]},
        "checks": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "required_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confirmation_token"],
      "properties": {
        "kind": {"const": "explicit-human-confirmation"},
        "confirmation_token": {"type": "string", "minLength": 1}
      }
    },
    "preview_sigil": {
      "$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/sigil"
    }
  }
}
