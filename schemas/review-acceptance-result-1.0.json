{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/review-acceptance-result/1.0",
  "allOf": [
    {"$ref": "https://benchwork.dev/schemas/capability-output/1.0"},
    {
      "properties": {
        "schema_version": {"const": "review-acceptance-result/1.0"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "accepted", "rationale"],
          "properties": {
            "review_id": {"type": "string", "pattern": "^RV-"},
            "accepted": {"const": true},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
