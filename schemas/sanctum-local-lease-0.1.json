{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/sanctum-local-lease/0.1",
  "title": "Sanctum Local Lease",
  "description": "Experimental in-memory conformance record; not the RFC-0012 execution-lease/1.0 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "job_id", "worker_id", "fencing_token", "status", "expires_at"],
  "properties": {
    "schema_version": {"const": "sanctum-local-lease/0.1"},
    "lease_id": {"type": "string", "pattern": "^LS-[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "job_id": {"type": "string", "pattern": "^JB-[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "worker_id": {"type": "string", "pattern": "^WK-[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ACTIVE", "RELEASED", "EXPIRED"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
