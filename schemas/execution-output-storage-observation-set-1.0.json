    "captured_log_content": {"type": "object", "additionalProperties": false, "required": ["kind", "blob_sigil", "storage"], "properties": {"kind": {"const": "CAPTURED"}, "blob_sigil": {"$ref": "#/$defs/sigil"}, "storage": {"$ref": "#/$defs/storage_observation"}}},
    "resource_evidence_none_member": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "RESOURCE_EVIDENCE_NONE"}}},
    "resource_evidence_member": {
