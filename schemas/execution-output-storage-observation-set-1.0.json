      "required": ["kind", "storage_subject_id", "manifest_entry_sigil", "disposition", "terminal_source_identity", "terminal_source_sigil", "storage_blob", "retention_policy_sigil", "file_count", "byte_count", "storage_origin", "storage"],
      "properties": {"kind": {"const": "TERMINAL_SOURCE"}, "storage_subject_id": {"$ref": "#/$defs/sigil"}, "manifest_entry_sigil": {"$ref": "#/$defs/sigil"}, "disposition": {"enum": ["VERIFIED", "QUARANTINED"]}, "terminal_source_identity": {"$ref": "https://benchwork.dev/schemas/benchwork-source-tree/1.0#/$defs/sourceTreeId"}, "terminal_source_sigil": {"$ref": "#/$defs/sigil"}, "storage_blob": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/blobRef"}, "retention_policy_sigil": {"$ref": "#/$defs/sigil"}, "file_count": {"$ref": "#/$defs/u63"}, "byte_count": {"$ref": "#/$defs/u63"}, "storage_origin": {"$ref": "https://benchwork.dev/schemas/execution-storage-root-manifest/1.0#/$defs/storageOrigin"}, "storage": {"$ref": "#/$defs/storage_observation"}}
