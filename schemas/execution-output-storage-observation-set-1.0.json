      "properties": {
        "kind": {"const": "RESOURCE_EVIDENCE"}, "storage_subject_id": {"$ref": "#/$defs/sigil"}, "manifest_entry_sigil": {"$ref": "#/$defs/sigil"}, "control_evidence_id": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/controlEvidenceId"}, "control_evidence_sigil": {"$ref": "#/$defs/sigil"}, "control_dimension": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/controlDimension"}, "phase": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/phase"}, "phase_evidence_entry_sigil": {"$ref": "#/$defs/sigil"}, "evidence_kind": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/evidenceKind"}, "producer_identity": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/evidenceIdentity"}, "verifier_identity": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/evidenceIdentity"}, "collected_at": {"$ref": "https://benchwork.dev/schemas/execution-control-evidence/1.0#/$defs/timestamp"}, "byte_size": {"$ref": "#/$defs/u63"}, "blob_sigil": {"$ref": "#/$defs/sigil"}, "storage_origin": {"$ref": "https://benchwork.dev/schemas/execution-storage-root-manifest/1.0#/$defs/storageOrigin"}, "storage": {"$ref": "#/$defs/storage_observation"}
      }
    },
    "terminal_source_not_applicable_member": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "TERMINAL_SOURCE_NOT_APPLICABLE"}}},
    "terminal_source_none_member": {"type": "object", "additionalProperties": false, "required": ["kind", "reason_codes"], "properties": {"kind": {"const": "TERMINAL_SOURCE_NONE"}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/quarantined_terminal_source_binding/properties/reason_codes/items"}}}},
    "terminal_source_member": {
