{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-output-storage-observation-set/1.0",
  "title": "Execution Output Storage Observation Set v1",
  "description": "Closed RFC-0012 contract-only frozen output storage observation. Shape and locally provable identity only; Execution/Storage replay, immutable-record resolution, Blob bytes, Quarantine truth, Replica availability, durable allocation, Journal append, and runtime authority remain external and fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_set_id", "job_id", "attempt_id", "attempt_binding_sigil", "result_binding", "log_closure_sigil", "output_closure_sigil", "control_evidence_set_binding", "quarantine_binding_set_binding", "terminalization_storage_manifest_binding", "output_root_protection", "terminal_source_binding", "storage_event", "storage_state_sigil", "members", "blob_sigils", "observation_set_sigil"],
  "properties": {
    "schema_version": {"const": "execution-output-storage-observation-set/1.0"},
    "observation_set_id": {"$ref": "#/$defs/outputStorageObservationSetId"},
    "job_id": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/jobId"},
    "attempt_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/attemptId"},
    "attempt_binding_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "result_binding": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/result_binding"},
    "log_closure_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "output_closure_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "control_evidence_set_binding": {"$ref": "#/$defs/control_evidence_set_binding"},
    "quarantine_binding_set_binding": {"$ref": "#/$defs/quarantine_binding_set_binding"},
    "terminalization_storage_manifest_binding": {"$ref": "#/$defs/terminalization_storage_manifest_binding"},
    "output_root_protection": {"$ref": "#/$defs/output_root_protection"},
    "terminal_source_binding": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/terminal_source_binding"},
    "storage_event": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"},
    "storage_state_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "members": {"type": "array", "minItems": 6, "maxItems": 4096, "items": {"$ref": "#/$defs/member"}},
    "blob_sigils": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}},
    "observation_set_sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"}
