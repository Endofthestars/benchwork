    "no_storage": {"type": "object", "additionalProperties": false, "required": ["kind", "terminal_storage_status"], "properties": {"kind": {"const": "NONE"}, "terminal_storage_status": {"const": "UNAVAILABLE"}}},
    "blob_storage": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "terminal_storage_status", "blob_sigil", "size_bytes", "blob_record_sigil", "availability", "availability_as_of", "availability_basis_sigil", "integrity_event_sigils", "quarantine", "replica"],
      "properties": {"kind": {"const": "BLOB"}, "terminal_storage_status": {"enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "INCIDENT"]}, "blob_sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "blob_record_sigil": {"$ref": "#/$defs/sigil"}, "availability": {"enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "INCIDENT"]}, "availability_as_of": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"}, "availability_basis_sigil": {"$ref": "#/$defs/sigil"}, "integrity_event_sigils": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sigil"}}, "quarantine": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}}, "replica": {"$ref": "#/$defs/replica_selection"}}
    },
    "replica_selection": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "NONE"}}}, {"$ref": "#/$defs/selected_replica"}]},
    "selected_replica": {"type": "object", "additionalProperties": false, "required": ["kind", "replica_id", "replica_record_sigil", "state", "backend", "object", "verification"], "properties": {"kind": {"const": "SELECTED"}, "replica_id": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/replicaId"}, "replica_record_sigil": {"$ref": "#/$defs/sigil"}, "state": {"const": "AVAILABLE"}, "backend": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/backendRef"}, "object": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/backendObjectRef"}, "verification": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/verificationRef"}}},
    "quarantined_storage": {"$ref": "#/$defs/quarantine_storage_base", "properties": {"kind": {"const": "QUARANTINED"}, "terminal_storage_status": {"const": "QUARANTINED"}, "state": {"enum": ["HELD", "DISPOSAL_FAILED"]}}, "required": ["kind", "terminal_storage_status", "claimed_blob_sigil", "claimed_size_bytes", "quarantine_binding_sigil", "quarantine_id", "owner_kind", "owner_id", "state", "source_object", "destination_object", "quarantine_record_sigil", "quarantine_event", "reason"]},
    "quarantine_terminal_negative_storage": {"$ref": "#/$defs/quarantine_storage_base", "properties": {"kind": {"const": "QUARANTINE_TERMINAL_NEGATIVE"}, "terminal_storage_status": {"const": "UNAVAILABLE"}, "state": {"enum": ["FAILED", "DISPOSAL_FAILED", "DISPOSED"]}}, "required": ["kind", "terminal_storage_status", "claimed_blob_sigil", "claimed_size_bytes", "quarantine_binding_sigil", "quarantine_id", "owner_kind", "owner_id", "state", "source_object", "destination_object", "quarantine_record_sigil", "origin_event", "observation_event", "reason"]},
    "quarantine_storage_base": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"enum": ["QUARANTINED", "QUARANTINE_TERMINAL_NEGATIVE"]}, "terminal_storage_status": {"enum": ["QUARANTINED", "UNAVAILABLE"]}, "claimed_blob_sigil": {"$ref": "#/$defs/sigil"}, "claimed_size_bytes": {"$ref": "#/$defs/u63"}, "quarantine_binding_sigil": {"$ref": "#/$defs/sigil"}, "quarantine_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-state/1.0#/$defs/quarantineId"}, "owner_kind": {"const": "TRANSFER_ATTEMPT"}, "owner_id": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/transferAttemptId"}, "state": {"enum": ["HELD", "FAILED", "DISPOSAL_FAILED", "DISPOSED"]}, "source_object": {"anyOf": [{"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/backendObjectRef"}, {"type": "null"}]}, "destination_object": {"$ref": "https://benchwork.dev/schemas/artifact-provenance/1.0#/$defs/backendObjectRef"}, "quarantine_record_sigil": {"$ref": "#/$defs/sigil"}, "quarantine_event": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"}, "origin_event": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"}, "observation_event": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"}, "reason": {"$ref": "https://benchwork.dev/schemas/artifact-storage-state/1.0#/$defs/reason"}}
    },
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "u63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/u63"}
  }
