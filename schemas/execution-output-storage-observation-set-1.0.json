      "properties": {
        "kind": {"const": "LOG_STREAM"}, "storage_subject_id": {"$ref": "#/$defs/sigil"}, "manifest_entry_sigil": {"$ref": "#/$defs/sigil"}, "stream": {"enum": ["STDOUT", "STDERR", "STRUCTURED"]}, "log_stream_id": {"$ref": "https://benchwork.dev/schemas/execution-attempt/1.0#/$defs/logStreamId"}, "final_sequence": {"anyOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]}, "captured_bytes": {"$ref": "#/$defs/u63"}, "dropped_bytes": {"$ref": "#/$defs/u63"}, "truncated": {"type": "boolean"}, "stream_set_sigil": {"$ref": "#/$defs/sigil"}, "closure_event_id": {"$ref": "https://benchwork.dev/schemas/execution-journal-event/1.0#/$defs/event_id"}, "closure_event_sigil": {"$ref": "#/$defs/sigil"}, "storage_origin": {"$ref": "https://benchwork.dev/schemas/execution-storage-root-manifest/1.0#/$defs/storageOrigin"}, "content": {"$ref": "#/$defs/log_content"}
      }
    },
    "log_content": {"oneOf": [{"$ref": "#/$defs/empty_log_content"}, {"$ref": "#/$defs/captured_log_content"}]},
