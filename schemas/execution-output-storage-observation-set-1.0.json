      "properties": {"kind": {"const": "ATTEMPT_OUTPUTS_NONE"}, "reason": {"enum": ["NO_RESULT", "RESULT_REJECTED", "OUTPUT_ARRAY_EMPTY"]}}
    },
    "attempt_output_member": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "storage_subject_id", "manifest_entry_sigil", "logical_name", "schema_id", "schema_sigil", "staging_reference_sigil", "byte_size", "blob_sigil", "storage_origin", "storage"],
      "properties": {
        "kind": {"const": "ATTEMPT_OUTPUT"}, "storage_subject_id": {"$ref": "#/$defs/sigil"}, "manifest_entry_sigil": {"$ref": "#/$defs/sigil"},
        "logical_name": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/logicalName"}, "schema_id": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/schemaId"}, "schema_sigil": {"$ref": "#/$defs/sigil"}, "staging_reference_sigil": {"$ref": "#/$defs/sigil"}, "byte_size": {"$ref": "#/$defs/u63"}, "blob_sigil": {"$ref": "#/$defs/sigil"},
