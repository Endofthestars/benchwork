{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/attempt-authorization-transition-request/1.0",
  "title": "Attempt Authorization Transition Request v1",
  "description": "Closed RFC-0012 Athanor request for one exact per-Attempt authorization subject. Authenticated invocation-context resolution, durable single assignment, and Event/Receipt resolution remain external conformance checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_request_id", "event_type", "expected_chronicle_head", "authorization_subject", "authority_evidence", "actor", "host_invocation", "chronicle_actor", "idempotency_key_sigil", "requested_at", "transition_request_sigil"],
  "properties": {
    "schema_version": {"const": "attempt-authorization-transition-request/1.0"},
    "transition_request_id": {"$ref": "#/$defs/transitionRequestId"},
    "event_type": {"const": "attempt.authorization.granted"},
    "expected_chronicle_head": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/chronicleHeadRef"},
    "authorization_subject": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0"},
    "authority_evidence": {"$ref": "#/$defs/authorityEvidence"},
    "actor": {"$ref": "https://benchwork.dev/schemas/execution-cancel-request/1.0#/$defs/actor_binding"},
    "host_invocation": {"$ref": "https://benchwork.dev/schemas/execution-cancel-request/1.0#/$defs/host_invocation_binding"},
    "chronicle_actor": {"$ref": "https://benchwork.dev/schemas/actor/1.0"},
    "idempotency_key_sigil": {"$ref": "#/$defs/sigil"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "transition_request_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "transitionRequestId": {"type": "string", "pattern": "^AAT-[A-F0-9]{64}$", "not": {"pattern": "[\\r\\n]"}, "minLength": 68, "maxLength": 68},
    "requestId": {"$ref": "#/$defs/transitionRequestId"},
    "authorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "ward_decision_id", "ward_decision_sigil", "authorization_policy_sigil", "effects"],
      "properties": {
        "purpose": {"const": "ATTEMPT_AUTHORIZATION"},
        "ward_decision_id": {"$ref": "https://benchwork.dev/schemas/execution-specification/1.0#/$defs/wardDecisionId", "not": {"pattern": "[\\r\\n]"}},
        "ward_decision_sigil": {"$ref": "#/$defs/sigil"},
        "authorization_policy_sigil": {"$ref": "#/$defs/sigil"},
        "effects": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "https://benchwork.dev/schemas/attempt-authorization-subject/1.0#/$defs/effect"}}
      }
    }
  }
}
