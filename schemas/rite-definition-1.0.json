{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/rite-definition/1.0",
  "title": "Rite Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rite_id", "description", "stages"],
  "properties": {
    "schema_version": {"const": "rite/1.0"},
    "rite_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "exit_artifact"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "exit_artifact": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
