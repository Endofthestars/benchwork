{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-backend/1.0",
  "title": "Artifact Storage Backend v1",
  "description": "Closed RFC-0013 artifact-storage-backend/1.0 capability record. This contract-only increment validates record shape and local consistency only; it does not probe, register, or resolve a backend, Host, configuration, conformance suite, or evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend_id", "adapter_id", "adapter_version", "protocol_version", "adapter_sigil", "configuration_sigil", "namespace_sigil", "isolation", "limits", "consistency", "durability", "verification_methods", "range_resume", "conditional_operations", "deletion_capabilities", "credential_class", "fencing", "conformance", "record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-backend/1.0"},
    "backend_id": {"$ref": "#/$defs/opaque"}, "adapter_id": {"$ref": "#/$defs/opaque"}, "adapter_version": {"$ref": "#/$defs/opaque"}, "protocol_version": {"$ref": "#/$defs/opaque"},
    "adapter_sigil": {"$ref": "#/$defs/sigil"}, "configuration_sigil": {"$ref": "#/$defs/sigil"}, "namespace_sigil": {"$ref": "#/$defs/sigil"},
    "isolation": {"$ref": "#/$defs/isolation"}, "limits": {"$ref": "#/$defs/limits"}, "consistency": {"$ref": "#/$defs/consistency"}, "durability": {"$ref": "#/$defs/durability"},
    "verification_methods": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["FULL_READBACK_SHA256", "CONFORMANCE_END_TO_END"]}},
    "range_resume": {"$ref": "#/$defs/rangeResume"}, "conditional_operations": {"$ref": "#/$defs/conditionalOperations"}, "deletion_capabilities": {"$ref": "#/$defs/deletionCapabilities"},
    "credential_class": {"enum": ["COORDINATOR_HOST_LOCAL", "COORDINATOR_SCOPED_REMOTE"]}, "fencing": {"$ref": "#/$defs/fencing"}, "conformance": {"$ref": "#/$defs/conformance"}, "record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "positiveU63": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "opaque": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 256},
    "transferBounds": {"type": "object", "additionalProperties": false, "required": ["max_bytes", "max_duration_millis", "max_file_count", "max_chunk_count", "buffer_bytes"], "properties": {"max_bytes": {"$ref": "#/$defs/u63"}, "max_duration_millis": {"$ref": "#/$defs/u63"}, "max_file_count": {"anyOf": [{"$ref": "#/$defs/u63"}, {"type": "null"}]}, "max_chunk_count": {"$ref": "#/$defs/u63"}, "buffer_bytes": {"$ref": "#/$defs/positiveU63"}}},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["scope", "namespace_enforcement", "worker_access", "worker_credentials_exposed"], "properties": {"scope": {"enum": ["SINGLE_PROJECT", "SINGLE_TENANT_PROJECT"]}, "namespace_enforcement": {"enum": ["DESCRIPTOR_RELATIVE_NOFOLLOW", "ADAPTER_SCOPED"]}, "worker_access": {"const": "NONE"}, "worker_credentials_exposed": {"const": false}}},
    "systemReserveLimit": {"type": "object", "additionalProperties": false, "required": ["reserve_class", "max_event_frame_count", "max_control_record_count", "max_recovery_evidence_count", "max_event_frame_bytes", "max_control_record_bytes", "max_recovery_evidence_bytes"], "properties": {"reserve_class": {"enum": ["INITIALIZATION", "COORDINATOR_LIVENESS", "CLOCK_PRESSURE", "CATALOG_ADMINISTRATION", "VERIFICATION_INCIDENT", "RETENTION_REFERENCE", "GC_ADMINISTRATION", "RECOVERY"]}, "max_event_frame_count": {"$ref": "#/$defs/positiveU63"}, "max_control_record_count": {"$ref": "#/$defs/u63"}, "max_recovery_evidence_count": {"$ref": "#/$defs/u63"}, "max_event_frame_bytes": {"type": "integer", "minimum": 56, "maximum": 8388664}, "max_control_record_bytes": {"type": "integer", "minimum": 1, "maximum": 8388664}, "max_recovery_evidence_bytes": {"type": "integer", "minimum": 1, "maximum": 8388664}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_object_bytes", "transfer_bounds", "max_concurrent_streams", "max_inventory_entries", "max_tail_recovery_retries", "system_reserve_limits", "system_journal_reserve_bytes", "system_control_record_reserve_bytes", "system_recovery_reserve_bytes"], "properties": {"max_object_bytes": {"$ref": "#/$defs/u63"}, "transfer_bounds": {"$ref": "#/$defs/transferBounds"}, "max_concurrent_streams": {"$ref": "#/$defs/u63"}, "max_inventory_entries": {"$ref": "#/$defs/u63"}, "max_tail_recovery_retries": {"$ref": "#/$defs/positiveU63"}, "system_reserve_limits": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [{"properties": {"reserve_class": {"const": "INITIALIZATION"}}}, {"properties": {"reserve_class": {"const": "COORDINATOR_LIVENESS"}}}, {"properties": {"reserve_class": {"const": "CLOCK_PRESSURE"}}}, {"properties": {"reserve_class": {"const": "CATALOG_ADMINISTRATION"}}}, {"properties": {"reserve_class": {"const": "VERIFICATION_INCIDENT"}}}, {"properties": {"reserve_class": {"const": "RETENTION_REFERENCE"}}}, {"properties": {"reserve_class": {"const": "GC_ADMINISTRATION"}}}, {"properties": {"reserve_class": {"const": "RECOVERY"}}}], "items": {"$ref": "#/$defs/systemReserveLimit"}}, "system_journal_reserve_bytes": {"$ref": "#/$defs/positiveU63"}, "system_control_record_reserve_bytes": {"$ref": "#/$defs/positiveU63"}, "system_recovery_reserve_bytes": {"$ref": "#/$defs/positiveU63"}}},
    "consistency": {"type": "object", "additionalProperties": false, "required": ["read_after_write", "list_consistency", "atomic_visibility", "immutable_generation", "exact_generation_reads"], "properties": {"read_after_write": {"enum": ["STRONG", "EVENTUAL"]}, "list_consistency": {"enum": ["STRONG", "EVENTUAL"]}, "atomic_visibility": {"type": "boolean"}, "immutable_generation": {"type": "boolean"}, "exact_generation_reads": {"type": "boolean"}}},
    "durability": {"type": "object", "additionalProperties": false, "required": ["commit_semantics", "logical_readback", "transparent_encryption", "transparent_compression"], "properties": {"commit_semantics": {"enum": ["FSYNC_FILE_AND_PARENT", "REMOTE_DURABLE_ACK"]}, "logical_readback": {"type": "boolean"}, "transparent_encryption": {"type": "boolean"}, "transparent_compression": {"type": "boolean"}}},
    "rangeResume": {"type": "object", "additionalProperties": false, "required": ["range_reads", "resumable_stage_writes", "resume_binding"], "properties": {"range_reads": {"type": "boolean"}, "resumable_stage_writes": {"type": "boolean"}, "resume_binding": {"enum": ["UNSUPPORTED", "GENERATION_OFFSET_PREFIX_SIGIL"]}}},
    "conditionalOperations": {"type": "object", "additionalProperties": false, "required": ["conditional_create", "no_overwrite_finalize", "exact_generation_stat", "exact_generation_delete"], "properties": {"conditional_create": {"type": "boolean"}, "no_overwrite_finalize": {"type": "boolean"}, "exact_generation_stat": {"type": "boolean"}, "exact_generation_delete": {"type": "boolean"}}},
    "deletionCapabilities": {"type": "object", "additionalProperties": false, "required": ["exact_generation_delete", "wildcard_delete", "retention_lock", "verification"], "properties": {"exact_generation_delete": {"type": "boolean"}, "wildcard_delete": {"const": false}, "retention_lock": {"enum": ["NONE", "ENFORCED"]}, "verification": {"enum": ["POST_DELETE_STAT", "RECEIPT_AND_RECONCILIATION"]}}},
    "fencing": {"type": "object", "additionalProperties": false, "required": ["mode", "attempt_staging_isolated", "executor_epoch_checked", "job_fence_floor_checked", "tombstone_checked"], "properties": {"mode": {"enum": ["COORDINATOR_PRECOMMIT", "BACKEND_PUBLIC_FENCE"]}, "attempt_staging_isolated": {"type": "boolean"}, "executor_epoch_checked": {"type": "boolean"}, "job_fence_floor_checked": {"type": "boolean"}, "tombstone_checked": {"type": "boolean"}}},
    "conformance": {"type": "object", "additionalProperties": false, "required": ["profile_id", "suite_version", "suite_sigil", "host_platform_sigil", "evidence_sigil"], "properties": {"profile_id": {"enum": ["LOCAL-PHASE3/1.0", "PORTABLE-PHASE4/1.0"]}, "suite_version": {"$ref": "#/$defs/opaque"}, "suite_sigil": {"$ref": "#/$defs/sigil"}, "host_platform_sigil": {"$ref": "#/$defs/sigil"}, "evidence_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

