{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-target-state-evidence/1.0",
  "title": "Patch Target State Evidence v1",
  "description": "Closed RFC-0014 patch-target-state-evidence/1.0 contract-only record. Validation is local and does not resolve a Target, Profile, Verifier, Blob, or assurance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "target_id", "identity_profile", "observed_identity", "target_content_generation", "root_identity", "observed_at", "verifier", "bounds", "evidence_blobs", "evidence_sigil"],
  "properties": {
    "schema_version": {"const": "patch-target-state-evidence/1.0"},
    "evidence_id": {"$ref": "#/$defs/ptse"},
    "target_id": {"$ref": "#/$defs/pt"},
    "identity_profile": {"$ref": "#/$defs/pbipRef"},
    "observed_identity": {"$ref": "#/$defs/tree"},
    "target_content_generation": {"$ref": "#/$defs/text256"},
    "root_identity": {"$ref": "#/$defs/root"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "verifier": {"$ref": "#/$defs/verifier"},
    "bounds": {"$ref": "#/$defs/bounds"},
    "evidence_blobs": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/blob"}},
    "evidence_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text64": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "text128": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "text256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "not": {"pattern": "[\\r\\n]"}},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "ptse": {"type": "string", "pattern": "^PTSE-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128},
    "pt": {"type": "string", "pattern": "^PT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "pbip": {"type": "string", "pattern": "^PBIP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128},
    "pbipRef": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"$ref": "#/$defs/pbip"}, "sigil": {"$ref": "#/$defs/sigil"}}},
    "tree": {"type": "object", "additionalProperties": false, "required": ["manifest_sigil", "root_entry_sigil", "entry_count", "total_bytes"], "properties": {"manifest_sigil": {"$ref": "#/$defs/sigil"}, "root_entry_sigil": {"$ref": "#/$defs/sigil"}, "entry_count": {"type": "integer", "minimum": 0, "maximum": 100000}, "total_bytes": {"$ref": "#/$defs/u63"}}},
    "root": {"type": "object", "additionalProperties": false, "required": ["root_object_sigil", "root_generation", "topology_sigil"], "properties": {"root_object_sigil": {"$ref": "#/$defs/sigil"}, "root_generation": {"$ref": "#/$defs/text256"}, "topology_sigil": {"$ref": "#/$defs/sigil"}}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["verifier_id", "verifier_version", "configuration_sigil", "assurance_sigil"], "properties": {"verifier_id": {"$ref": "#/$defs/text128"}, "verifier_version": {"$ref": "#/$defs/text64"}, "configuration_sigil": {"$ref": "#/$defs/sigil"}, "assurance_sigil": {"$ref": "#/$defs/sigil"}}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_paths", "max_total_bytes", "max_depth", "observed_paths", "observed_bytes"], "properties": {"max_paths": {"type": "integer", "minimum": 1, "maximum": 100000}, "max_total_bytes": {"$ref": "#/$defs/u63"}, "max_depth": {"type": "integer", "minimum": 1, "maximum": 4096}, "observed_paths": {"type": "integer", "minimum": 0, "maximum": 100000}, "observed_bytes": {"$ref": "#/$defs/u63"}}},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sigil", "size_bytes", "media_type"], "properties": {"sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "media_type": {"$ref": "#/$defs/text128"}}}
  }
}

