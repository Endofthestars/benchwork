{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-worker-session/1.0",
  "title": "Execution Worker Session v1",
  "description": "Closed RFC-0012 immutable Worker Session binding. Parent Worker tuple resolution and durable allocation-slot conformance require the semantic resolver.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_session_id", "worker_id", "worker_binding_sigil", "executor_instance_id", "executor_epoch", "host_identity_sigil", "backend_session_identity", "control_channel_identity_sigil", "verified_capability_tuple_sigil", "maximum_concurrency", "opened_at", "worker_session_binding_sigil"],
  "properties": {
    "schema_version": {"const": "execution-worker-session/1.0"},
    "worker_session_id": {"$ref": "#/$defs/workerSessionId"},
    "worker_id": {"$ref": "https://benchwork.dev/schemas/execution-worker/1.0#/$defs/workerId"},
    "worker_binding_sigil": {"$ref": "#/$defs/sigil"},
    "executor_instance_id": {"$ref": "#/$defs/executorInstanceId"},
    "executor_epoch": {"$ref": "#/$defs/u64"},
    "host_identity_sigil": {"$ref": "#/$defs/sigil"},
    "backend_session_identity": {"$ref": "#/$defs/backendSessionIdentity"},
    "control_channel_identity_sigil": {"$ref": "#/$defs/sigil"},
    "verified_capability_tuple_sigil": {"$ref": "#/$defs/sigil"},
    "maximum_concurrency": {"$ref": "#/$defs/positiveU63"},
    "opened_at": {"$ref": "#/$defs/timestamp"},
    "worker_session_binding_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/sigil"},
    "version": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/version"},
    "positiveU63": {"$ref": "https://benchwork.dev/schemas/capability-contract/2.0#/$defs/positiveU63"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "timestamp": {"$ref": "https://benchwork.dev/schemas/execution-job/1.0#/$defs/timestamp"},
    "workerSessionId": {"type": "string", "pattern": "^WS-[0-7][0-9A-HJKMNP-TV-Z]{25}$", "not": {"pattern": "[\\r\\n]"}, "minLength": 29, "maxLength": 29},
    "executorInstanceId": {"type": "string", "pattern": "^XI-[A-Z0-9]+$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128},
    "opaque128": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$", "minLength": 1, "maxLength": 127},
    "backendSessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "backend_version", "backend_implementation_sigil", "backend_configuration_sigil", "process_identity_sigil", "session_nonce_sigil"],
      "properties": {
        "backend_id": {"$ref": "#/$defs/opaque128"},
        "backend_version": {"$ref": "#/$defs/version"},
        "backend_implementation_sigil": {"$ref": "#/$defs/sigil"},
        "backend_configuration_sigil": {"$ref": "#/$defs/sigil"},
        "process_identity_sigil": {"$ref": "#/$defs/sigil"},
        "session_nonce_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}

