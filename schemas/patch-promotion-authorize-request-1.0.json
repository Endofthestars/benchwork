{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://benchwork.dev/schemas/patch-promotion-authorize-request/1.0", "title":"Patch Promotion Authorize Request v1", "description":"Closed RFC-0014 patch-promotion-authorize-request/1.0 request. Its raw confirmation token is redacted from request_sigil input.", "type":"object", "additionalProperties":false,
  "required":["schema_version","request_id","decision","preview","confirmation_token","affirmative_confirmation","reason","actor","host","requested_at","idempotency_key","confirmation_token_sigil","request_sigil"],
  "properties":{"schema_version":{"const":"patch-promotion-authorize-request/1.0"},"request_id":{"$ref":"#/$defs/par"},"decision":{"enum":["AUTHORIZE","REJECT"]},"preview":{"$ref":"#/$defs/prvRef"},"confirmation_token":{"anyOf":[{"$ref":"#/$defs/token"},{"type":"null"}]},"affirmative_confirmation":{"anyOf":[{"const":true},{"type":"null"}]},"reason":{"$ref":"#/$defs/text4096"},"actor":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/actor"},"host":{"$ref":"https://benchwork.dev/schemas/patch-promotion-rejection/1.0#/$defs/host"},"requested_at":{"$ref":"#/$defs/timestamp"},"idempotency_key":{"$ref":"#/$defs/text256"},"confirmation_token_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"request_sigil":{"$ref":"#/$defs/sigil"}},
  "oneOf":[{"properties":{"decision":{"const":"AUTHORIZE"},"confirmation_token":{"$ref":"#/$defs/token"},"affirmative_confirmation":{"const":true},"confirmation_token_sigil":{"$ref":"#/$defs/sigil"}}},{"properties":{"decision":{"const":"REJECT"},"confirmation_token":{"type":"null"},"affirmative_confirmation":{"type":"null"},"confirmation_token_sigil":{"type":"null"}}}],
  "$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"token":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$","minLength":43,"maxLength":43},"text256":{"type":"string","minLength":0,"maxLength":256,"pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]*$","not":{"pattern":"[\\r\\n]"}},"text4096":{"type":"string","minLength":0,"maxLength":4096,"pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]*$","not":{"pattern":"[\\r\\n]"}},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"par":{"type":"string","pattern":"^PAR-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"prv":{"type":"string","pattern":"^PRV-[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":"[\\r\\n]"},"minLength":5,"maxLength":128},"ref":{"type":"object","additionalProperties":false,"required":["id","sigil"],"properties":{"id":{"type":"string"},"sigil":{"$ref":"#/$defs/sigil"}}},"prvRef":{"allOf":[{"$ref":"#/$defs/ref"},{"properties":{"id":{"$ref":"#/$defs/prv"}}}]}}
