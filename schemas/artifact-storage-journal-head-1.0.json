{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://benchwork.dev/schemas/artifact-storage-journal-head/1.0","title":"Artifact Storage Journal Head v1","description":"Closed RFC-0013 replaceable Journal Head wire contract; it has no self-Sigil field.","type":"object","additionalProperties":false,"required":["schema_version","journal_id","storage_format_version","event_count","last_sequence","last_event_sigil","committed_byte_length","current_epoch","state_sigil","updated_at"],"properties":{"schema_version":{"const":"artifact-storage-journal-head/1.0"},"journal_id":{"$ref":"#/$defs/journalId"},"storage_format_version":{"$ref":"#/$defs/opaque"},"event_count":{"$ref":"#/$defs/u63"},"last_sequence":{"$ref":"#/$defs/u63"},"last_event_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"committed_byte_length":{"$ref":"#/$defs/u63"},"current_epoch":{"$ref":"#/$defs/u63"},"state_sigil":{"anyOf":[{"$ref":"#/$defs/sigil"},{"type":"null"}]},"updated_at":{"$ref":"#/$defs/timestamp"}},"$defs":{"sigil":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","minLength":71,"maxLength":71},"u63":{"type":"integer","minimum":0,"maximum":9223372036854775807},"opaque":{"type":"string","pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","minLength":1,"maxLength":256},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$","minLength":20,"maxLength":27},"journalId":{"type":"string","pattern":"^SJ-[A-Za-z0-9][A-Za-z0-9._:-]*$","not":{"pattern":"[\\r\\n]"},"minLength":4,"maxLength":128}}}

