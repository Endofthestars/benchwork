{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-consumption/1.0",
  "title": "Artifact Storage Execution Namespace Consumption v1",
  "description": "Closed RFC-0013 consumed activation leaf binding the actual durable Storage EventRef. It grants no Event append, index installation, locking, recovery, or transfer authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumption_intent_id", "intent_sigil", "prepared_event", "consumed_at", "consumption_record_sigil"],
  "properties": {
    "schema_version": {"const": "artifact-storage-execution-namespace-consumption/1.0"},
    "consumption_intent_id": {"$ref": "https://benchwork.dev/schemas/artifact-storage-execution-namespace-activation/1.0#/$defs/consumptionIntentId"},
    "intent_sigil": {"$ref": "#/$defs/sigil"},
    "prepared_event": {"$ref": "https://benchwork.dev/schemas/artifact-storage-journal-event/1.0#/$defs/eventRef"},
    "consumed_at": {"$ref": "#/$defs/timestamp"},
    "consumption_record_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27}
  }
}

