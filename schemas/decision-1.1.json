{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/decision/1.1",
  "title": "Scientific Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "program_id", "outcome", "assessment_ids", "rationale", "status", "sealed_at", "seal_receipt"],
  "properties": {
    "schema_version": {"const": "decision/1.1"},
    "decision_id": {"type": "string", "pattern": "^DE-"},
    "program_id": {"$ref": "https://benchwork.dev/schemas/common-definitions/1.0#/$defs/program_id"},
    "outcome": {"enum": ["CONTINUE", "REPAIR", "PIVOT", "STOP", "INSUFFICIENT_EVIDENCE", "REVIEW_REQUIRED"]},
    "assessment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AS-"}},
    "rationale": {"type": "string", "minLength": 1},
    "status": {"const": "SEALED"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "seal_receipt": {"type": "string", "pattern": "^RC-"}
  }
}
