{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/execution-cancel-request/1.0",
  "title": "Execution Cancel Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cancellation_request_id",
    "idempotency_key",
    "job_id",
    "job_binding_sigil",
    "expected_job_revision",
    "reason",
    "actor",
    "host_invocation",
    "caller_observed_at"
  ],
  "properties": {
    "schema_version": {"const": "execution-cancel-request/1.0"},
    "cancellation_request_id": {"$ref": "#/$defs/opaque"},
    "idempotency_key": {"$ref": "#/$defs/opaque"},
    "job_id": {"$ref": "#/$defs/job_id"},
    "job_binding_sigil": {"$ref": "#/$defs/sigil"},
    "expected_job_revision": {"$ref": "#/$defs/u64"},
    "reason": {"$ref": "#/$defs/opaque"},
    "actor": {"$ref": "#/$defs/actor_binding"},
    "host_invocation": {"$ref": "#/$defs/host_invocation_binding"},
    "caller_observed_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "job_id": {
      "type": "string",
      "pattern": "^JB-[A-F0-9]{64}$",
      "minLength": 67,
      "maxLength": 67
    },
    "sigil": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "opaque": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$",
      "minLength": 20,
      "maxLength": 27
    },
    "actor_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id", "authentication_context_sigil", "actor_sigil"],
      "properties": {
        "kind": {"enum": ["USER", "AGENT", "SYSTEM"]},
        "actor_id": {"$ref": "#/$defs/opaque"},
        "authentication_context_sigil": {"$ref": "#/$defs/sigil"},
        "actor_sigil": {"$ref": "#/$defs/sigil"}
      }
    },
    "host_invocation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_identity_sigil",
        "invocation_id",
        "authentication_context_sigil",
        "invocation_sigil"
      ],
      "properties": {
        "host_identity_sigil": {"$ref": "#/$defs/sigil"},
        "invocation_id": {"$ref": "#/$defs/opaque"},
        "authentication_context_sigil": {"$ref": "#/$defs/sigil"},
        "invocation_sigil": {"$ref": "#/$defs/sigil"}
      }
    }
  }
}
