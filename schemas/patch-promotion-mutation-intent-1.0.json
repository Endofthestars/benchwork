{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchwork.dev/schemas/patch-promotion-mutation-intent/1.0",
  "title": "Patch Promotion Mutation Intent v1",
  "description": "Closed RFC-0014 patch-promotion-mutation-intent/1.0 contract-only record. Validation is local and does not resolve its write-ahead dependencies, operation set, or Journal commit.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "intent_id", "attempt_id", "authorization", "operation_sigil", "guard", "fencing_generation", "fence_floor", "target_content_generation", "checkpoint", "base", "postimage", "operations_sigil", "topology_plan", "root_identity", "ancestor_identities", "adapter", "verification_method", "committed_at", "intent_sigil"],
  "properties": {
    "schema_version": {"const": "patch-promotion-mutation-intent/1.0"}, "intent_id": {"$ref": "#/$defs/pmi"}, "attempt_id": {"$ref": "#/$defs/pat"}, "authorization": {"$ref": "#/$defs/pauRef"}, "operation_sigil": {"$ref": "#/$defs/sigil"}, "guard": {"$ref": "#/$defs/pgRef"}, "fencing_generation": {"$ref": "#/$defs/u64"}, "fence_floor": {"$ref": "#/$defs/u64"}, "target_content_generation": {"$ref": "#/$defs/text256"}, "checkpoint": {"$ref": "#/$defs/pckRef"}, "base": {"$ref": "#/$defs/pbRef"}, "postimage": {"$ref": "#/$defs/postimage"}, "operations_sigil": {"$ref": "#/$defs/sigil"}, "topology_plan": {"$ref": "#/$defs/topologyPlan"}, "root_identity": {"$ref": "#/$defs/root"}, "ancestor_identities": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/ancestor"}}, "adapter": {"$ref": "#/$defs/ppaRef"}, "verification_method": {"$ref": "#/$defs/verificationMethod"}, "committed_at": {"$ref": "#/$defs/timestamp"}, "intent_sigil": {"$ref": "#/$defs/sigil"}
  },
  "$defs": {
    "sigil": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}, "u63": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text128": {"type": "string", "minLength": 0, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text256": {"type": "string", "minLength": 0, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "text4096": {"type": "string", "minLength": 0, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$", "not": {"pattern": "[\\r\\n]"}}, "path": {"allOf": [{"$ref": "#/$defs/text4096"}, {"type": "string", "minLength": 1}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?Z$", "minLength": 20, "maxLength": 27},
    "pmi": {"type": "string", "pattern": "^PMI-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pat": {"type": "string", "pattern": "^PAT-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pau": {"type": "string", "pattern": "^PAU-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pg": {"type": "string", "pattern": "^PG-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pck": {"type": "string", "pattern": "^PCK-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128}, "pb": {"type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 4, "maxLength": 128}, "pbip": {"type": "string", "pattern": "^PBIP-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 6, "maxLength": 128}, "ppa": {"type": "string", "pattern": "^PPA-[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "[\\r\\n]"}, "minLength": 5, "maxLength": 128},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "sigil"], "properties": {"id": {"type": "string"}, "sigil": {"$ref": "#/$defs/sigil"}}}, "pauRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pau"}}}]}, "pgRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pg"}}}]}, "pckRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pck"}}}]}, "pbRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pb"}}}]}, "pbipRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/pbip"}}}]}, "ppaRef": {"allOf": [{"$ref": "#/$defs/ref"}, {"properties": {"id": {"$ref": "#/$defs/ppa"}}}]},
    "blob": {"type": "object", "additionalProperties": false, "required": ["sigil", "size_bytes", "media_type"], "properties": {"sigil": {"$ref": "#/$defs/sigil"}, "size_bytes": {"$ref": "#/$defs/u63"}, "media_type": {"$ref": "#/$defs/text128"}}}, "tree": {"type": "object", "additionalProperties": false, "required": ["manifest_sigil", "root_entry_sigil", "entry_count", "total_bytes"], "properties": {"manifest_sigil": {"$ref": "#/$defs/sigil"}, "root_entry_sigil": {"$ref": "#/$defs/sigil"}, "entry_count": {"type": "integer", "minimum": 0, "maximum": 100000}, "total_bytes": {"$ref": "#/$defs/u63"}}}, "postimage": {"type": "object", "additionalProperties": false, "required": ["identity_profile", "tree", "manifest_blob"], "properties": {"identity_profile": {"$ref": "#/$defs/pbipRef"}, "tree": {"$ref": "#/$defs/tree"}, "manifest_blob": {"$ref": "#/$defs/blob"}}},
    "root": {"type": "object", "additionalProperties": false, "required": ["root_object_sigil", "root_generation", "topology_sigil"], "properties": {"root_object_sigil": {"$ref": "#/$defs/sigil"}, "root_generation": {"$ref": "#/$defs/text256"}, "topology_sigil": {"$ref": "#/$defs/sigil"}}}, "topologyPlan": {"type": "object", "additionalProperties": false, "required": ["mode", "target_wide_generation", "root_identity", "ancestor_set_sigil", "operation_order", "plan_sigil"], "properties": {"mode": {"enum": ["FULL_TREE_ATOMIC_CAS", "PER_ENTRY_GENERATIONAL_CAS"]}, "target_wide_generation": {"$ref": "#/$defs/text256"}, "root_identity": {"$ref": "#/$defs/root"}, "ancestor_set_sigil": {"$ref": "#/$defs/sigil"}, "operation_order": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "plan_sigil": {"$ref": "#/$defs/sigil"}}}, "ancestor": {"type": "object", "additionalProperties": false, "required": ["path_bytes", "object_identity_sigil", "generation"], "properties": {"path_bytes": {"$ref": "#/$defs/text4096"}, "object_identity_sigil": {"$ref": "#/$defs/sigil"}, "generation": {"$ref": "#/$defs/text256"}}}, "verificationMethod": {"type": "object", "additionalProperties": false, "required": ["kind", "identity_profile", "expected_tree", "verifier_profile_sigil"], "properties": {"kind": {"const": "FULL_TREE_IDENTITY"}, "identity_profile": {"$ref": "#/$defs/pbipRef"}, "expected_tree": {"$ref": "#/$defs/tree"}, "verifier_profile_sigil": {"$ref": "#/$defs/sigil"}}}
  }
}

