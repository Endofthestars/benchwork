{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://benchwork.dev/schemas/patch-promotion-recovery-record/1.0", "title":"Patch Promotion Recovery Record v1", "description":"Closed RFC-0014 patch-promotion-recovery-record/1.0 contract-only record. Validation does not resolve Journal, Receipt, guard, or Storage state.", "type":"object", "additionalProperties":false,
